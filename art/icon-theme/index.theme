[Icon Theme]
Name=freemac
Comment=freemac's own folder and file icons; everything else comes from Adwaita
Inherits=Adwaita,hicolor
Directories=scalable/places,scalable/mimetypes

[scalable/places]
Size=128
MinSize=8
MaxSize=512
Context=Places
Type=Scalable

[scalable/mimetypes]
Size=128
MinSize=8
MaxSize=512
Context=MimeTypes
Type=Scalable
