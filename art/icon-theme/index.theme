[Icon Theme]
Name=freemac
Comment=freemac's own folder and file icons, and each app's icon on a rounded tile; the rest comes from Adwaita
Inherits=Adwaita,hicolor
Directories=scalable/apps,scalable/places,scalable/mimetypes,scalable/actions

[scalable/places]
Size=128
MinSize=8
MaxSize=512
Context=Places
Type=Scalable

[scalable/mimetypes]
Size=128
MinSize=8
MaxSize=512
Context=MimeTypes
Type=Scalable

[scalable/apps]
Size=128
MinSize=8
MaxSize=512
Context=Applications
Type=Scalable

[scalable/actions]
Size=16
MinSize=8
MaxSize=512
Context=Actions
Type=Scalable
