[Desktop Entry]
Type=Application
Name=Frame
Comment=Look at pictures, screenshots and PDFs
Exec=freemac-frame %F
Icon=freemac-frame
Categories=Graphics;Viewer;
Keywords=image;picture;photo;viewer;screenshot;pdf;document;preview;
MimeType=image/png;image/jpeg;image/gif;image/webp;image/svg+xml;image/bmp;image/tiff;image/x-icon;application/pdf;
StartupWMClass=org.freemac.Frame
StartupNotify=true
