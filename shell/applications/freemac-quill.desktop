[Desktop Entry]
Type=Application
Name=Quill
Comment=Write and edit text files and code
Exec=freemac-quill %F
Icon=freemac-quill
Categories=Utility;TextEditor;Development;
Keywords=text;editor;notes;code;txt;
MimeType=text/plain;text/markdown;text/x-python;text/x-csrc;text/x-chdr;text/x-c++src;text/x-shellscript;application/json;application/xml;text/html;text/css;application/x-yaml;text/x-log;
StartupWMClass=org.freemac.Quill
StartupNotify=true
