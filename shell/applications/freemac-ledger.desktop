[Desktop Entry]
Type=Application
Name=Ledger
GenericName=Spreadsheet
Comment=Work with numbers in a table of cells, with sums, formulas and charts
Exec=freemac-ledger %F
Icon=freemac-ledger
Categories=Office;Spreadsheet;
Keywords=spreadsheet;table;numbers;sum;formula;csv;chart;budget;grades;
MimeType=text/csv;text/tab-separated-values;
StartupWMClass=org.freemac.Ledger
StartupNotify=true
