# freemac default apps.
[Default Applications]
inode/directory=freemac-drawer.desktop
text/plain=freemac-quill.desktop
text/markdown=freemac-quill.desktop
image/png=freemac-frame.desktop
image/jpeg=freemac-frame.desktop
image/gif=freemac-frame.desktop
image/webp=freemac-frame.desktop
image/svg+xml=freemac-frame.desktop
text/html=org.gnome.Epiphany.desktop
x-scheme-handler/http=org.gnome.Epiphany.desktop
x-scheme-handler/https=org.gnome.Epiphany.desktop
