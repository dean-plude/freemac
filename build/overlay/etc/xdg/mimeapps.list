text/calendar=freemac-tide.desktop
text/vcard=freemac-crew.desktop
text/x-vcard=freemac-crew.desktop
audio/mpeg=freemac-shanty.desktop
audio/mp4=freemac-shanty.desktop
audio/x-m4a=freemac-shanty.desktop
audio/flac=freemac-shanty.desktop
audio/ogg=freemac-shanty.desktop
audio/x-vorbis+ogg=freemac-shanty.desktop
audio/x-opus+ogg=freemac-shanty.desktop
audio/x-wav=freemac-shanty.desktop
