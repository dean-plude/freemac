#%PAM-1.0
# freemac: the session is a Wayland session (see freemac-session-type.conf).
session    required    pam_env.so readenv=0 user_readenv=0 conffile=/etc/security/freemac-session-type.conf
@include login

-auth        optional        pam_gnome_keyring.so
-auth        optional        pam_kwallet5.so

-session     optional        pam_gnome_keyring.so auto_start
-session     optional        pam_kwallet5.so auto_start
