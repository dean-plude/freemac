// freemac: an administrator sitting at the computer may rename, erase,
// eject and power off drives that aren't the system's own (USB drives,
// memory cards, a second disk) without a password prompt, as on a Mac.
// The "-system" actions, for the disks the computer runs from, still ask.
polkit.addRule(function (action, subject) {
  var free = ["org.freedesktop.udisks2.modify-device",
              "org.freedesktop.udisks2.eject-media",
              "org.freedesktop.udisks2.power-off-drive",
              "org.freedesktop.udisks2.filesystem-mount",
              "org.freedesktop.udisks2.filesystem-mount-other-seat"];
  if (free.indexOf(action.id) >= 0 && subject.local && subject.active && subject.isInGroup("sudo")) {
    return polkit.Result.YES;
  }
});
