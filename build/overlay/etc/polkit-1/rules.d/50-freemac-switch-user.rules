// freemac fast user switching: the person at the computer, and the login
// screen, may open another login screen (freemac-greeter@N) and switch to
// another person's session or login screen (freemac-switch-to@N), with no
// password: each session stays behind its own lock screen.
polkit.addRule(function (action, subject) {
  if (action.id == "org.freedesktop.systemd1.manage-units" &&
      action.lookup("verb") == "start" &&
      /^freemac-(greeter|switch-to)@([789]|1[0-2])\.service$/.test(action.lookup("unit") || "") &&
      (subject.user == "_greetd" || (subject.local && subject.active))) {
    return polkit.Result.YES;
  }
});
