<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- freemac: lets Dials' Power panel restart the computer into freemac
     Recovery after an administrator's password. -->
<policyconfig>
  <vendor>freemac</vendor>
  <action id="org.freemac.recovery.restart">
    <description>Restart in Recovery</description>
    <message>Restarting in Recovery needs an administrator's password.</message>
    <icon_name>freemac-dials</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/freemac-recovery-helper</annotate>
  </action>
</policyconfig>
