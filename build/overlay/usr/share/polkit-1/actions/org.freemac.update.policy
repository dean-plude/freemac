<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- freemac: lets Dials > Software Update download a new version of freemac
     and get it ready to install at the next restart, after an administrator's password. -->
<policyconfig>
  <vendor>freemac</vendor>
  <action id="org.freemac.update">
    <description>Update freemac</description>
    <message>Updating freemac needs an administrator's password.</message>
    <icon_name>freemac-dials</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/freemac-update-helper</annotate>
  </action>
</policyconfig>
