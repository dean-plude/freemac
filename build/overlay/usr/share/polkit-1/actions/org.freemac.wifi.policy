<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- freemac: lets Dials > Network show or copy a saved Wi-Fi network's password after an administrator's password. -->
<policyconfig>
  <vendor>freemac</vendor>
  <action id="org.freemac.wifi.password">
    <description>Show a saved Wi-Fi password</description>
    <message>Showing a saved Wi-Fi network's password needs an administrator's password.</message>
    <icon_name>freemac-dials</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/freemac-wifi-password</annotate>
  </action>
</policyconfig>
