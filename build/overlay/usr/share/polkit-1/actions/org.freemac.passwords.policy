<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- freemac: Purser opens locked; the person's own login password unlocks it for a few minutes. Nothing runs as root. -->
<policyconfig>
  <vendor>freemac</vendor>
  <action id="org.freemac.passwords.unlock">
    <description>See your saved passwords</description>
    <message>Purser needs your login password to show your saved passwords.</message>
    <icon_name>freemac-purser</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_self_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
