#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Start the freemac desktop session (Wayfire configured as Strata).
# freemac 1.70 to 1.72 called Restart, Shut Down and Log Out's question
# "freemac-session" too (now freemac-power); a Shift-Command-Q set up then
# still lands here, so pass it on rather than starting a second desktop.
case "$1" in
  restart|shutdown|logout|sleep) exec /usr/bin/freemac-power "$@" ;;
esac
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=freemac:wayfire
export XDG_SESSION_DESKTOP=freemac
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM="wayland;xcb"
# Qt 5 and Qt 6 apps take freemac's colours, font and icons from qt5ct and
# qt6ct (qt6ct answers to this name too); see ~/.config/qt5ct and qt6ct.
export QT_QPA_PLATFORMTHEME=qt5ct
# GTK 3 apps tell Topline when the pointer rests on their green button, so
# it can show Move & Resize (strata/gtk/freemac-zoom.c).
for dir in /usr/lib/*/gtk-3.0/modules /usr/lib/gtk-3.0/modules; do
  if [ -f "$dir/libfreemac-zoom.so" ]; then
    export GTK_MODULES="${GTK_MODULES:+$GTK_MODULES:}freemac-zoom"
    break
  fi
done
# libseat finds seatd first (seatd.service); logind is the fallback.
# Allow the software renderer (virtual machines, GPUs without drivers).
export WLR_RENDERER_ALLOW_SOFTWARE=1
if systemd-detect-virt -q 2>/dev/null; then
  export WLR_NO_HARDWARE_CURSORS=1
fi
# The Guest User (Dials > Users) starts each time from a fresh home folder
# and leaves nothing behind. Only the account called guest, with the mark
# the users helper writes and its home at /home/guest, is ever emptied.
is_guest() {
  [ "$(id -un)" = guest ] && [ -e /etc/freemac/guest-user ] && [ "$HOME" = /home/guest ]
}
empty_guest_home() {
  find /home/guest -mindepth 1 -maxdepth 1 -exec rm -rf -- {} + 2>/dev/null
  cp -a /etc/skel/. /home/guest/ 2>/dev/null
  mkdir -p /home/guest/.config/freemac
  : >/home/guest/.config/freemac/welcome-seen
}
if is_guest; then
  cd / && empty_guest_home && cd /home/guest
fi
mkdir -p "$HOME/.cache"
# Make Desktop, Documents, Downloads and the rest, and record them so apps
# (and their icons) know which folder is which.
command -v xdg-user-dirs-update >/dev/null && xdg-user-dirs-update
if is_guest; then
  wayfire >/dev/null 2>&1
  status=$?
  cd / && empty_guest_home
  exit $status
fi
exec wayfire >"$HOME/.cache/wayfire.log" 2>&1
