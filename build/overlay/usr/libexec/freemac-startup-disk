#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""Dials > Startup Disk's root helper.

  freemac-startup-disk always NUM   start up from boot entry NUM from now on
                                    (it goes first in the firmware's BootOrder)
  freemac-startup-disk once NUM     start up from NUM next time only (BootNext),
                                    then restart
  freemac-startup-disk cancel-once  forget a start-up set for next time only

NUM is one of the entries Dials shows (four hex digits). Original freemac code.
"""
import os
import re
import subprocess
import sys

from freemac_shell import startup_disk


def fail(message):
    print(message, file=sys.stderr)
    sys.exit(1)


def efibootmgr(*args):
    done = subprocess.run(["efibootmgr", *args], capture_output=True, text=True)
    if done.returncode:
        fail((done.stderr or done.stdout).strip() or "The firmware didn't take the change.")


def entry(num):
    if not re.fullmatch(r"[0-9A-Fa-f]{4}", num or ""):
        fail("That isn't a start-up disk.")
    shown = startup_disk.read() or []
    if not any(e["num"] == num.upper() for e in shown):
        fail("That start-up disk isn't there any more.")
    return num.upper()


def main(argv):
    if os.geteuid() != 0:
        fail("This needs to run as root.")
    if not startup_disk.has_uefi():
        fail("This computer doesn't start up with UEFI, so its start-up disk is chosen in its own firmware.")
    command = argv[1] if len(argv) > 1 else ""
    if command == "always" and len(argv) == 3:
        num = entry(argv[2])
        now = startup_disk.parse(startup_disk._efibootmgr())
        efibootmgr("-o", ",".join([num] + [n for n in now["order"] if n != num]))
        # A start-up set for next time only would otherwise win once more.
        if now["next"]:
            efibootmgr("-N")
    elif command == "once" and len(argv) == 3:
        efibootmgr("-n", entry(argv[2]))
        subprocess.run(["systemctl", "reboot"])
    elif command == "cancel-once":
        if startup_disk.parse(startup_disk._efibootmgr())["next"]:
            efibootmgr("-N")
    else:
        fail(__doc__)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
