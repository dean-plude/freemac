#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Dials > Network > Known Networks: print a saved Wi-Fi network's password,
# run as root through pkexec after an administrator's password, as a Mac asks
# before it shows one.
#   freemac-wifi-password UUID
# Only a saved Wi-Fi connection, named by its UUID, is read. Exits 3 when the
# network has no password.
set -e
uuid=$(printf '%s' "$1" | tr 'A-F' 'a-f')
case "$uuid" in
  ????????-????-????-????-????????????) ;;
  *) echo "That isn't a network." >&2; exit 2 ;;
esac
[ -z "$(printf '%s' "$uuid" | tr -d '0-9a-f-')" ] || { echo "That isn't a network." >&2; exit 2; }
kind=$(nmcli -g connection.type connection show uuid "$uuid" 2>/dev/null) || { echo "That network isn't saved." >&2; exit 2; }
[ "$kind" = 802-11-wireless ] || { echo "That isn't a Wi-Fi network." >&2; exit 2; }
key=$(nmcli -s -g 802-11-wireless-security.psk connection show uuid "$uuid" 2>/dev/null || true)
if [ -z "$key" ]; then
  key=$(nmcli -s -g 802-11-wireless-security.wep-key0 connection show uuid "$uuid" 2>/dev/null || true)
fi
[ -n "$key" ] || exit 3
printf '%s\n' "$key"
