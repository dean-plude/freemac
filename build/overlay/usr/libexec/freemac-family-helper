#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Logbook's Limit adult websites, run as root through pkexec. "on" points the
# computer's name lookups (DNS) at Cloudflare for Families, which leaves out
# adult and malware sites; "off" goes back to the network's own.
set -e
CONF=/etc/NetworkManager/conf.d/90-freemac-family.conf
case "$1" in
  on)
    cat > "$CONF" <<'EOF'
# freemac: Logbook > Limit adult websites. Every connection looks names up
# with Cloudflare for Families, which leaves out adult and malware sites.
# Turn it off in Logbook (this file is removed).
[global-dns-domain-*]
servers=1.1.1.3,1.0.0.3,2606:4700:4700::1113,2606:4700:4700::1003
EOF
    ;;
  off)
    rm -f "$CONF"
    ;;
  *)
    echo "usage: freemac-family-helper on|off" >&2
    exit 2
    ;;
esac
nmcli general reload conf dns-full 2>/dev/null || systemctl reload NetworkManager
