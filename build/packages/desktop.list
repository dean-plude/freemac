# Graphical session: Wayfire configured as Strata,
# greetd autologin, fonts, Mesa, GTK and layer-shell for our own shell and apps.
wayfire
# Start-up screen (freemac theme in /usr/share/plymouth/themes/freemac)
plymouth
plymouth-label
greetd
seatd
foot
dbus-user-session
libpam-systemd
libgl1-mesa-dri
libegl-mesa0
libgles2
libgbm1
fonts-inter
fonts-dejavu-core
# Colour emoji, for the emoji panel (Glyph) and every app
fonts-noto-color-emoji
adwaita-icon-theme
hicolor-icon-theme
librsvg2-common
gsettings-desktop-schemas
libglib2.0-bin
python3-gi
gir1.2-gtk-3.0
gir1.2-gtklayershell-0.1
# Settings storage shared by all apps (light/dark mode and so on).
dconf-gsettings-backend
dconf-service
# Networking (wired and Wi-Fi) and the permission service it uses.
network-manager
polkitd
# Runs freemac's small root helpers (Users, Restart in Recovery, Limit adult
# websites, Firewall, Automatic updates) after an administrator's password;
# Ubuntu ships it on its own.
pkexec
# Network > Firewall (turns away connections other computers start) and
# Software Update > Install important updates automatically.
ufw
unattended-upgrades
# Everyday apps we ship but don't write: text editor, image viewer, web browser.
gir1.2-gtksource-4
# Check spelling while typing (spelling.py): gspell, with Hunspell's English
# dictionaries (U.S., British, Canadian, Australian) for Enchant.
gir1.2-gspell-1
hunspell-en-us
hunspell-en-gb
hunspell-en-ca
hunspell-en-au
grim
slurp
wl-clipboard
# Glyph types the emoji you pick into the app in front
wtype
wf-recorder
libnotify-bin
xdg-utils
# xdg-open asks file what kind a file is; without it every file opens in the browser.
file
xdg-user-dirs
epiphany-browser
gir1.2-nm-1.0
# The code a phone scans to join a known Wi-Fi network (Dials > Network).
python3-qrcode
gtk-update-icon-cache
python3-gi-cairo
# PDF pages for Frame, Seek's preview and Glance.
gir1.2-poppler-0.18
gir1.2-webkit2-4.1
# The dictionary Words reads (WordNet 3.0, Princeton University's permissive licence).
wordnet-base
# Adwaita-dark for GTK 3 apps (dark mode)
gnome-themes-extra
# Sound: PipeWire with WirePlumber; Topline's volume control uses wpctl
pipewire
pipewire-pulse
wireplumber
# Music for Shanty: GStreamer plays and reads the tags of MP3, AAC/M4A, FLAC,
# Ogg, Opus and WAV, and sends the sound to PipeWire.
gir1.2-gstreamer-1.0
gir1.2-gst-plugins-base-1.0
gstreamer1.0-plugins-base
gstreamer1.0-plugins-good
gstreamer1.0-gtk3
gstreamer1.0-libav
gstreamer1.0-pipewire
gstreamer1.0-plugins-bad
# Alarm and timer sounds for Chime (freedesktop sound theme), and time zones
sound-theme-freedesktop
tzdata
at-spi2-core
# Speak selection (Option-Escape) reads out loud with eSpeak NG's voices.
espeak-ng
# The screen reader (Command-F5, Dials > Accessibility) is Orca, speaking
# through speech-dispatcher with eSpeak NG's voices.
orca
speech-dispatcher-espeak-ng
# Orca's keyboard handling needs an X11 display: a private, rootless Xwayland.
xwayland
# Nearby sharing (Hail) makes its own certificate once with OpenSSL.
openssl
# Dials > Sharing: the computer answers to its-name.local (Avahi), and Remote
# Login (SSH) is there for anyone who turns it on; it starts off.
avahi-daemon
libnss-mdns
openssh-server
# File Sharing (Dials > Sharing) shares the Public folder with Samba; wsdd-server
# lets Windows find this computer. Both start off.
samba
wsdd-server
# Screen Sharing (Dials > Sharing) runs wayvnc in the person's session, and
# Porthole sees and uses another computer's screen through GTK-VNC.
wayvnc
gir1.2-gtk-vnc-2.0
openssl
power-profiles-daemon
# Night light (warmer colours in the evening) through Wayland's gamma control
wlsunset
# Lock screen (Latch): session locking with PAM, and idle detection
gtklock
swayidle
# App centre (Harbor): PackageKit installs, AppStream catalogue with icons,
# and a password prompt (polkit agent) for installs and updates
packagekit
gir1.2-packagekitglib-1.0
gir1.2-appstream-1.0
appstream
apt-config-icons
mate-polkit
# Phones, cameras, memory cards and USB drives: udisks2 mounts drives and
# cards, GVfs reaches phones (MTP, and iPhones through usbmuxd) and cameras
# (PTP), for Cove's import and for Drawer.
udisks2
# Erase in Hull can make ExFAT and MS-DOS (FAT) drives too.
exfatprogs
dosfstools
gvfs
gvfs-backends
gvfs-fuse
usbmuxd
# Bluetooth (Dials' Bluetooth panel talks to BlueZ) and printing: CUPS finds
# network printers by itself; system-config-printer adds the rest.
bluez
cups
cups-browsed
system-config-printer
# Scanning: Glass runs SANE's scanimage. sane-airscan finds network scanners
# and most all-in-one printers by itself (eSCL and WSD), with no driver.
sane-utils
sane-airscan
# USB all-in-ones that speak IPP over USB show up to sane-airscan too.
ipp-usb
# Qt 5 and Qt 6 apps get freemac's colours and font (QT_QPA_PLATFORMTHEME=qt5ct),
# and Qt 5 apps freemac's own buttons, fields and tabs (a Kvantum theme drawn
# by art/kvantum/make-kvantum.py). Qt apps need Qt's Wayland support, since
# freemac has no X server.
qt5ct
qt6ct
qt5-style-kvantum
qtwayland5
qt6-wayland
# The keychain: gnome-keyring is the secret service Web, Post and Purser keep
# passwords in, opened by the login password (pam_gnome_keyring in greetd's
# PAM file); gcr asks for a keychain password when one is needed, and
# gir1.2-secret-1 lets Purser read and change saved logins.
gnome-keyring
libpam-gnome-keyring
gcr
gir1.2-secret-1
# Purser reads a verification code's setup QR code off the screen (grim takes
# the picture) with the ZBar library through python3-pyzbar, which needs PIL
# (python3-pil, only suggested by the package) to read the picture.
python3-pyzbar
python3-pil
