# Graphical session: Wayfire configured as Strata,
# greetd autologin, fonts, Mesa, GTK and layer-shell for our own shell and apps.
wayfire
# Start-up screen (freemac theme in /usr/share/plymouth/themes/freemac)
plymouth
plymouth-label
greetd
seatd
foot
dbus-user-session
libpam-systemd
libgl1-mesa-dri
libegl-mesa0
libgles2
libgbm1
fonts-inter
fonts-dejavu-core
# Colour emoji, for the emoji panel (Glyph) and every app
fonts-noto-color-emoji
adwaita-icon-theme
hicolor-icon-theme
librsvg2-common
gsettings-desktop-schemas
libglib2.0-bin
python3-gi
gir1.2-gtk-3.0
gir1.2-gtklayershell-0.1
# Settings storage shared by all apps (light/dark mode and so on).
dconf-gsettings-backend
dconf-service
# Networking (wired and Wi-Fi) and the permission service it uses.
network-manager
polkitd
# Everyday apps we ship but don't write: text editor, image viewer, web browser.
gir1.2-gtksource-4
grim
slurp
wl-clipboard
# Glyph types the emoji you pick into the app in front
wtype
wf-recorder
libnotify-bin
xdg-utils
# xdg-open asks file what kind a file is; without it every file opens in the browser.
file
xdg-user-dirs
epiphany-browser
gir1.2-nm-1.0
gtk-update-icon-cache
python3-gi-cairo
# PDF pages for Frame, Seek's preview and Glance.
gir1.2-poppler-0.18
gir1.2-webkit2-4.1
# Adwaita-dark for GTK 3 apps (dark mode)
gnome-themes-extra
# Sound: PipeWire with WirePlumber; Topline's volume control uses wpctl
pipewire
pipewire-pulse
wireplumber
# Music for Shanty: GStreamer plays and reads the tags of MP3, AAC/M4A, FLAC,
# Ogg, Opus and WAV, and sends the sound to PipeWire.
gir1.2-gstreamer-1.0
gir1.2-gst-plugins-base-1.0
gstreamer1.0-plugins-base
gstreamer1.0-plugins-good
gstreamer1.0-gtk3
gstreamer1.0-libav
gstreamer1.0-pipewire
# Alarm and timer sounds for Chime (freedesktop sound theme), and time zones
sound-theme-freedesktop
tzdata
at-spi2-core
power-profiles-daemon
# Night light (warmer colours in the evening) through Wayland's gamma control
wlsunset
# Lock screen (Latch): session locking with PAM, and idle detection
gtklock
swayidle
# App centre (Harbor): PackageKit installs, AppStream catalogue with icons,
# and a password prompt (polkit agent) for installs and updates
packagekit
gir1.2-packagekitglib-1.0
gir1.2-appstream-1.0
appstream
apt-config-icons
mate-polkit
# Phones, cameras, memory cards and USB drives: udisks2 mounts drives and
# cards, GVfs reaches phones (MTP, and iPhones through usbmuxd) and cameras
# (PTP), for Cove's import and for Drawer.
udisks2
gvfs
gvfs-backends
usbmuxd
# Bluetooth (Dials' Bluetooth panel talks to BlueZ) and printing: CUPS finds
# network printers by itself; system-config-printer adds the rest.
bluez
cups
cups-browsed
system-config-printer
# Qt 5 and Qt 6 apps get freemac's colours and font (QT_QPA_PLATFORMTHEME=qt5ct),
# and Qt 5 apps freemac's own buttons, fields and tabs (a Kvantum theme drawn
# by art/kvantum/make-kvantum.py). Qt apps need Qt's Wayland support, since
# freemac has no X server.
qt5ct
qt6ct
qt5-style-kvantum
qtwayland5
qt6-wayland
