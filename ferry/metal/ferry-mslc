ONE = {
    "vertex_id": "c->vertex_id", "instance_id": "c->instance_id", "base_vertex": "c->base_vertex",
    "base_instance": "c->base_instance", "primitive_id": "c->primitive_id", "sample_id": "c->sample_id",
    "sample_mask": "c->sample_mask_in", "front_facing": "c->front_facing",
    "render_target_array_index": "c->render_target_array_index",
    "viewport_array_index": "c->viewport_array_index", "amplification_id": "c->amplification_id",
    "thread_index_in_threadgroup": "c->grid[6][0]", "thread_index_in_simdgroup": "0u",
    "thread_index_in_quadgroup": "0u", "simdgroup_index_in_threadgroup": "c->grid[6][0]",
    "quadgroup_index_in_threadgroup": "c->grid[6][0]", "threads_per_simdgroup": "1u",
    "thread_execution_width": "1u", "simdgroups_per_threadgroup": "c->grid[6][1]",
    "dispatch_simdgroups_per_threadgroup": "c->grid[6][1]", "quadgroups_per_threadgroup": "c->grid[6][1]",
}
INTERP = {"flat": "FERRY_I_FLAT", "center_no_perspective": "FERRY_I_NO_PERSPECTIVE",
          "centroid_no_perspective": "FERRY_I_NO_PERSPECTIVE", "sample_no_perspective": "FERRY_I_NO_PERSPECTIVE"}


def info_type(expr):
    """The type of a value named in an info function, without naming a
    variable (__r is the function's result type __R; __inN the type of
    stage_in parameter N)."""
    m = re.match(r"^(__r|__in(\d+))(.*)$", expr)
    if not m:
        return "decltype(%s)" % expr
    base = "__R" if m.group(1) == "__r" else "__I%s" % m.group(2)
    if not m.group(3):
        return base
    return "decltype(__ferry::declval<%s>()%s)" % (base, m.group(3))


def cstr(s):
    return '"%s"' % s.replace("\\", "\\\\").replace('"', '\\"')


def strip_type(t):
    """A type as written, without address space and reference (for locals)."""
    t = re.sub(r"\b(__global|__local|__constant|__private|__generic)\b", "", t)
    return t.replace("&", "").strip()


class Gen:
    def __init__(self, src, fcvals=None):
        self.src = src
        self.out = []
        self.reflect = []
        self.fcvals = fcvals or {}   # function constants' values, by name

    def index(self, expr):
        """A binding index: a number, or an expression of numbers and function
        constants (Blender writes [[buffer(MTL_uniform_buffer_base_index+1)]]).
        None when a function constant in it has no value yet."""
        try:
            return int(expr, 0)
        except ValueError:
            pass
        def value(m):
            v = self.fcvals.get(m.group(0))
            if v is None:
                raise KeyError(m.group(0))
            return "(%s)" % v
        try:
            e = re.sub(r"\b[A-Za-z_]\w*\b", value, expr)
        except KeyError:
            return None
        e = re.sub(r"(?<![/])/(?![/])", "//", e)
        if not re.match(r"^[\s\d()+\-*/%<>&|^~xXa-fA-F]*$", e):
            return None
        try:
            return int(eval(e, {"__builtins__": {}}, {}))
        except Exception:
            return None

    def emit(self, s):
        self.out.append(s)

    def struct_of(self, typename):
        t = strip_type(typename)
        t = re.sub(r"\b(const|volatile|struct|class)\b", "", t).strip()
        t = t.split("::")[-1].strip()
        return t, self.src.structs.get(t)

    def gen_all(self):
        for e in self.src.entries:
            self.later = []
            getattr(self, "gen_" + e["stage"])(e)
            self.out.extend(self.later)

    def arg_layout(self, e, i, p):
        """An argument buffer: a buffer argument whose struct has [[id(n)]]
        members gets a function listing where each member is, with the
        offsets and sizes the compiler gives, for the argument encoder that
        newArgumentEncoderWithBufferIndex: makes. Returns its name."""
        _, fields = self.struct_of(text_of(p.type_toks))
        if not fields or not any(f.attr("id") is not None for f in fields):
            return None
        sym = "__ferry_args_%s_%d" % (e["name"], i)
        self.later.append('extern "C" int %s(struct ferry_arg *a, int max, int *size)\n{' % sym)
        self.later.append("    typedef __ferry::plain<%s> __S;" % text_of(p.type_toks))
        self.later.append("    int k = 0;")
        for f in fields:
            fid = f.attr("id")
            if fid is None:
                continue
            ty = text_of(f.type_toks)
            m = re.match(r"^\s*(?:metal\s*::\s*)?array\s*<(.*),[^,]*>\s*$", ty)
            elem = m.group(1) if m else ty
            is_array = bool(m) or bool(f.dims)
            if re.search(r"\bsampler\b", elem):
                kind = "FERRY_A_SAMPLER"
            elif re.search(r"\b(texture|depth)\w*\b", elem):
                kind = "FERRY_A_TEXTURE"
            elif "*" in elem:
                kind = "FERRY_A_BUFFER"
            else:
                kind = "FERRY_A_DATA"
            whole = "sizeof(__ferry::declval<__S>().%s)" % f.name
            one = "sizeof(__ferry::declval<__S>().%s[0])" % f.name if is_array else whole
            self.later.append("    if (k < max) a[k] = (ferry_arg){(int)(%s), (int)__builtin_offsetof(__S, %s), "
                              "(int)(%s / %s), (int)(%s), %s};" % (fid, f.name, whole, one, one, kind))
            self.later.append("    k++;")
        self.later.append("    *size = (int)sizeof(__S);")
        self.later.append("    return k;\n}")
        return sym

    def bind_params(self, e, inputs_var=None):
        """Locals for each parameter; returns (call args, reflection)."""
        args, refl = [], {"buffers": [], "textures": [], "samplers": [], "threadgroup": [], "stage_in": []}
        for i, p in enumerate(e["params"]):
            ty = text_of(p.type_toks) + "".join("[%s]" % d for d in p.dims)
            loc = "__a%d" % i
            self.emit("    typedef %s __T%d;" % (text_of(p.type_toks), i))
            names = [a for a, _ in p.attrs]
            if p.attr("buffer") is not None:
                idx = p.attr("buffer")
                self.emit("    __T%d %s = __ferry_entry::buffer<__T%d>::get(c->buffers[%s]);" % (i, loc, i, idx))
                b = {"index": self.index(idx), "name": p.name}
                args_sym = self.arg_layout(e, i, p)
                if args_sym:
                    b["arguments"] = args_sym
                refl["buffers"].append(b)
            elif p.attr("texture") is not None:
                idx = p.attr("texture")
                self.emit("    __T%d %s = __ferry_entry::texture<__ferry::plain<__T%d>>::get(c, %s);" % (i, loc, i, idx))
                refl["textures"].append({"index": self.index(idx), "name": p.name})
            elif p.attr("sampler") is not None:
                idx = p.attr("sampler")
                self.emit("    __T%d %s = __ferry_entry::samplers<__ferry::plain<__T%d>>::get(c, %s);" % (i, loc, i, idx))
                refl["samplers"].append({"index": self.index(idx), "name": p.name})
            elif p.attr("threadgroup") is not None:
                idx = p.attr("threadgroup")
                self.emit("    __T%d %s = (__T%d)c->tgmem[%s];" % (i, loc, i, idx))
                refl["threadgroup"].append({"index": self.index(idx), "name": p.name})
            elif p.attr("stage_in") is not None:
                sname, fields = self.struct_of(text_of(p.type_toks))
                if fields is None:
                    raise SystemExit("ferry-mslc: %s: the [[stage_in]] struct %s isn't one ferry-mslc can read"
                                     % (e["name"], sname))
                self.emit("    __ferry::plain<__T%d> %s;" % (i, loc))
                refl["stage_in"] = self.stage_in(e, loc, fields, inputs_var)
            elif p.attr("position") is not None and e["stage"] == "fragment":
                self.emit("    __T%d %s = __ferry_entry::frag_position(c);" % (i, loc))
            elif p.attr("point_coord") is not None:
                self.emit("    __T%d %s = float2(c->point_coord[0], c->point_coord[1]);" % (i, loc))
            elif any(n in GRID for n in names):
                n = [n for n in names if n in GRID][0]
                self.emit("    __T%d %s = __ferry_entry::builtin<__T%d>(c->grid[%d]);" % (i, loc, i, GRID[n]))
            elif any(n in ONE for n in names):
                n = [n for n in names if n in ONE][0]
                expr = ONE[n]
                if n == "front_facing":
                    self.emit("    __T%d %s = %s != 0;" % (i, loc, expr))
                else:
                    self.emit("    __T%d %s = __T%d(%s);" % (i, loc, i, expr))
            elif p.attr("payload") is not None or p.attr("patch_id") is not None:
                self.emit("    __ferry::plain<__T%d> %s{};" % (i, loc))
            else:
                # no attribute: in a fragment function, a varying taken by itself
                self.emit("    __ferry::plain<__T%d> %s{};" % (i, loc))
            args.append(loc)
        return args, refl

    def stage_in(self, e, loc, fields, inputs_var):
        refl = []
        k = 0
        for f in fields:
            fn = "%s.%s" % (loc, f.name)
            if e["stage"] == "vertex":
                a = f.attr("attribute")
                if a is None:
                    continue
                self.emit("    __ferry_entry::fetch(%s, c, %s);" % (fn, a))
                refl.append({"name": f.name, "attribute": int(a, 0), "field": k})
            else:
                if f.attr("position") is not None:
                    self.emit("    %s = __ferry_entry::frag_position(c);" % fn)
                    continue
                if f.attr("front_facing") is not None:
                    self.emit("    %s = c->front_facing != 0;" % fn)
                    continue
                builtin = [n for n, _ in f.attrs if n in ONE]
                if builtin:
                    self.emit("    %s = decltype(%s)(%s);" % (fn, fn, ONE[builtin[0]]))
                    continue
                if f.attr("point_coord") is not None:
                    self.emit("    %s = float2(c->point_coord[0], c->point_coord[1]);" % fn)
                    continue
                tag = f.attr("user") or f.name
                interp = "FERRY_I_PERSPECTIVE"
                for n, _ in f.attrs:
                    if n in INTERP:
                        interp = INTERP[n]
                self.emit("    __ferry_entry::get(%s, %s + c->stage_in_map[%d]);" % (fn, inputs_var, k))
                refl.append({"name": f.name, "tag": tag, "field": k, "interp": interp, "expr": fn})
                k += 1
        return refl

    # ---- vertex ----
    def gen_vertex(self, e):
        name = e["name"]
        sym = "__ferry_vs_" + name
        self.emit('extern "C" void %s(const ferry_call *c, float *out)\n{' % sym)
        args, refl = self.bind_params(e)
        ret = e["ret"].strip()
        slots = []
        if ret != "void":
            self.emit("    auto __r = %s(%s);" % (name, ", ".join(args)))
            self.emit("    typedef decltype(__r) __R;")
            sname, fields = self.struct_of(ret)
            if fields is None:
                # float4 returned alone: the position
                self.emit("    __ferry_entry::put(out + FERRY_VS_POSITION, __r);")
                slots.append(("position", None, "__r", "FERRY_W_POSITION", 0))
            else:
                off = "FERRY_VS_VARYINGS"
                for f in fields:
                    fn = "__r.%s" % f.name
                    if f.attr("position") is not None:
                        self.emit("    __ferry_entry::put(out + FERRY_VS_POSITION, %s);" % fn)
                        slots.append(("position", None, fn, "FERRY_W_POSITION", 0))
                    elif f.attr("point_size") is not None:
                        self.emit("    __ferry_entry::put(out + FERRY_VS_POINT_SIZE, %s);" % fn)
                        slots.append(("point_size", None, fn, "FERRY_W_POINT_SIZE", 0))
                    elif f.attr("clip_distance") is not None:
                        self.emit("    __ferry_entry::put(out + FERRY_VS_CLIP, %s);" % fn)
                        slots.append(("clip_distance", None, fn, "FERRY_W_CLIP_DISTANCE", 0))
                    elif f.attr("invariant") is not None and len(f.attrs) == 1:
                        pass
                    elif f.attr("render_target_array_index") is not None:
                        self.emit("    __ferry_entry::put(out + FERRY_VS_LAYER, uint(%s));" % fn)
                        slots.append(("render_target_array_index", None, fn, "FERRY_W_LAYER", 0))
                    elif f.attr("viewport_array_index") is not None:
                        self.emit("    __ferry_entry::put(out + FERRY_VS_VIEWPORT, uint(%s));" % fn)
                        slots.append(("viewport_array_index", None, fn, "FERRY_W_VIEWPORT", 0))
                    elif f.attr("primitive_id") is not None:
                        pass
                    else:
                        tag = f.attr("user") or f.name
                        self.emit("    __ferry_entry::put(out + %s, %s);" % (off, fn))
                        slots.append((tag, off, fn, "FERRY_W_VARYING", 0))
                        off = "%s + __ferry_entry::ncomp<%s>()" % (off, info_type(fn))
        else:
            self.emit("    %s(%s);" % (name, ", ".join(args)))
        self.emit("}")
        self.info(e, sym, slots, refl, "__r" if ret != "void" else None)

    def info(self, e, sym, slots, refl, rvar):
        """The info function: what the wrapper reads and writes, filled in at
        run time so the sizes come from the compiler."""
        name = e["name"]
        isym = sym.replace("__ferry_", "__ferry_info_", 1)
        self.emit('extern "C" int %s(struct ferry_slot *s, int max)\n{' % isym)
        self.emit("    int k = 0;")
        if rvar is not None:
            self.emit("    typedef decltype(%s(%s)) __R;" % (name, ", ".join(
                "__ferry::declval<%s>()" % (text_of(p.type_toks) or "int") for p in e["params"])))
        for tag, off, expr, what, index in slots:
            t = info_type(expr)
            self.emit("    if (k < max) s[k] = (ferry_slot){%s, %s, %d, %s, __ferry_entry::ncomp<%s>(), "
                      "__ferry_entry::kind<%s>(), 0};" % (cstr(tag), what, index, off or "0", t, t))
            self.emit("    k++;")
        # stage_in of a fragment function
        for f in refl.get("stage_in", []):
            if "tag" not in f:
                continue
        self.emit("    return k;\n}")
        e["symbol"] = sym
        e["info"] = isym
        e["reflection"] = refl

    # ---- fragment ----
    def gen_fragment(self, e):
        name = e["name"]
        sym = "__ferry_fs_" + name
        self.emit('extern "C" void %s(const ferry_call *c, const float *in, float *out)\n{' % sym)
        args, refl = self.bind_params(e, "in")
        ret = e["ret"].strip()
        slots = []
        if ret != "void":
            self.emit("    auto __r = %s(%s);" % (name, ", ".join(args)))
            sname, fields = self.struct_of(ret)
            if fields is None:
                self.emit("    __ferry_entry::put(out, __r);")
                slots.append(("color", "0", "__r", "FERRY_W_COLOR", 0))
            else:
                for f in fields:
                    fn = "__r.%s" % f.name
                    if f.attr("color") is not None:
                        n = int(f.attr("color"), 0)
                        if f.attr("index") not in (None, "0"):
                            n += 8  # dual-source blending's second color
                            self.emit("    __ferry_entry::put(out + FERRY_FS_RESULTS + 4 * %d, %s);" % (n - 8, fn))
                            slots.append((f.name, "FERRY_FS_RESULTS + %d" % (4 * (n - 8)), fn, "FERRY_W_COLOR", n))
                        else:
                            self.emit("    __ferry_entry::put(out + 4 * %d, %s);" % (n, fn))
                            slots.append((f.name, str(4 * n), fn, "FERRY_W_COLOR", n))
                    elif f.attr("depth") is not None:
                        self.emit("    __ferry_entry::put(out + FERRY_FS_DEPTH, %s);" % fn)
                        slots.append((f.name, "FERRY_FS_DEPTH", fn, "FERRY_W_DEPTH", 0))
                    elif f.attr("sample_mask") is not None:
                        self.emit("    __ferry_entry::put(out + FERRY_FS_SAMPLE_MASK, %s);" % fn)
                        slots.append((f.name, "FERRY_FS_SAMPLE_MASK", fn, "FERRY_W_SAMPLE_MASK", 0))
                    elif f.attr("stencil") is not None:
                        self.emit("    __ferry_entry::put(out + FERRY_FS_STENCIL, %s);" % fn)
                        slots.append((f.name, "FERRY_FS_STENCIL", fn, "FERRY_W_STENCIL", 0))
        else:
            self.emit("    %s(%s);" % (name, ", ".join(args)))
        self.emit("}")
        # the inputs: listed with the kinds the compiler gives them
        for f in refl.get("stage_in", []):
            slots.append((f["tag"], None, f["expr"].replace("__a", "__in"), "FERRY_W_INPUT", f["field"]))
        self.info_fragment(e, sym, slots, refl, "__r" if ret != "void" else None)

    def info_fragment(self, e, sym, slots, refl, rvar):
        name = e["name"]
        isym = sym.replace("__ferry_", "__ferry_info_", 1)
        self.emit('extern "C" int %s(struct ferry_slot *s, int max)\n{' % isym)
        self.emit("    int k = 0;")
        if rvar is not None:
            self.emit("    typedef decltype(%s(%s)) __R;" % (name, ", ".join(
                "__ferry::declval<%s>()" % text_of(p.type_toks) for p in e["params"])))
        for i, p in enumerate(e["params"]):
            if p.attr("stage_in") is not None:
                self.emit("    typedef __ferry::plain<%s> __I%d;" % (text_of(p.type_toks), i))
        interp = {f["field"]: f["interp"] for f in refl.get("stage_in", [])}
        for tag, off, expr, what, index in slots:
            ip = interp.get(index, "0") if what == "FERRY_W_INPUT" else "0"
            t = info_type(expr)
            self.emit("    if (k < max) s[k] = (ferry_slot){%s, %s, %d, %s, __ferry_entry::ncomp<%s>(), "
                      "__ferry_entry::kind<%s>(), %s};" % (cstr(tag), what, index, off or "0", t, t, ip))
            self.emit("    k++;")
        self.emit("    return k;\n}")
        e["symbol"] = sym
        e["info"] = isym
        e["reflection"] = refl

    # ---- kernel ----
    def gen_kernel(self, e):
        name = e["name"]
        sym = "__ferry_cs_" + name
        self.emit('extern "C" void %s(const ferry_call *c)\n{' % sym)
        args, refl = self.bind_params(e)
        self.emit("    %s(%s);" % (name, ", ".join(args)))
        self.emit("}")
        e["symbol"] = sym
        e["info"] = None
        e["reflection"] = refl
        for n, a in e["attrs"]:
            if n == "max_total_threads_per_threadgroup":
                e["max_threads"] = a


def fc_literal(ty, expr):
    return "(%s)(%s)" % (ty, expr)


def preprocess(src_path, defines, msl_dir, clang):
    # <metal_stdlib> comes first even where the source doesn't include it, as
    # with Apple's compiler (Blender's shaders start "using namespace metal;")
    cmd = [clang, "-E"] + CLANG_FLAGS + ["-I", msl_dir, "-include", "metal_stdlib", "-D__METAL_VERSION__=240",
                                         "-D__METAL_MACOS__=1", "-D__FERRY_METAL__=1"]
    for d in defines:
        cmd += ["-D", d]
    cmd.append(src_path)
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode:
        sys.stderr.write(r.stderr)
        sys.exit(1)
    return r.stdout


def reflection(src, gen):
    out = {"functions": [], "function_constants": []}
    for f in src.fconsts:
        out["function_constants"].append({"name": f["name"], "index": f["index"], "type": f["type"]})
    for e in src.entries:
        r = e.get("reflection", {})
        out["functions"].append({
            "name": e["name"], "stage": e["stage"], "symbol": e.get("symbol"), "info": e.get("info"),
            "buffers": r.get("buffers", []), "textures": r.get("textures", []),
            "samplers": r.get("samplers", []), "threadgroup": r.get("threadgroup", []),
            "stage_in": [{k: v for k, v in s.items() if k != "expr"} for s in r.get("stage_in", [])],
            "max_threads": e.get("max_threads"),
        })
    return out


def main(argv):
    if len(argv) < 3 or argv[1] not in ("reflect", "build"):
        sys.exit(__doc__ if False else "usage: ferry-mslc reflect|build SOURCE [-o OUT] [-D NAME=VALUE] "
                 "[--fc INDEX=EXPR] [--fcname NAME=EXPR]")
    mode, src_path = argv[1], argv[2]
    defines, fcs, fcnames, out = [], {}, {}, None
    keep = os.environ.get("FERRY_MSLC_KEEP")
    i = 3
    while i < len(argv):
        a = argv[i]
        if a == "-o":
            out = argv[i + 1]
            i += 2
        elif a == "-D":
            defines.append(argv[i + 1])
            i += 2
        elif a.startswith("-D"):
            defines.append(a[2:])
            i += 1
        elif a == "--fc":
            k, v = argv[i + 1].split("=", 1)
            fcs[k] = v
            i += 2
        elif a == "--fcname":
            k, v = argv[i + 1].split("=", 1)
            fcnames[k] = v
            i += 2
        else:
            sys.exit("ferry-mslc: unknown option %s" % a)
    clang = find_tool(["clang", "clang-18", "clang-19", "clang-17", "clang-16", "clang-15"])
    if not clang:
        sys.exit("ferry-mslc: clang isn't installed; Metal shaders need it (package clang)")
    text = preprocess(src_path, defines, MSL_DIR, clang)
    src = Source(text, os.path.abspath(src_path) if os.path.isabs(src_path) else src_path)
    fcvals = {}
    for f in src.fconsts:
        val = fcnames.get(f["name"])
        if val is None and f["index"] is not None:
            val = fcs.get(str(f["index"]))
        if val is not None:
            fcvals[f["name"]] = val
    gen = Gen(src, fcvals)
    gen.gen_all()
    # function constants: their values in place of their declarations
    fcdefs = []
    for f in src.fconsts:
        val = fcnames.get(f["name"])
        if val is None and f["index"] is not None:
            val = fcs.get(str(f["index"]))
        ty = re.sub(r"\b(__global|const|constant)\b", "", f["type"]).strip()
        if val is None:
            rep = "static const %s %s = %s();" % (ty, f["name"], ty)
            fcdefs.append("#define __FERRY_FC_DEFINED_%s false" % f["name"])
        elif re.match(r"^(bool|int|uint|short|ushort|char|uchar|float|half|long|ulong|int32_t|uint32_t)$", ty):
            rep = "static constexpr %s %s = %s;" % (ty, f["name"], fc_literal(ty, val))
            fcdefs.append("#define __FERRY_FC_DEFINED_%s true" % f["name"])
        else:
            rep = "\n#define %s (%s)\n" % (f["name"], fc_literal(ty, val))
            fcdefs.append("#define __FERRY_FC_DEFINED_%s true" % f["name"])
        src.edit(f["start"], f["end"], rep)
    for e in src.entries:
        pass
    # names used by is_function_constant_defined() without a declaration
    used = set(re.findall(r"__FERRY_FC_DEFINED_(\w+)", " ".join(r for _, _, r in src.edits)))
    declared = {f["name"] for f in src.fconsts}
    for u in used - declared:
        fcdefs.append("#define __FERRY_FC_DEFINED_%s false" % u)
    body = apply_edits(text, src.edits)
    final = "\n".join(fcdefs) + "\n" + body + "\n" + "\n".join(gen.out) + "\n"
    refl = reflection(src, gen)
    if mode == "reflect":
        json.dump(refl, sys.stdout, indent=1)
        sys.stdout.write("\n")
        return 0
    if not out:
        sys.exit("ferry-mslc: build needs -o LIBRARY.dylib")
    with tempfile.TemporaryDirectory(prefix="ferry-mslc-") as tmp:
        cpp = os.path.join(tmp, "shader.clcpp")
        obj = os.path.join(tmp, "shader.o")
        with open(cpp, "w") as fh:
            fh.write(final)
        if keep:
            with open(keep, "w") as fh:
                fh.write(final)
        opt = os.environ.get("FERRY_MSLC_OPT", "-O2")
        r = subprocess.run([clang] + CLANG_FLAGS + [opt, "-I", MSL_DIR, "-c", cpp, "-o", obj],
                           capture_output=True, text=True)
        if r.returncode:
            sys.stderr.write(r.stderr)
            return 1
        lld = find_tool(["ld64.lld", "ld64.lld-18", "ld64.lld-19", "ld64.lld-17"])
        if not lld:
            sys.exit("ferry-mslc: LLVM's Mach-O linker (ld64.lld, package lld) isn't installed")
        r = subprocess.run([lld, "-dylib", "-arch", "x86_64", "-platform_version", "macos", "11.0", "11.0",
                            "-undefined", "dynamic_lookup", "-install_name", "@rpath/ferry-metal-shader.dylib",
                            "-o", out, obj], capture_output=True, text=True)
        if r.returncode:
            sys.stderr.write(r.stderr)
            return 1
    with open(out + ".json", "w") as fh:
        json.dump(refl, fh, indent=1)
    return 0


MSL_DIR = find_msl_dir()
if __name__ == "__main__":
    sys.exit(main(sys.argv))
