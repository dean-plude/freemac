#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
#
#   ferry-mslc reflect SOURCE.metal [-D NAME[=VALUE]]... > reflection.json
#   ferry-mslc build SOURCE.metal -o LIBRARY.dylib [-D ...] [--fc INDEX=EXPR]...
#                    [--fcname NAME=EXPR]... [--sdk DIR]
#
# Ferry's Metal shader compiler (freemac 1.NEXT). A Mac program hands Metal
# its shaders as Metal Shading Language source; Ferry's Metal.framework runs
# this to turn that source into a Mac library (a .dylib) of ordinary
# processor code, which it then loads and calls for every vertex, fragment
# and compute thread.
#
# MSL is C++ with a few additions, so the source is compiled by clang as
# C++ for OpenCL (whose address spaces are MSL's) against Ferry's own
# <metal_stdlib> (ferry/metal/msl). Before that, this script:
#   - finds the vertex, fragment and kernel functions and the [[attributes]]
#     on their arguments and on the fields of the structs they take and
#     return, and takes the attributes out (clang has no use for them);
#   - puts the values of function constants in place of their declarations;
#   - gives threadgroup arrays declared in a function body a block shared
#     by the threadgroup;
#   - writes, for each function, a wrapper with a plain C name that
#     Metal.framework calls with the bound resources, and an info function
#     that lists what the function reads and writes.
# Written from Apple's public "Metal Shading Language Specification".
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile

HERE = os.path.dirname(os.path.realpath(__file__))


SCALAR_TYPES = {"bool", "char", "uchar", "short", "ushort", "int", "uint", "long", "ulong", "float", "half",
                "double", "size_t", "ptrdiff_t", "int8_t", "uint8_t", "int16_t", "uint16_t", "int32_t",
                "uint32_t", "int64_t", "uint64_t", "unsigned", "signed", "auto"}


def find_msl_dir():
    for d in (os.environ.get("FERRY_MSL_DIR"), os.path.join(HERE, "msl"), "/usr/share/ferry/metal/msl"):
        if d and os.path.isfile(os.path.join(d, "metal_stdlib")):
            return d
    sys.exit("ferry-mslc: Ferry's Metal headers (metal_stdlib) aren't installed")


def find_tool(names):
    for n in names:
        for d in os.environ.get("PATH", "/usr/bin").split(":"):
            p = os.path.join(d, n)
            if os.access(p, os.X_OK):
                return p
    for v in range(30, 13, -1):
        for n in names:
            p = "/usr/lib/llvm-%d/bin/%s" % (v, n.split("-")[0])
            if os.access(p, os.X_OK):
                return p
    return None


CLANG_FLAGS = ["-x", "clcpp", "-cl-std=clc++2021", "-cl-no-stdinc", "-cl-single-precision-constant",
               "-target", "x86_64-apple-macosx11", "-fdeclspec", "-fno-stack-protector", "-ffp-contract=off",
               "-Wno-unknown-attributes", "-Wno-unused-value", "-Wno-ignored-attributes"]

# ---- tokens -------------------------------------------------------------------------
TOKEN = re.compile(r"""
    (?P<ws>\s+)
  | (?P<marker>^\#[^\n]*)
  | (?P<str>"(?:[^"\\\n]|\\.)*")
  | (?P<chr>'(?:[^'\\\n]|\\.)*')
  | (?P<num>\.?[0-9](?:[eEpP][+-]|[0-9a-zA-Z_.])*)
  | (?P<id>[A-Za-z_][A-Za-z0-9_]*)
  | (?P<punct>\[\[|\]\]|::|->|<<=|>>=|\+\+|--|<<|>>|<=|>=|==|!=|&&|\|\||[-+*/%&|^]=|\.\.\.|[^\s])
""", re.X | re.M)


class Tok:
    __slots__ = ("kind", "text", "start", "end", "user")

    def __init__(self, kind, text, start, end, user):
        self.kind, self.text, self.start, self.end, self.user = kind, text, start, end, user

    def __repr__(self):
        return self.text


def tokenize(text, user_file):
    """Tokens of the preprocessed text; .user tells whether a token came from
    the program's own source (rather than from Ferry's headers)."""
    toks = []
    user = True
    for m in TOKEN.finditer(text):
        k = m.lastgroup
        if k == "ws":
            continue
        if k == "marker":
            mm = re.match(r'#\s*(?:line\s+)?\d+\s+"((?:[^"\\]|\\.)*)"', m.group())
            if mm:
                f = mm.group(1)
                user = not (f.startswith(MSL_DIR) or f.startswith("<"))
                if f == "<built-in>" or f == "<command line>":
                    user = False
                if f == user_file:
                    user = True
            continue
        toks.append(Tok(k, m.group(), m.start(), m.end(), user))
    return toks


def match_close(toks, i):
    """Index of the bracket that closes toks[i]."""
    pairs = {"(": ")", "[": "]", "{": "}", "[[": "]]"}
    open_, close = toks[i].text, pairs[toks[i].text]
    depth = 0
    for j in range(i, len(toks)):
        t = toks[j].text
        if t == open_:
            depth += 1
        elif t == close:
            depth -= 1
            if depth == 0:
                return j
    raise SystemExit("ferry-mslc: unbalanced %r" % open_)


def split_commas(toks):
    """Splits a token list at commas outside brackets and template angles."""
    parts, cur, depth, angle = [], [], 0, 0
    for t in toks:
        x = t.text
        if x in ("(", "[", "{", "[["):
            depth += 1
        elif x in (")", "]", "}", "]]"):
            depth -= 1
        elif depth == 0 and x == "<" and cur and cur[-1].kind == "id":
            angle += 1
        elif depth == 0 and x == ">" and angle:
            angle -= 1
        elif depth == 0 and x == ">>" and angle:
            angle = max(0, angle - 2)
        if x == "," and depth == 0 and angle == 0:
            parts.append(cur)
            cur = []
        else:
            cur.append(t)
    if cur:
        parts.append(cur)
    return parts


def text_of(toks):
    out = []
    for i, t in enumerate(toks):
        if i and (t.kind in ("id", "num") and toks[i - 1].kind in ("id", "num")):
            out.append(" ")
        elif i:
            out.append(" ")
        out.append(t.text)
    return "".join(out)


def parse_attr(toks):
    """'[[' a(1), b ']]' -> [('a', '1'), ('b', None)]"""
    out = []
    for part in split_commas(toks):
        if not part:
            continue
        name = part[0].text
        k = 1
        while k + 1 < len(part) and part[k].text == "::":
            name += "::" + part[k + 1].text
            k += 2
        # the source is read after the preprocessor, which has already turned
        # the threadgroup address-space macro into __local, the attribute's
        # name included: [[threadgroup(0)]] arrives as [[__local(0)]]
        # (freemac 1.268; Metal Shading Language Specification, 5.2.1)
        if name == "__local":
            name = "threadgroup"
        arg = None
        if k < len(part) and part[k].text == "(":
            arg = text_of(part[k + 1:-1]).strip()
        out.append((name, arg))
    return out


class Decl:
    """A declaration with its attributes taken out: type tokens, name, array
    dimensions."""

    def __init__(self, toks, attrs):
        self.attrs = attrs
        self.toks = toks
        # the declarator name: the last identifier before '[' (array) or '=' or the end
        end = len(toks)
        for k, t in enumerate(toks):
            if t.text in ("=",):
                end = k
                break
        k = end
        dims = []
        while k > 0 and toks[k - 1].text == "]":
            o = k - 1
            depth = 0
            while o >= 0:
                if toks[o].text == "]":
                    depth += 1
                elif toks[o].text == "[":
                    depth -= 1
                    if depth == 0:
                        break
                o -= 1
            dims.insert(0, text_of(toks[o + 1:k - 1]))
            k = o
        if k > 0 and toks[k - 1].kind == "id":
            self.name = toks[k - 1].text
            self.type_toks = toks[:k - 1]
        else:
            self.name = None
            self.type_toks = toks[:k]
        self.dims = dims

    def attr(self, name):
        for n, a in self.attrs:
            if n == name:
                return a if a is not None else ""
        return None

    @property
    def type(self):
        t = text_of(self.type_toks)
        for d in self.dims:
            t = t  # arrays are spelled through decltype in the wrappers
        return t


def take_attrs(toks):
    """Removes [[...]] groups from a token list, returning the remaining
    tokens and the attributes."""
    out, attrs, k = [], [], 0
    while k < len(toks):
        if toks[k].text == "[[":
            j = k
            depth = 0
            while j < len(toks):
                if toks[j].text == "[[":
                    depth += 1
                elif toks[j].text == "]]":
                    depth -= 1
                    if depth == 0:
                        break
                j += 1
            attrs += parse_attr(toks[k + 1:j])
            k = j + 1
        else:
            out.append(toks[k])
            k += 1
    return out, attrs


STAGES = {"vertex": "vertex", "fragment": "fragment", "kernel": "kernel", "__ferry_kw_kernel": "kernel"}


class Source:
    def __init__(self, text, user_file):
        self.text = text
        self.toks = tokenize(text, user_file)
        self.edits = []      # (start, end, replacement)
        self.structs = {}    # name -> [Decl]
        self.entries = []
        self.fconsts = []    # dicts: name, index, type, start, end
        self.tg_decls = 0
        self.parse()

    def edit(self, start, end, rep):
        self.edits.append((start, end, rep))

    def parse(self):
        toks = self.toks
        n = len(toks)
        # every [[...]] in the program's own code goes
        for k, t in enumerate(toks):
            if t.user and t.text == "[[":
                j = match_close(toks, k)
                self.edit(t.start, toks[j].end, " ")
        k = 0
        brace_stack = []   # kinds of the open braces: 'ns', 'struct', 'func', 'other'
        seen_stack = [set()]  # member function headings met in each open brace
        stmt_start = 0
        while k < n:
            t = toks[k]
            x = t.text
            if x == "{":
                kind = "other"
                prev = toks[stmt_start:k]
                ptext = [p.text for p in prev]
                if "namespace" in ptext and "(" not in ptext:
                    kind = "ns"
                elif ptext[:1] in (["struct"], ["class"], ["union"]) or (
                        "struct" in ptext and "(" not in ptext and "=" not in ptext):
                    kind = "struct"
                    if t.user:
                        self.parse_struct(prev, k)
                elif prev and prev[-1].text in (")", "const") or "(" in ptext:
                    kind = "func"
                    if t.user and all(b in ("ns",) for b in brace_stack):
                        self.maybe_entry(prev, k)
                    # device and constant are both __global here, so a struct's
                    # "const device" and "const constant" overloads (as in
                    # SPIRV-Cross's spvUnsafeArray) become the same member: the
                    # second one goes
                    if t.user and prev and brace_stack and brace_stack[-1] == "struct":
                        head = " ".join(p.text for p in prev)
                        norm = re.sub(r"\b(device|constant)\b", "__global", head)
                        if norm in seen_stack[-1]:
                            j = match_close(toks, k)
                            self.edit(prev[0].start, toks[j].end, " ")
                        else:
                            seen_stack[-1].add(norm)
                brace_stack.append(kind)
                seen_stack.append(set())
                stmt_start = k + 1
            elif x == "}":
                if brace_stack:
                    brace_stack.pop()
                    seen_stack.pop()
                stmt_start = k + 1
            elif x == ";":
                if t.user:
                    self.statement(toks[stmt_start:k + 1], brace_stack)
                stmt_start = k + 1
            elif x in ("public", "private", "protected") and k + 1 < n and toks[k + 1].text == ":":
                stmt_start = k + 2
            elif x == ":" and stmt_start == k - 1 and toks[k - 1].text in ("public", "private", "protected"):
                stmt_start = k + 1
            k += 1
        # is_function_constant_defined(name)
        for k, t in enumerate(toks):
            if t.user and t.text == "is_function_constant_defined" and k + 3 < n and toks[k + 1].text == "(":
                j = match_close(toks, k + 1)
                name = text_of(toks[k + 2:j])
                self.edit(t.start, toks[j].end, "__FERRY_FC_DEFINED_%s" % name)
        self.wrap_conditionals()
        self.generic_array_params()
        self.constexpr_locals()

    def constexpr_locals(self):
        """A constexpr local of a vector or matrix type ("constexpr int2
        corners[4] = ...") becomes const: Metal's vectors are literal types,
        ours are built in loops, and a shader can't tell the difference."""
        toks = self.toks
        stack = []
        for k, t in enumerate(toks):
            if t.text == "{":
                p = toks[k - 1].text if k else ""
                stack.append("func" if p in (")", "const", "noexcept") or (p == "]]") else
                             "init" if p in ("=", ",", "{", "(", "return") or toks[k - 1].kind == "id" and
                             k > 1 and toks[k - 2].kind == "id" else "other")
            elif t.text == "}":
                if stack:
                    stack.pop()
            elif t.text == "constexpr" and t.user and "func" in stack and k + 1 < len(toks):
                nxt = toks[k + 1]
                after = toks[k + 2].text if k + 2 < len(toks) else ""
                if nxt.text not in SCALAR_TYPES and nxt.text not in ("static", "const", "inline") and after != "(":
                    self.edit(t.start, t.end, "const")

    def generic_array_params(self):
        """A parameter "float4 offset[3]" becomes "float4 __generic *offset".

        C++ for OpenCL makes an array parameter a pointer to private memory,
        so a member array (reached through the object, which is generic)
        can't be passed to it; Metal takes either."""
        toks = self.toks
        n = len(toks)
        spaces = {"__private", "__global", "__local", "__constant", "__generic", "thread",
                  "device", "constant", "threadgroup", "threadgroup_imageblock", "ray_data", "object_data"}
        not_funcs = {"if", "while", "for", "switch", "return", "sizeof", "alignof", "decltype",
                     "static_assert", "catch", "alignas", "defined"}
        for k in range(1, n):
            t = toks[k]
            if t.text != "(" or not t.user or toks[k - 1].kind != "id" or toks[k - 1].text in not_funcs:
                continue
            j = match_close(toks, k)
            group = toks[k + 1:j]
            if not group or any(g.text == "[[" or not g.user for g in group):
                continue
            for part in split_commas(group):
                if not part or part[-1].text != "]":
                    continue
                d = Decl(part, [])
                if not d.name or not d.dims or not d.type_toks:
                    continue
                tt = [x.text for x in d.type_toks]
                if any(x in spaces for x in tt) or tt.count("<") != tt.count(">"):
                    continue
                if not all(x.kind in ("id", "num") or x.text in ("::", "<", ">", ",") for x in d.type_toks):
                    continue
                if tt[0] in ("return", "case", "else", "new", "delete", "throw", "goto"):
                    continue
                if d.type_toks[0].kind != "id":
                    continue
                ty = text_of(d.type_toks)
                rest = "".join("[%s]" % x for x in d.dims[1:])
                if rest:
                    rep = "%s __generic (*%s)%s" % (ty, d.name, rest)
                else:
                    rep = "%s __generic *%s" % (ty, d.name)
                self.edit(part[0].start, part[-1].end, rep)

    def wrap_conditionals(self):
        """c ? a : b, with each of a and b passed through __ferry_value().

        In clang's C++ for OpenCL a local vector is a "__private vec" while a
        function's result is a plain "vec", and ?: won't take one of each
        (Metal's own compiler does). Passing both through a function that
        returns its argument by value gives the two sides the same type."""
        toks = self.toks
        n = len(toks)
        opens, closes = ("(", "[", "{", "[["), (")", "]", "}", "]]")

        def end_of(k, stop_colon):
            # the index after the last token of an operand starting at k
            depth, pending = 0, 0
            j = k
            while j < n:
                x = toks[j].text
                if x in opens:
                    depth += 1
                elif x in closes:
                    if depth == 0:
                        return j
                    depth -= 1
                elif depth == 0:
                    if x == "?":
                        pending += 1
                    elif x == ":":
                        if pending:
                            pending -= 1
                        else:
                            return j
                    elif x in (";", ",") and not pending:
                        return j
                j += 1
            return None

        in_attr = 0
        for k, t in enumerate(toks):
            if t.text == "[[":
                in_attr += 1
            elif t.text == "]]":
                in_attr -= 1
            if t.text != "?" or not t.user or in_attr:
                continue
            colon = end_of(k + 1, True)
            if colon is None or colon == k + 1 or toks[colon].text != ":":
                continue
            stop = end_of(colon + 1, False)
            if stop is None or stop == colon + 1:
                continue
            if not all(x.user for x in toks[k:stop]):
                continue
            self.edit(toks[k + 1].start, toks[k + 1].start, "__ferry_value(")
            self.edit(toks[colon - 1].end, toks[colon - 1].end, ")")
            self.edit(toks[colon + 1].start, toks[colon + 1].start, "__ferry_value(")
            self.edit(toks[stop - 1].end, toks[stop - 1].end, ")")

    def statement(self, st, brace_stack):
        if not st:
            return
        body, attrs = take_attrs(st[:-1])
        names = [a for a, _ in attrs]
        # program-scope function constants
        if "function_constant" in names and all(b == "ns" for b in brace_stack):
            d = Decl([t for t in body if t.text not in ("__global", "const", "static")], attrs)
            self.fconsts.append({"name": d.name, "index": d.attr("function_constant"),
                                 "type": text_of(d.type_toks), "start": st[0].start, "end": st[-1].end})
            return
        # threadgroup memory declared in a function body
        if brace_stack and brace_stack[-1] != "struct" and "func" in brace_stack and body and \
                body[0].text == "__local":
            texts = [t.text for t in body]
            d = Decl(body[1:], attrs)
            # (the sizes may hold calls: Blender sizes by mtl_WorkGroupSize().x)
            head = [t.text for t in d.type_toks]
            if "=" not in texts and not any(x in head for x in ("*", "&", "(", "&&")):
                if d.name:
                    ty = text_of(d.type_toks)
                    dims = "".join("[%s]" % x for x in d.dims)
                    full = "%s%s" % (ty, dims)
                    ident = self.tg_decls
                    self.tg_decls += 1
                    if dims:
                        rep = ("__local %s (&%s)%s = *(__local %s (*)%s)__ferry_tg_alloc(sizeof(%s), alignof(%s), %d);"
                               % (ty, d.name, dims, ty, dims, full, ty, ident))
                    else:
                        rep = ("__local %s &%s = *(__local %s *)__ferry_tg_alloc(sizeof(%s), alignof(%s), %d);"
                               % (ty, d.name, ty, ty, ty, ident))
                    self.edit(st[0].start, st[-1].end, rep)

    def parse_struct(self, prev, k):
        toks = self.toks
        ptext = [p.text for p in prev]
        idx = max(i for i, x in enumerate(ptext) if x in ("struct", "class", "union"))
        name = None
        for p in prev[idx + 1:]:
            if p.kind == "id" and p.text not in ("alignas",):
                name = p.text
        j = match_close(toks, k)
        if not name and "typedef" in ptext[:idx]:
            # typedef struct { ... } Name;
            for t in toks[j + 1:j + 4]:
                if t.kind == "id":
                    name = t.text
                    break
                if t.text == ";":
                    break
        if not name:
            return
        body = toks[k + 1:j]
        fields = []
        cur = []
        depth = 0
        for t in body:
            if t.text in ("{", "(", "["):
                depth += 1
            elif t.text in ("}", ")", "]"):
                depth -= 1
            if t.text == ";" and depth == 0:
                rest, attrs = take_attrs(cur)
                cur = []
                texts = [r.text for r in rest]
                if not rest or "(" in texts or texts[0] in ("static", "typedef", "using", "friend", "template"):
                    continue
                if texts and texts[-1] == "}":
                    continue
                for part in split_commas(rest):
                    pass
                parts = split_commas(rest)
                first = Decl(parts[0], attrs)
                fields.append(first)
                for extra in parts[1:]:
                    d = Decl(first.type_toks + extra, attrs)
                    fields.append(d)
            elif t.text in ("public", "private", "protected") and depth == 0:
                continue
            elif t.text == ":" and depth == 0 and cur and cur[-1].text in ("public", "private", "protected"):
                cur.pop()
                continue
            else:
                cur.append(t)
        self.structs[name] = [f for f in fields if f.name]

    def maybe_entry(self, prev, k):
        # [[attrs]] (vertex|fragment|kernel) TYPE NAME ( PARAMS ) [[attrs]]? {
        stage = None
        pre_attrs = []
        q = 0
        rest, attrs_all = take_attrs(prev)
        for q, t in enumerate(rest):
            if t.text in STAGES:
                stage = STAGES[t.text]
                break
            if t.text in ("static", "inline", "extern"):
                continue
            return
        if stage is None:
            return
        # the parameter list: the last '(' ... ')' group
        r = rest[q + 1:]
        close = None
        for i in range(len(r) - 1, -1, -1):
            if r[i].text == ")":
                close = i
                break
        if close is None:
            return
        depth = 0
        open_ = None
        for i in range(close, -1, -1):
            if r[i].text == ")":
                depth += 1
            elif r[i].text == "(":
                depth -= 1
                if depth == 0:
                    open_ = i
                    break
        if open_ is None or open_ == 0:
            return
        name_tok = r[open_ - 1]
        ret_toks = r[:open_ - 1]
        # the parameters keep their attributes: take them from the original tokens
        orig_open = prev.index(name_tok) + 1
        orig_close = match_close(self.toks, self.toks.index(prev[orig_open]))
        ptoks = self.toks[self.toks.index(prev[orig_open]) + 1:orig_close]
        params = []
        for part in split_commas(ptoks):
            body, attrs = take_attrs(part)
            if not body or [b.text for b in body] == ["void"]:
                continue
            params.append(Decl(body, attrs))
        # where the qualifier was: take it out
        qual = rest[q]
        self.edit(qual.start, qual.end, " ")
        self.entries.append({
            "name": name_tok.text, "stage": stage, "ret": text_of(ret_toks), "params": params,
            "attrs": [a for a in attrs_all],
        })


def apply_edits(text, edits):
    # at one place an insertion goes before a replacement that starts there
    edits = sorted(edits, key=lambda e: (e[0], e[1] != e[0], -e[1]))
    out, pos = [], 0
    for s, e, r in edits:
        if s < pos:
            continue
        out.append(text[pos:s])
        out.append(r)
        pos = e
    out.append(text[pos:])
    return "".join(out)


