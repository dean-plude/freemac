<?xml version="1.0" encoding="UTF-8"?>
<!-- Ferry's own test document for ferry-ibtool's toolbars, constraints and
     progress indicators (freemac's polish round), written by hand in the
     format Interface Builder saves. -->
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="20000" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="20000"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="PolishOwner">
            <connections>
                <outlet property="window" destination="win" id="o1"/>
                <outlet property="toolbar" destination="tb" id="o2"/>
                <outlet property="label" destination="lbl" id="o3"/>
                <outlet property="spinner" destination="spin" id="o4"/>
                <outlet property="bar" destination="bar" id="o5"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <window title="Polish" allowsToolTipsWhenApplicationIsInactive="NO" autorecalculatesKeyViewLoop="NO" releasedWhenClosed="NO" animationBehavior="default" id="win">
            <windowStyleMask key="styleMask" titled="YES" closable="YES" resizable="YES"/>
            <rect key="contentRect" x="100" y="100" width="400" height="200"/>
            <rect key="screenRect" x="0.0" y="0.0" width="1280" height="800"/>
            <view key="contentView" id="cv">
                <rect key="frame" x="0.0" y="0.0" width="400" height="200"/>
                <autoresizingMask key="autoresizingMask"/>
                <subviews>
                    <textField horizontalHuggingPriority="251" verticalHuggingPriority="750" horizontalCompressionResistancePriority="752" translatesAutoresizingMaskIntoConstraints="NO" id="lbl">
                        <rect key="frame" x="18" y="163" width="60" height="17"/>
                        <textFieldCell key="cell" lineBreakMode="clipping" title="Label" id="lblc">
                            <font key="font" metaFont="system"/>
                        </textFieldCell>
                    </textField>
                    <progressIndicator horizontalHuggingPriority="750" verticalHuggingPriority="750" maxValue="100" displayedWhenStopped="NO" bezeled="NO" indeterminate="YES" controlSize="small" style="spinning" id="spin">
                        <rect key="frame" x="20" y="20" width="16" height="16"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                    </progressIndicator>
                    <progressIndicator maxValue="100" bezeled="NO" style="bar" id="bar">
                        <rect key="frame" x="50" y="20" width="200" height="20"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                    </progressIndicator>
                </subviews>
                <constraints>
                    <constraint firstItem="lbl" firstAttribute="leading" secondItem="cv" secondAttribute="leading" constant="20" id="c1"/>
                    <constraint firstItem="lbl" firstAttribute="top" secondItem="cv" secondAttribute="top" constant="20" id="c2"/>
                    <constraint firstAttribute="trailing" relation="greaterThanOrEqual" secondItem="lbl" secondAttribute="trailing" constant="20" id="c3"/>
                    <constraint firstAttribute="height" relation="greaterThanOrEqual" constant="240" priority="999" id="c4"/>
                </constraints>
            </view>
            <toolbar key="toolbar" implicitIdentifier="5A0C9D0E-0000-4000-8000-000000000001" autosavesConfiguration="NO" allowsUserCustomization="NO" displayMode="iconOnly" sizeMode="regular" id="tb">
                <allowedToolbarItems>
                    <toolbarItem implicitItemIdentifier="NSToolbarFlexibleSpaceItem" id="flex"/>
                    <toolbarItem implicitItemIdentifier="7B1D0000-0000-4000-8000-000000000002" label="Refresh" paletteLabel="Refresh Items" toolTip="Refresh the list" tag="4" id="refresh">
                        <connections>
                            <action selector="refresh:" target="-2" id="a1"/>
                        </connections>
                    </toolbarItem>
                    <toolbarItem implicitItemIdentifier="7B1D0000-0000-4000-8000-000000000003" label="Search" paletteLabel="Search" id="search">
                        <nil key="toolTip"/>
                        <size key="minSize" width="96" height="22"/>
                        <size key="maxSize" width="200" height="22"/>
                        <searchField key="view" wantsLayer="YES" verticalHuggingPriority="750" id="sf">
                            <rect key="frame" x="0.0" y="14" width="96" height="22"/>
                            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                            <searchFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" borderStyle="bezel" bezelStyle="round" id="sfc">
                                <font key="font" metaFont="system"/>
                            </searchFieldCell>
                        </searchField>
                    </toolbarItem>
                </allowedToolbarItems>
                <defaultToolbarItems>
                    <toolbarItem reference="refresh"/>
                    <toolbarItem reference="flex"/>
                    <toolbarItem reference="search"/>
                </defaultToolbarItems>
                <connections>
                    <outlet property="delegate" destination="-2" id="o6"/>
                </connections>
            </toolbar>
        </window>
    </objects>
</document>
