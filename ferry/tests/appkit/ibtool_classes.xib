<?xml version="1.0" encoding="UTF-8"?>
<!-- Ferry's own test document for ferry-ibtool (freemac 1.229, Ferry 0.53.0),
     written by hand in the format Interface Builder saves: the classes the
     seven apps' xibs use that the tool used to make as plain views. -->
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="20000" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="20000"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="ICOwner">
            <connections>
                <outlet property="window" destination="win" id="o1"/>
                <outlet property="textView" destination="tv" id="o2"/>
                <outlet property="notes" destination="tv2" id="o3"/>
                <outlet property="webView" destination="web" id="o4"/>
                <outlet property="matrix" destination="mx" id="o5"/>
                <outlet property="firstCheck" destination="mc1" id="o6"/>
                <outlet property="level" destination="lvl" id="o7"/>
                <outlet property="datePicker" destination="dp" id="o8"/>
                <outlet property="pathControl" destination="path" id="o9"/>
                <outlet property="numberField" destination="num" id="o10"/>
                <outlet property="sizeField" destination="size" id="o11"/>
                <outlet property="dateField" destination="date" id="o12"/>
                <outlet property="customField" destination="cust" id="o13"/>
                <outlet property="ruleEditor" destination="rule" id="o14"/>
                <outlet property="recorder" destination="rec" id="o15"/>
                <outlet property="collection" destination="coll" id="o16"/>
                <outlet property="durations" destination="dcf" id="o17"/>
                <outlet property="comboCell" destination="cbc" id="o18"/>
                <outlet property="item" destination="itm" id="o19"/>
                <outlet property="table" destination="tbl" id="o20"/>
                <outlet property="composition" destination="qc" id="o21"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <userDefaultsController representsSharedInstance="YES" id="udc"/>
        <dateComponentsFormatter unitsStyle="positional" id="dcf">
            <zeroFormattingBehavior key="zeroFormattingBehavior" dropLeading="YES"/>
        </dateComponentsFormatter>
        <comboBoxCell scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" borderStyle="bezel" title="first" drawsBackground="YES" completes="NO" numberOfVisibleItems="4" id="cbc">
            <font key="font" metaFont="system"/>
            <objectValues>
                <string>first</string>
                <string>second</string>
            </objectValues>
        </comboBoxCell>
        <collectionViewItem id="itm" customClass="ICItem">
            <connections>
                <outlet property="view" destination="itemview" id="o30"/>
            </connections>
        </collectionViewItem>
        <customView id="itemview">
            <rect key="frame" x="0.0" y="0.0" width="48" height="48"/>
        </customView>
        <window title="Classes" allowsToolTipsWhenApplicationIsInactive="NO" autorecalculatesKeyViewLoop="NO" releasedWhenClosed="NO" visibleAtLaunch="NO" animationBehavior="default" id="win">
            <windowStyleMask key="styleMask" titled="YES" closable="YES" resizable="YES"/>
            <windowPositionMask key="initialPositionMask" leftStrut="YES" rightStrut="YES" topStrut="YES" bottomStrut="YES"/>
            <rect key="contentRect" x="100" y="100" width="640" height="480"/>
            <rect key="screenRect" x="0.0" y="0.0" width="1440" height="877"/>
            <view key="contentView" id="content">
                <rect key="frame" x="0.0" y="0.0" width="640" height="480"/>
                <autoresizingMask key="autoresizingMask"/>
                <subviews>
                    <scrollView horizontalLineScroll="10" horizontalPageScroll="10" verticalLineScroll="10" verticalPageScroll="10" hasHorizontalScroller="NO" id="sv">
                        <rect key="frame" x="20" y="360" width="280" height="100"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                        <clipView key="contentView" drawsBackground="NO" id="clip">
                            <rect key="frame" x="1" y="1" width="278" height="98"/>
                            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                            <subviews>
                                <textView editable="NO" importsGraphics="NO" richText="NO" verticallyResizable="YES" usesFontPanel="YES" findStyle="panel" allowsUndo="YES" smartInsertDelete="YES" id="tv">
                                    <rect key="frame" x="0.0" y="0.0" width="278" height="98"/>
                                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                    <attributedString key="textStorage">
                                        <fragment content="Hello, ">
                                            <attributes>
                                                <font key="NSFont" metaFont="system"/>
                                                <paragraphStyle key="NSParagraphStyle" alignment="center" lineBreakMode="wordWrapping" baseWritingDirection="natural"/>
                                            </attributes>
                                        </fragment>
                                        <fragment content="world">
                                            <attributes>
                                                <font key="NSFont" name="Menlo-Regular" size="12"/>
                                                <color key="NSColor" red="1" green="0.0" blue="0.0" alpha="1" colorSpace="calibratedRGB"/>
                                                <paragraphStyle key="NSParagraphStyle" alignment="center" lineBreakMode="wordWrapping" baseWritingDirection="natural"/>
                                            </attributes>
                                        </fragment>
                                    </attributedString>
                                    <color key="textColor" name="textColor" catalog="System" colorSpace="catalog"/>
                                    <color key="backgroundColor" red="1" green="1" blue="0.5" alpha="1" colorSpace="calibratedRGB"/>
                                    <size key="minSize" width="278" height="98"/>
                                    <size key="maxSize" width="463" height="10000000"/>
                                    <color key="insertionPointColor" name="textColor" catalog="System" colorSpace="catalog"/>
                                </textView>
                            </subviews>
                        </clipView>
                    </scrollView>
                    <scrollView horizontalLineScroll="10" horizontalPageScroll="10" verticalLineScroll="10" verticalPageScroll="10" hasHorizontalScroller="NO" id="sv2">
                        <rect key="frame" x="320" y="360" width="300" height="100"/>
                        <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMinY="YES"/>
                        <clipView key="contentView" id="clip2">
                            <rect key="frame" x="1" y="1" width="298" height="98"/>
                            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                            <subviews>
                                <textView importsGraphics="NO" verticallyResizable="YES" continuousSpellChecking="YES" allowsUndo="YES" usesRuler="YES" quoteSubstitution="YES" id="tv2" customClass="ICTextView">
                                    <rect key="frame" x="0.0" y="0.0" width="298" height="98"/>
                                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                    <color key="textColor" name="textColor" catalog="System" colorSpace="catalog"/>
                                    <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                    <size key="minSize" width="298" height="98"/>
                                    <size key="maxSize" width="463" height="10000000"/>
                                    <color key="insertionPointColor" red="0.0" green="0.0" blue="1" alpha="1" colorSpace="calibratedRGB"/>
                                    <connections>
                                        <binding destination="udc" name="value" keyPath="values.ICNotes" id="b1"/>
                                    </connections>
                                </textView>
                            </subviews>
                        </clipView>
                    </scrollView>
                    <webView maintainsBackForwardList="NO" translatesAutoresizingMaskIntoConstraints="NO" id="web">
                        <rect key="frame" x="20" y="250" width="200" height="100"/>
                        <webPreferences key="preferences" defaultFontSize="16" defaultFixedFontSize="13" minimumFontSize="7" plugInsEnabled="NO" javaEnabled="NO" javaScriptCanOpenWindowsAutomatically="NO">
                            <nil key="identifier"/>
                        </webPreferences>
                    </webView>
                    <matrix verticalHuggingPriority="750" mode="highlight" allowsEmptySelection="NO" autosizesCells="NO" id="mx">
                        <rect key="frame" x="240" y="270" width="200" height="48"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                        <size key="cellSize" width="180" height="21"/>
                        <size key="intercellSpacing" width="0.0" height="6"/>
                        <buttonCell key="prototype" type="check" title="Check" bezelStyle="regularSquare" imagePosition="left" alignment="left" inset="2" id="mproto">
                            <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                            <font key="font" metaFont="system"/>
                        </buttonCell>
                        <cells>
                            <column>
                                <buttonCell type="check" title="Show in menu bar" bezelStyle="regularSquare" imagePosition="left" alignment="left" state="on" inset="2" id="mc1">
                                    <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                                    <font key="font" metaFont="system"/>
                                    <connections>
                                        <binding destination="udc" name="value" keyPath="values.ICShowsMenu" id="b2"/>
                                    </connections>
                                </buttonCell>
                                <buttonCell type="check" title="Open at login" bezelStyle="regularSquare" imagePosition="left" alignment="left" tag="7" inset="2" id="mc2">
                                    <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                                    <font key="font" metaFont="system"/>
                                    <connections>
                                        <action selector="toggle:" target="-2" id="a1"/>
                                    </connections>
                                </buttonCell>
                            </column>
                        </cells>
                    </matrix>
                    <levelIndicator verticalHuggingPriority="750" id="lvl">
                        <rect key="frame" x="460" y="290" width="96" height="18"/>
                        <levelIndicatorCell key="cell" alignment="left" doubleValue="3" maxValue="5" warningValue="4" criticalValue="2" levelIndicatorStyle="rating" id="lvlcell"/>
                    </levelIndicator>
                    <datePicker verticalHuggingPriority="750" id="dp">
                        <rect key="frame" x="240" y="230" width="200" height="27"/>
                        <datePickerCell key="cell" borderStyle="bezel" alignment="left" id="dpcell">
                            <font key="font" metaFont="system"/>
                            <date key="date" timeIntervalSinceReferenceDate="-595929600"/>
                            <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog"/>
                            <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                            <datePickerElements key="datePickerElements" year="YES" month="YES" day="YES" hour="YES" minute="YES"/>
                        </datePickerCell>
                    </datePicker>
                    <pathControl verticalHuggingPriority="750" allowsExpansionToolTips="YES" id="path">
                        <rect key="frame" x="20" y="200" width="200" height="25"/>
                        <pathCell key="cell" selectable="YES" editable="YES" alignment="left" pathStyle="popUp" id="pathcell">
                            <font key="font" metaFont="system"/>
                            <url key="url" string="file:///tmp/"/>
                            <allowedTypes>
                                <string>public.folder</string>
                            </allowedTypes>
                        </pathCell>
                    </pathControl>
                    <textField verticalHuggingPriority="750" id="num">
                        <rect key="frame" x="20" y="160" width="100" height="21"/>
                        <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" sendsActionOnEndEditing="YES" borderStyle="bezel" drawsBackground="YES" id="numcell">
                            <numberFormatter key="formatter" formatterBehavior="custom10_4" numberStyle="decimal" usesGroupingSeparator="NO" groupingSize="0" minimumIntegerDigits="1" maximumIntegerDigits="42" maximumFractionDigits="2" id="nf">
                                <real key="minimum" value="1"/>
                                <real key="maximum" value="100"/>
                            </numberFormatter>
                            <font key="font" metaFont="system"/>
                        </textFieldCell>
                    </textField>
                    <textField verticalHuggingPriority="750" id="size">
                        <rect key="frame" x="130" y="160" width="100" height="21"/>
                        <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" sendsActionOnEndEditing="YES" borderStyle="bezel" drawsBackground="YES" id="sizecell">
                            <byteCountFormatter key="formatter" countStyle="binary" allowsNonnumericFormatting="NO" id="bcf"/>
                            <font key="font" metaFont="system"/>
                        </textFieldCell>
                    </textField>
                    <textField verticalHuggingPriority="750" id="date">
                        <rect key="frame" x="240" y="160" width="100" height="21"/>
                        <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" sendsActionOnEndEditing="YES" borderStyle="bezel" drawsBackground="YES" id="datecell">
                            <dateFormatter key="formatter" formatterBehavior="custom10_4" dateStyle="short" id="df"/>
                            <font key="font" metaFont="system"/>
                        </textFieldCell>
                    </textField>
                    <textField verticalHuggingPriority="750" id="cust">
                        <rect key="frame" x="350" y="160" width="100" height="21"/>
                        <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" sendsActionOnEndEditing="YES" borderStyle="bezel" drawsBackground="YES" id="custcell">
                            <customFormatter key="formatter" id="cf" customClass="ICDaysFormatter"/>
                            <font key="font" metaFont="system"/>
                        </textFieldCell>
                    </textField>
                    <ruleEditor nestingMode="compound" canRemoveAllRows="YES" rowHeight="29" id="rule">
                        <rect key="frame" x="20" y="60" width="300" height="80"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                    </ruleEditor>
                    <control verticalHuggingPriority="750" id="rec" customClass="ICRecorder">
                        <rect key="frame" x="340" y="110" width="120" height="22"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <actionCell key="cell" controlSize="mini" alignment="left" id="reccell">
                            <font key="font" metaFont="system"/>
                        </actionCell>
                    </control>
                    <collectionView focusRingType="none" selectable="YES" id="coll">
                        <rect key="frame" x="470" y="20" width="150" height="120"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <color key="primaryBackgroundColor" name="windowBackgroundColor" catalog="System" colorSpace="catalog"/>
                        <connections>
                            <outlet property="itemPrototype" destination="itm" id="o31"/>
                        </connections>
                    </collectionView>
                    <qcView autostartsRendering="YES" translatesAutoresizingMaskIntoConstraints="NO" id="qc">
                        <rect key="frame" x="340" y="20" width="64" height="64"/>
                        <color key="eraseColor" red="1" green="1" blue="1" alpha="1" colorSpace="calibratedRGB"/>
                    </qcView>
                    <scrollView horizontalLineScroll="19" horizontalPageScroll="10" verticalLineScroll="19" verticalPageScroll="10" id="tsv">
                        <rect key="frame" x="20" y="10" width="300" height="45"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <clipView key="contentView" id="tclip">
                            <rect key="frame" x="1" y="1" width="298" height="43"/>
                            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                            <subviews>
                                <tableView verticalHuggingPriority="750" columnAutoresizingStyle="lastColumnOnly" columnSelection="YES" multipleSelection="NO" autosaveColumns="NO" id="tbl">
                                    <rect key="frame" x="0.0" y="0.0" width="298" height="43"/>
                                    <autoresizingMask key="autoresizingMask"/>
                                    <size key="intercellSpacing" width="3" height="2"/>
                                    <tableColumns>
                                        <tableColumn identifier="kind" width="140" minWidth="40" maxWidth="1000" id="col1">
                                            <tableHeaderCell key="headerCell" lineBreakMode="truncatingTail" borderStyle="border" title="Kind" id="hc1">
                                                <font key="font" metaFont="smallSystem"/>
                                            </tableHeaderCell>
                                            <comboBoxCell key="dataCell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" borderStyle="bezel" alignment="left" drawsBackground="YES" numberOfVisibleItems="5" id="dc1">
                                                <font key="font" metaFont="system"/>
                                                <objectValues>
                                                    <string>INT</string>
                                                    <string>TEXT</string>
                                                </objectValues>
                                            </comboBoxCell>
                                        </tableColumn>
                                        <tableColumn identifier="shown" width="40" minWidth="40" maxWidth="1000" id="col2">
                                            <tableHeaderCell key="headerCell" lineBreakMode="truncatingTail" borderStyle="border" title="Shown" id="hc2">
                                                <font key="font" metaFont="smallSystem"/>
                                            </tableHeaderCell>
                                            <imageCell key="dataCell" refusesFirstResponder="YES" alignment="left" imageScaling="proportionallyDown" id="dc2"/>
                                        </tableColumn>
                                    </tableColumns>
                                </tableView>
                            </subviews>
                        </clipView>
                    </scrollView>
                </subviews>
            </view>
        </window>
    </objects>
</document>
