<?xml version="1.0" encoding="UTF-8"?>
<!-- Ferry's own test document for ferry-ibtool (freemac 1.223, Ferry 0.47.0),
     written by hand in the format Interface Builder saves. -->
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="20000" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="20000"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="IBOwner">
            <connections>
                <outlet property="window" destination="win" id="o1"/>
                <outlet property="nameField" destination="name" id="o2"/>
                <outlet property="passwordField" destination="pw" id="o3"/>
                <outlet property="okButton" destination="ok" id="o4"/>
                <outlet property="sizePopUp" destination="pop" id="o5"/>
                <outlet property="table" destination="tbl" id="o6"/>
                <outlet property="stack" destination="stk" id="o7"/>
                <outlet property="drawing" destination="draw" id="o8"/>
                <outlet property="statusMenu" destination="smenu" id="o9"/>
                <outlet property="panel" destination="pnl" id="o10"/>
                <outlet property="helper" destination="hlp" id="o11"/>
                <outlet property="box" destination="bx" id="o12"/>
                <outlet property="stepper" destination="stp" id="o13"/>
                <outlet property="level" destination="lvl" id="o14"/>
                <outlet property="check" destination="chk" id="o15"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <customObject id="hlp" customClass="IBHelper">
            <userDefinedRuntimeAttributes>
                <userDefinedRuntimeAttribute type="string" keyPath="label" value="from the document"/>
                <userDefinedRuntimeAttribute type="number" keyPath="count">
                    <integer key="value" value="7"/>
                </userDefinedRuntimeAttribute>
                <userDefinedRuntimeAttribute type="boolean" keyPath="enabled" value="YES"/>
            </userDefinedRuntimeAttributes>
            <connections>
                <outlet property="owner" destination="-2" id="o20"/>
            </connections>
        </customObject>
        <userDefaultsController representsSharedInstance="YES" id="udc"/>
        <menu title="Status" id="smenu">
            <items>
                <menuItem title="Open" keyEquivalent="o" id="mi1">
                    <connections>
                        <action selector="openThing:" target="-2" id="a1"/>
                    </connections>
                </menuItem>
                <menuItem title="Save As…" tag="4" keyEquivalent="s" id="mi2">
                    <modifierMask key="keyEquivalentModifierMask" shift="YES" command="YES"/>
                    <connections>
                        <action selector="saveThing:" target="-1" id="a2"/>
                    </connections>
                </menuItem>
                <menuItem isSeparatorItem="YES" id="mi3"/>
                <menuItem title="More" id="mi4">
                    <menu key="submenu" title="More" id="sub">
                        <items>
                            <menuItem title="Hidden one" hidden="YES" id="mi5"/>
                            <menuItem title="Turned on" state="on" id="mi6">
                                <modifierMask key="keyEquivalentModifierMask"/>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
            </items>
        </menu>
        <window title="Settings" allowsToolTipsWhenApplicationIsInactive="NO" autorecalculatesKeyViewLoop="NO" releasedWhenClosed="NO" frameAutosaveName="IBToolWindow" animationBehavior="default" id="win" customClass="IBWindow">
            <windowStyleMask key="styleMask" titled="YES" closable="YES"/>
            <rect key="contentRect" x="200" y="300" width="480" height="360"/>
            <value key="minSize" type="size" width="300" height="200"/>
            <view key="contentView" id="content">
                <rect key="frame" x="0.0" y="0.0" width="480" height="360"/>
                <autoresizingMask key="autoresizingMask"/>
                <subviews>
                    <textField verticalHuggingPriority="750" toolTip="Your name" id="name">
                        <rect key="frame" x="20" y="318" width="200" height="22"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                        <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" sendsActionOnEndEditing="YES" borderStyle="bezel" alignment="center" placeholderString="Name" drawsBackground="YES" id="namecell">
                            <font key="font" metaFont="systemBold"/>
                            <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                            <color key="backgroundColor" red="1" green="0.5" blue="0.25" alpha="1" colorSpace="calibratedRGB"/>
                        </textFieldCell>
                        <connections>
                            <binding destination="udc" name="value" keyPath="values.IBToolName" id="b1">
                                <dictionary key="options">
                                    <bool key="NSContinuouslyUpdatesValue" value="YES"/>
                                    <string key="NSNullPlaceholder">nobody</string>
                                </dictionary>
                            </binding>
                        </connections>
                    </textField>
                    <secureTextField verticalHuggingPriority="750" id="pw">
                        <rect key="frame" x="240" y="318" width="200" height="22"/>
                        <secureTextFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" borderStyle="bezel" drawsBackground="YES" usesSingleLineMode="YES" id="pwcell">
                            <font key="font" metaFont="smallSystem"/>
                        </secureTextFieldCell>
                    </secureTextField>
                    <button verticalHuggingPriority="750" tag="12" id="ok">
                        <rect key="frame" x="380" y="13" width="86" height="32"/>
                        <buttonCell key="cell" type="push" title="OK" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="okcell">
                            <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                            <font key="font" metaFont="system"/>
                            <string key="keyEquivalent" base64-UTF8="YES">
DQ
</string>
                        </buttonCell>
                        <connections>
                            <action selector="confirm:" target="-2" id="a3"/>
                        </connections>
                    </button>
                    <button id="chk">
                        <rect key="frame" x="18" y="280" width="200" height="18"/>
                        <buttonCell key="cell" type="check" title="Show the thing" bezelStyle="regularSquare" imagePosition="left" state="on" inset="2" id="chkcell">
                            <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                            <font key="font" metaFont="system"/>
                        </buttonCell>
                        <connections>
                            <binding destination="udc" name="value" keyPath="values.IBToolShowsThing" id="b2"/>
                        </connections>
                    </button>
                    <popUpButton verticalHuggingPriority="750" id="pop">
                        <rect key="frame" x="238" y="274" width="120" height="25"/>
                        <popUpButtonCell key="cell" type="push" title="Medium" bezelStyle="rounded" alignment="left" lineBreakMode="truncatingTail" state="on" borderStyle="borderAndBezel" imageScaling="proportionallyDown" inset="2" selectedItem="pm2" id="popcell">
                            <behavior key="behavior" lightByBackground="YES" lightByGray="YES"/>
                            <font key="font" metaFont="menu"/>
                            <menu key="menu" id="popmenu">
                                <items>
                                    <menuItem title="Small" tag="1" id="pm1"/>
                                    <menuItem title="Medium" state="on" tag="2" id="pm2"/>
                                    <menuItem title="Large" tag="3" id="pm3"/>
                                </items>
                            </menu>
                        </popUpButtonCell>
                    </popUpButton>
                    <box title="Details" id="bx">
                        <rect key="frame" x="17" y="200" width="446" height="64"/>
                        <view key="contentView" id="bxcontent">
                            <rect key="frame" x="3" y="3" width="440" height="46"/>
                            <subviews>
                                <stepper horizontalHuggingPriority="750" verticalHuggingPriority="750" id="stp">
                                    <rect key="frame" x="10" y="10" width="19" height="28"/>
                                    <stepperCell key="cell" continuous="YES" alignment="left" increment="5" maxValue="50" doubleValue="10" id="stpcell"/>
                                </stepper>
                                <levelIndicator verticalHuggingPriority="750" id="lvl">
                                    <rect key="frame" x="50" y="14" width="96" height="18"/>
                                    <levelIndicatorCell key="cell" alignment="left" maxValue="5" levelIndicatorStyle="rating" id="lvlcell"/>
                                </levelIndicator>
                            </subviews>
                        </view>
                    </box>
                    <scrollView autohidesScrollers="YES" horizontalLineScroll="19" horizontalPageScroll="10" verticalLineScroll="19" verticalPageScroll="10" usesPredominantAxisScrolling="NO" id="scr">
                        <rect key="frame" x="20" y="60" width="300" height="130"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <clipView key="contentView" id="clip">
                            <rect key="frame" x="1" y="1" width="298" height="128"/>
                            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                            <subviews>
                                <tableView verticalHuggingPriority="750" allowsExpansionToolTips="YES" columnAutoresizingStyle="lastColumnOnly" alternatingRowBackgroundColors="YES" multipleSelection="NO" autosaveColumns="NO" rowHeight="19" headerView="hdr" id="tbl">
                                    <rect key="frame" x="0.0" y="0.0" width="298" height="105"/>
                                    <autoresizingMask key="autoresizingMask"/>
                                    <size key="intercellSpacing" width="3" height="2"/>
                                    <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog"/>
                                    <color key="gridColor" name="gridColor" catalog="System" colorSpace="catalog"/>
                                    <tableColumns>
                                        <tableColumn identifier="name" width="150" minWidth="40" maxWidth="1000" id="col1">
                                            <tableHeaderCell key="headerCell" lineBreakMode="truncatingTail" borderStyle="border" title="Name">
                                                <font key="font" metaFont="smallSystem"/>
                                            </tableHeaderCell>
                                            <textFieldCell key="dataCell" lineBreakMode="truncatingTail" selectable="YES" editable="YES" title="Text Cell" id="col1cell">
                                                <font key="font" metaFont="system"/>
                                            </textFieldCell>
                                            <tableColumnResizingMask key="resizingMask" resizeWithTable="YES" userResizable="YES"/>
                                        </tableColumn>
                                        <tableColumn identifier="size" editable="NO" width="120" minWidth="40" maxWidth="1000" id="col2">
                                            <tableHeaderCell key="headerCell" lineBreakMode="truncatingTail" borderStyle="border" title="Size">
                                                <font key="font" metaFont="smallSystem"/>
                                            </tableHeaderCell>
                                            <textFieldCell key="dataCell" lineBreakMode="truncatingTail" selectable="YES" title="Text Cell" id="col2cell">
                                                <font key="font" metaFont="system"/>
                                            </textFieldCell>
                                            <tableColumnResizingMask key="resizingMask" userResizable="YES"/>
                                        </tableColumn>
                                    </tableColumns>
                                    <connections>
                                        <outlet property="dataSource" destination="-2" id="o30"/>
                                        <outlet property="delegate" destination="-2" id="o31"/>
                                    </connections>
                                </tableView>
                            </subviews>
                        </clipView>
                        <scroller key="horizontalScroller" hidden="YES" verticalHuggingPriority="750" horizontal="YES" id="hs">
                            <rect key="frame" x="1" y="113" width="298" height="16"/>
                        </scroller>
                        <scroller key="verticalScroller" hidden="YES" verticalHuggingPriority="750" horizontal="NO" id="vs">
                            <rect key="frame" x="224" y="17" width="15" height="102"/>
                        </scroller>
                        <tableHeaderView key="headerView" wantsLayer="YES" id="hdr">
                            <rect key="frame" x="0.0" y="0.0" width="298" height="23"/>
                            <autoresizingMask key="autoresizingMask"/>
                        </tableHeaderView>
                    </scrollView>
                    <stackView distribution="fill" orientation="vertical" alignment="leading" spacing="6" id="stk">
                        <rect key="frame" x="340" y="60" width="120" height="60"/>
                        <subviews>
                            <button id="sb1">
                                <rect key="frame" x="0" y="36" width="80" height="24"/>
                                <buttonCell key="cell" type="radio" title="First" bezelStyle="regularSquare" imagePosition="left" state="on" inset="2" id="sb1cell">
                                    <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                                    <font key="font" metaFont="system"/>
                                </buttonCell>
                            </button>
                            <button id="sb2">
                                <rect key="frame" x="0" y="6" width="80" height="24"/>
                                <buttonCell key="cell" type="radio" title="Second" bezelStyle="regularSquare" imagePosition="left" inset="2" id="sb2cell">
                                    <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                                    <font key="font" metaFont="system"/>
                                </buttonCell>
                            </button>
                        </subviews>
                    </stackView>
                    <customView id="draw" customClass="IBDrawingView">
                        <rect key="frame" x="340" y="130" width="60" height="60"/>
                        <autoresizingMask key="autoresizingMask" flexibleMinX="YES"/>
                        <userDefinedRuntimeAttributes>
                            <userDefinedRuntimeAttribute type="color" keyPath="fill">
                                <color key="value" white="0.5" alpha="1" colorSpace="calibratedWhite"/>
                            </userDefinedRuntimeAttribute>
                        </userDefinedRuntimeAttributes>
                    </customView>
                </subviews>
            </view>
            <point key="canvasLocation" x="100" y="100"/>
        </window>
        <window title="Hidden Panel" allowsToolTipsWhenApplicationIsInactive="NO" autorecalculatesKeyViewLoop="NO" visibleAtLaunch="NO" animationBehavior="default" id="pnl" customClass="NSPanel">
            <windowStyleMask key="styleMask" titled="YES" utility="YES"/>
            <rect key="contentRect" x="100" y="100" width="200" height="100"/>
            <view key="contentView" id="pnlcontent">
                <rect key="frame" x="0.0" y="0.0" width="200" height="100"/>
                <autoresizingMask key="autoresizingMask"/>
            </view>
        </window>
    </objects>
</document>
