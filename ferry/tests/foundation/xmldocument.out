== writing
<?xml version="1.0" encoding="UTF-8" standalone="yes"?><!-- a catalogue --><catalog xmlns="urn:books" xmlns:p="urn:prices" version="2"><book id="b1" p:currency="EUR"><title>Dune &amp; more</title><p:price>9.50</p:price></book><?render fast?><book id="b2"><title>Emma</title><note>A <b>fine</b> novel</note></book></catalog>
<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- a catalogue -->
<catalog xmlns="urn:books" xmlns:p="urn:prices" version="2">
    <book id="b1" p:currency="EUR">
        <title>Dune &amp; more</title>
        <p:price>9.50</p:price>
    </book>
    <?render fast?>
    <book id="b2">
        <title>Emma</title>
        <note>A <b>fine</b> novel</note>
    </book>
</catalog>
<book id='b1' p:currency='EUR'><title>Dune &amp; more</title><p:price>9.50</p:price></book>
