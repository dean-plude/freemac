hw.model: Macmini8,1
kern.hostname matches gethostname and uname: yes
hw.ncpu matches sysconf: yes
hw.activecpu matches sysconf: yes
hw.logicalcpu is hw.activecpu: yes, hw.logicalcpu_max is hw.ncpu: yes
hw.physicalcpu between 1 and hw.ncpu: yes
machdep.cpu.core_count is hw.physicalcpu: yes, thread_count is hw.ncpu: yes
hw.memsize matches sysconf: yes
hw.pagesize matches getpagesize: yes
hw.pagesize read into an int: yes
hw.cachelinesize is a power of two: yes
hw.byteorder: 1234
hw.cpu64bit_capable: 1, hw.optional.x86_64: 1, hw.optional.sse2: 1
sysctl.proc_translated: 0
machdep.cpu.brand_string matches cpuid: yes
machdep.cpu.vendor matches cpuid: yes
