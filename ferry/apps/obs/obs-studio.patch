diff --git a/plugins/mac-capture/audio-device-enum.c b/plugins/mac-capture/audio-device-enum.c
index 8c6ce31..a449502 100644
--- a/plugins/mac-capture/audio-device-enum.c
+++ b/plugins/mac-capture/audio-device-enum.c
@@ -12,7 +12,9 @@ static inline bool device_is_input(char *device)
 	return astrstri(device, "soundflower") == NULL && astrstri(device, "wavtap") == NULL &&
 	       astrstri(device, "soundsiphon") == NULL && astrstri(device, "ishowu") == NULL &&
