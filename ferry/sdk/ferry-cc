#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
#   ferry-cc [clang options] source.c -o program
#
# Builds a program for an Intel Mac with Ferry's own SDK (our headers and our
# description of libSystem), using clang and LLVM's lld. Used to make test
# programs on freemac; no Mac or Apple SDK is needed.
set -eu
here=$(dirname "$(readlink -f "$0")")
if [ -n "${FERRY_SDK:-}" ]; then sdk=$FERRY_SDK
elif [ -d "$here/include" ]; then sdk=$here
else sdk=/usr/share/ferry/sdk
fi
# Ferry's own Mac frameworks (Foundation and the ones after it), for -framework.
if [ -n "${FERRY_FRAMEWORKS:-}" ]; then fw=$FERRY_FRAMEWORKS
elif [ -d "$sdk/../frameworks" ]; then fw=$(cd "$sdk/../frameworks" && pwd)
else fw=/usr/lib/ferry/frameworks
fi
# clang only passes the Mach-O linker its platform and architecture when it
# knows the linker is lld, so point it at a directory holding "ld64.lld".
lddir=
for candidate in "$(command -v ld64.lld 2>/dev/null || true)" /usr/lib/llvm-*/bin/ld64.lld; do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then lddir=$(dirname "$candidate"); break; fi
done
if [ -z "$lddir" ]; then
    echo "ferry-cc: LLVM's Mach-O linker (ld64.lld, package lld) isn't installed" >&2
    exit 1
fi
# On a Mac, Foundation re-exports the Objective-C runtime; here programs that
# use a framework get libobjc directly instead.
objc=
for arg in "$@"; do
    if [ "$arg" = -framework ]; then objc=-lobjc; fi
done
# C++ and Objective-C++ sources get LLVM's libc++ headers (package
# libc++-dev, or libc++-18-dev and the like), ahead of the SDK's C headers,
# as a Mac's clang++ finds its libc++ headers. Programs link -lc++ as on a
# Mac; Ferry serves that library from this system's libc++ (src/cxx.c).
cxx=
for arg in "$@"; do
    case $arg in
        *.cpp|*.cc|*.cxx|*.c++|*.C|*.mm|c++|objective-c++) cxx=1 ;;
    esac
done
cxxinc=
if [ -n "$cxx" ]; then
    if [ -n "${FERRY_LIBCXX_INCLUDE:-}" ]; then cxxinc=$FERRY_LIBCXX_INCLUDE
    else
        ver=$(clang -dumpversion 2>/dev/null | cut -d. -f1)
        for candidate in "/usr/lib/llvm-$ver/include/c++/v1" /usr/include/c++/v1 /usr/lib/llvm-*/include/c++/v1; do
            if [ -f "$candidate/__config" ]; then cxxinc=$candidate; break; fi
        done
    fi
    if [ -z "$cxxinc" ]; then
        echo "ferry-cc: LLVM's libc++ headers (package libc++-dev) aren't installed, so C++ can't be built" >&2
        exit 1
    fi
fi
exec clang -target x86_64-apple-macos11 -nostdlibinc ${cxxinc:+-nostdinc++ -isystem "$cxxinc"} -isystem "$sdk/include" \
    -fno-stack-protector -Wno-unused-command-line-argument \
    -nostdlib -B"$lddir" -fuse-ld=lld -L"$sdk/lib" -F"$fw" -lSystem "$@" $objc
