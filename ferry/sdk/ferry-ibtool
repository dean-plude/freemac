    def prototype(self, cell_view):
        """A view-based table's cell view, as the nib of its own that the table
        keeps for -makeViewWithIdentifier:owner:. Its outlets to File's Owner
        go to that call's owner; a connection to anything else outside the
        cell view is left out."""
        sub = Compiler(self.root, self.warn)
        sub.unknown = self.unknown
        owner = sub.uid_for("-2")
        sub.a.fill(owner, sub.a.obj("NSCustomObject", (), NSClassName=sub.a.string("NSObject")))
        first = sub.uid_for("-1")
        sub.a.fill(first, sub.a.obj("NSCustomObject", (), NSClassName=sub.a.string("FirstResponder")))
        sub.pairs.append((first, owner))
        vuid = sub.uid_for(cell_view.get("id")) if cell_view.get("id") else sub.a.reserve()
        sub.view(cell_view, vuid, UID(0))
        sub.pairs.append((vuid, owner))
        return sub.finish(owner, quiet=True)

