    def b_gridView(self, e, uid):
        """A grid view (freemac 1.225): its rows, its columns and its cells,
        each cell naming its row, column and content view, and the cell it
        was merged into; the content views are its subviews."""
        a = self.a
        place = {"inherited": 0, "none": 1, "leading": 2, "top": 2, "trailing": 3, "bottom": 3, "center": 4,
                 "fill": 5}
        align = {"inherited": 0, "none": 1, "firstBaseline": 2, "lastBaseline": 3}

        def num(el, name):
            v = el.get(name)
            return float(v) if v is not None else None

        def part(tag, cls, keys):
            out = []
            box = child(e, tag)
            for el in (box if box is not None else []):
                if el.get("id") is None:
                    continue
                puid = self.uid_for(el.get("id"))
                a.fill(puid, a.obj(cls, (), **keys(el)))
                out.append(puid)
            return out

        rows = part("rows", "NSGridRow", lambda r: dict(
            NSGridRowYPlacement=place.get(r.get("yPlacement")), NSGridRowAlignment=align.get(r.get("rowAlignment")),
            NSGridRowHeight=num(r, "height"), NSGridRowTopPadding=num(r, "topPadding"),
            NSGridRowBottomPadding=num(r, "bottomPadding"), NSGridRowHidden=yes(r, "hidden") or None))
        columns = part("columns", "NSGridColumn", lambda c: dict(
            NSGridColumnXPlacement=place.get(c.get("xPlacement")), NSGridColumnWidth=num(c, "width"),
            NSGridColumnLeadingPadding=num(c, "leadingPadding"), NSGridColumnTrailingPadding=num(c, "trailingPadding"),
            NSGridColumnHidden=yes(c, "hidden") or None))
        subs, cells = [], []
        gc = child(e, "gridCells")
        for cell in (gc if gc is not None else []):
            if cell.get("id") is None:
                continue
            cuid = self.uid_for(cell.get("id"))
            vuid = None
            v = cell.find("*[@key='contentView']")
            if v is not None and v.get("id") is not None:
                vuid = self.uid_for(v.get("id"))
                self.view(v, vuid, uid)
                self.pairs.append((vuid, uid))
                subs.append(vuid)
            a.fill(cuid, a.obj("NSGridCell", (), NSGridCellContentView=vuid,
                               NSGridCellRow=self.uid_for(cell.get("row")) if cell.get("row") else None,
                               NSGridCellColumn=self.uid_for(cell.get("column")) if cell.get("column") else None,
                               NSGridCellHead=self.uid_for(cell.get("headOfMergedCell"))
                               if cell.get("headOfMergedCell") else None,
                               NSGridCellXPlacement=place.get(cell.get("xPlacement")),
                               NSGridCellYPlacement=place.get(cell.get("yPlacement")),
                               NSGridCellRowAlignment=align.get(cell.get("rowAlignment"))))
            self.connections_of(cell, cuid)
            cells.append(cuid)
        return "NSGridView", dict(NSSubviews=a.array(subs), NSGridViewRows=a.array(rows),
                                  NSGridViewColumns=a.array(columns), NSGridViewCells=a.array(cells),
                                  NSGridViewXPlacement=place.get(e.get("xPlacement")),
                                  NSGridViewYPlacement=place.get(e.get("yPlacement")),
                                  NSGridViewRowAlignment=align.get(e.get("rowAlignment")),
