    def b_textView(self, e, uid):
        """A text view: its text (a text storage, under its container's
        layout manager, as a nib keeps it), its sizes and how it grows, and
        what it lets its user do, in an NSTextViewSharedData (flags, whose
        bits are Ferry's own, the colours and the find style)."""
        a = self.a
        lm_keys = {}
        ts = child(e, "attributedString", "textStorage")
        if ts is not None:
            lm_keys["NSTextStorage"] = self.attributed_string(ts, "NSTextStorage")
        lm = a.add(a.obj("NSLayoutManager", (), **lm_keys))
        r = child(e, "rect", "frame")
        container = a.add(a.obj("NSTextContainer", (), NSLayoutManager=lm,
                                NSWidth=float(r.get("width", "0")) if r is not None else 0.0, NSTCFlags=1))
        flags = 0
        for bit, name, default in TEXT_VIEW_FLAGS:
            if yes(e, name, default):
                flags |= 1 << bit
        shared = dict(NSFlags=flags, NSBackgroundColor=self.color(child(e, "color", "backgroundColor")),
                      NSInsertionColor=self.color(child(e, "color", "insertionPointColor")),
                      NSTextColor=self.color(child(e, "color", "textColor")),
                      NSFindStyle={"panel": 1, "bar": 2}.get(e.get("findStyle"), 0))
        if child(e, "font", "font") is not None:
            shared["NSFont"] = self.font(child(e, "font", "font"))
        keys = dict(NSTextContainer=container, NSSharedData=a.add(a.obj("NSTextViewSharedData", (), **shared)),
                    NSTVFlags=(1 if yes(e, "horizontallyResizable") else 0) |
                    (2 if yes(e, "verticallyResizable") else 0))
        # "NSMinize" is the key's spelling in nibs
        for xkey, nkey in (("minSize", "NSMinize"), ("maxSize", "NSMaxSize"),
                           ("textContainerInset", "NSTextContainerInset")):
            v = child(e, "size", xkey)
            if v is not None:
                keys[nkey] = size_string(v)
        return "NSTextView", keys

    def b_webView(self, e, uid):
        """A WebView: its preferences (an identifier, or none for its own)
        with their font sizes and switches, and its frame and group names."""
        a = self.a
        keys = dict(UseBackForwardList=yes(e, "maintainsBackForwardList", True))
        for xkey, nkey in (("frameName", "FrameName"), ("groupName", "GroupName"),
                           ("applicationNameForUserAgent", "ApplicationName")):
            if e.get(xkey):
                keys[nkey] = a.string(e.get(xkey))
        p = child(e, "webPreferences", "preferences")
        if p is not None:
            pk = {}
            if text(p, "identifier", None):
                pk["Identifier"] = a.string(text(p, "identifier"))
            for k, v in p.attrib.items():
                if k in ("key", "id", "identifier"):
                    continue
                if v in ("YES", "NO"):
                    pk[k] = v == "YES"
                elif k.endswith("Size"):
                    pk[k] = int(float(v))
                else:
                    pk[k] = a.string(v)
            keys["WebPreferences"] = a.add(a.obj("WebPreferences", (), **pk))
        return "WebView", keys

