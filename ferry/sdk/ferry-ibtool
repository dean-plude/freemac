        if yes(e, "columnReordering", True):
            f |= 0x80000000
        if yes(e, "columnResizing", True):
            f |= 0x40000000
        if e.get("gridStyleMask") not in (None, "none"):
            f |= 0x20000000
        if yes(e, "emptySelection", True):
            f |= 0x10000000
        if yes(e, "multipleSelection", True):
            f |= 0x08000000
        if yes(e, "columnSelection"):
            f |= 0x04000000
        if yes(e, "autosaveColumns", True):
