    def b_scrollView(self, e, uid):
        a = self.a
        subs = []
        # the low two bits are the border: a xib writes borderType only when it isn't a bezel
        border = {"none": 0, "line": 1, "bezel": 2, "groove": 3}.get(e.get("borderType"), 2)
        keys = dict(NSsFlags=0x20030 | border,
                    NSAutohidesScrollers=yes(e, "autohidesScrollers"))
        cv = child(e, "clipView", "contentView")
        if cv is not None:
            cuid = self.uid_for(cv.get("id")) if cv.get("id") else a.reserve()
            self.view(cv, cuid, uid)
            self.pairs.append((cuid, uid))
            keys["NSContentView"] = cuid
            subs.append(cuid)
        hv = child(e, "tableHeaderView", "headerView")
        if hv is not None:
            hclip = a.reserve()
            huid = self.uid_for(hv.get("id")) if hv.get("id") else a.reserve()
            self.view(hv, huid, hclip)
            r = child(hv, "rect", "frame")
            a.fill(hclip, a.obj("NSClipView", supers("NSView"), NSFrame=rect_string(r), NSvFlags=0x100 | 2,
                                NSSuperview=uid, NSSubviews=a.array([huid]), NSDocView=huid,
                                NSDrawsBackground=False))
            self.pairs += [(hclip, uid), (huid, hclip)]
            keys["NSHeaderClipView"] = hclip
            subs.append(hclip)
        keys["NSSubviews"] = a.array(subs)
        return "NSScrollView", keys

