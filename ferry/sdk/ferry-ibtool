    def b_tableView(self, e, uid, cls="NSTableView"):
        a = self.a
        columns, prototypes = [], []
        tc = child(e, "tableColumns")
        for col in (tc if tc is not None else []):
            if col.tag != "tableColumn":
                continue
            cuid = self.uid_for(col.get("id")) if col.get("id") else a.reserve()
            keys = dict(NSIdentifier=a.string(col.get("identifier", "")), NSWidth=float(col.get("width", "100")),
                        NSMinWidth=float(col.get("minWidth", "10")), NSMaxWidth=float(col.get("maxWidth", "3.4e38")),
                        NSIsEditable=yes(col, "editable", True), NSIsHidden=yes(col, "hidden"), NSTableView=uid)
            hc = child(col, "tableHeaderCell", "headerCell")
            if hc is not None:
                keys["NSHeaderCell"] = self.text_cell(hc, "NSTableHeaderCell")
            dc = [c for c in col if c.get("key") == "dataCell"]
            if dc:
                keys["NSDataCell"] = self.any_cell(dc[0])
            rm = child(col, "tableColumnResizingMask", "resizingMask")
            if rm is not None:
                keys["NSResizingMask"] = (1 if yes(rm, "resizeWithTable") else 0) | (2 if yes(rm, "userResizable") else 0)
            sd = child(col, "sortDescriptor", "sortDescriptorPrototype")
            if sd is not None:
                keys["NSSortDescriptorPrototype"] = a.add(a.obj(
                    "NSSortDescriptor", (), NSKey=a.string(sd.get("key", "")),
                    NSAscending=yes(sd, "ascending", True), NSSelector=a.string(sd.get("selector", "compare:"))))
            a.fill(cuid, a.obj("NSTableColumn", (), **keys))
            self.pairs.append((cuid, uid))
            self.connections_of(col, cuid)
            pv = child(col, "prototypeCellViews")
            for cell_view in (pv if pv is not None else []):
                ident = cell_view.get("identifier") or col.get("identifier") or ""
                prototypes.append((ident, self.prototype(cell_view)))
            columns.append(cuid)
        f = 0
        if yes(e, "columnReordering", True):
            f |= 0x80000000
        if yes(e, "columnResizing", True):
            f |= 0x40000000
        if e.get("gridStyleMask") not in (None, "none"):
            f |= 0x20000000
        if yes(e, "emptySelection", True):
            f |= 0x10000000
        if yes(e, "multipleSelection", True):
            f |= 0x08000000
        if yes(e, "columnSelection"):
            f |= 0x04000000
        if yes(e, "autosaveColumns", True):
            f |= 0x01000000
        if yes(e, "alternatingRowBackgroundColors"):
            f |= 0x00800000
        spacing = child(e, "size", "intercellSpacing")
        keys = dict(NSTableColumns=a.array(columns), NSRowHeight=float(e.get("rowHeight", "17")),
                    NSIntercellSpacingWidth=float(spacing.get("width", "3")) if spacing is not None else 3.0,
                    NSIntercellSpacingHeight=float(spacing.get("height", "2")) if spacing is not None else 2.0,
                    NSTvFlags=f, NSEnabled=yes(e, "enabled", True), NSAllowsTypeSelect=yes(e, "typeSelect", True),
                    NSColumnAutoresizingStyle={"none": 0, "uniform": 1, "sequential": 2, "reverseSequential": 3,
                                               "lastColumnOnly": 4, "firstColumnOnly": 5}.get(
                                                   e.get("columnAutoresizingStyle"), 1),
                    NSBackgroundColor=self.color(child(e, "color", "backgroundColor")),
                    NSGridColor=self.color(child(e, "color", "gridColor")))
        if e.get("selectionHighlightStyle") in ("none", "regular", "sourceList"):
            keys["NSTableViewSelectionHighlightStyle"] = {"none": -1, "regular": 0, "sourceList": 1}[
                e.get("selectionHighlightStyle")]
        if e.get("headerView"):
            keys["NSHeaderView"] = self.uid_for(e.get("headerView"))
        if prototypes:
            nibs = [(k, a.add(a.obj("NSNib", (), NSNibFileData=data))) for k, data in prototypes]
            keys["NSTableViewArchivedReusableViewsKey"] = a.add(a.obj(
                "NSDictionary", (), **{"NS.keys": [a.string(k) for k, _ in nibs], "NS.objects": [v for _, v in nibs]}))
        if cls == "NSOutlineView":
            keys["NSOutlineViewIndentationPerLevelKey"] = float(e.get("indentationPerLevel", "16"))
            if e.get("outlineTableColumn"):
                keys["NSOutlineViewOutlineTableColumnKey"] = self.uid_for(e.get("outlineTableColumn"))
            elif columns:
                keys["NSOutlineViewOutlineTableColumnKey"] = columns[0]
        return cls, keys

