                    "NSSortDescriptor", (), NSKey=a.string(sd.get("key", "")),
                    NSAscending=yes(sd, "ascending", True), NSSelector=a.string(sd.get("selector", "compare:"))))
            a.fill(cuid, a.obj("NSTableColumn", (), **keys))
            self.pairs.append((cuid, uid))
