        """A view-based table's cell view, as the nib of its own that the table
        keeps for -makeViewWithIdentifier:owner:. Its outlets to File's Owner
        go to that call's owner; a connection to anything else outside the
        cell view is left out."""
        sub = Compiler(self.root, self.warn)
        sub.unknown = self.unknown
        owner = sub.uid_for("-2")
        sub.a.fill(owner, sub.a.obj("NSCustomObject", (), NSClassName=sub.a.string("NSObject")))
        first = sub.uid_for("-1")
        sub.a.fill(first, sub.a.obj("NSCustomObject", (), NSClassName=sub.a.string("FirstResponder")))
        sub.pairs.append((first, owner))
        vuid = sub.uid_for(cell_view.get("id")) if cell_view.get("id") else sub.a.reserve()
        sub.view(cell_view, vuid, UID(0))
        sub.pairs.append((vuid, owner))
        return sub.finish(owner, quiet=True)

    def b_tableCellView(self, e, uid):
        return "NSTableCellView", {}

    def b_splitView(self, e, uid):
        return "NSSplitView", dict(NSIsVertical=yes(e, "vertical"),
                                   NSDividerStyle={"thick": 1, "thin": 2, "paneSplitter": 3}.get(
                                       e.get("dividerStyle"), 1),
                                   NSAutosaveName=self.a.string(e.get("autosaveName"))
                                   if e.get("autosaveName") else None)

    def b_stackView(self, e, uid):
        a = self.a
        orientation = 1 if e.get("orientation") == "vertical" else 0
        align = {"leading": 5, "trailing": 6, "top": 3, "bottom": 4, "left": 1, "right": 2, "centerX": 9,
                 "centerY": 10, "firstBaseline": 12, "lastBaseline": 11}
        keys = dict(NSStackViewOrientation=orientation, NSStackViewSpacing=float(e.get("spacing", "8")),
                    NSStackViewDetachesHiddenViews=yes(e, "detachesHiddenViews"),
                    NSStackViewDistribution={"gravityAreas": -1, "fill": 0, "fillEqually": 1,
                                             "fillProportionally": 2, "equalSpacing": 3, "equalCentering": 4}.get(
                                                 e.get("distribution"), -1))
        if e.get("alignment") in align:
            keys["NSStackViewAlignment"] = align[e.get("alignment")]
        # the older form keeps its views in three gravity areas
        for tag, key in (("beginningViews", "NSStackViewBeginningContainer"),
                         ("middleViews", "NSStackViewMiddleContainer"), ("endViews", "NSStackViewEndContainer")):
            g = child(e, tag)
            if g is None:
                continue
            views = []
            for v in g:
                if v.get("id") is None:
                    continue
                vuid = self.uid_for(v.get("id"))
                if a.objects[vuid.data] is None:
                    self.view(v, vuid, uid)
                    self.pairs.append((vuid, uid))
                views.append(vuid)
            keys[key] = a.add(a.obj("NSStackViewContainer", (), NSStackViewContainerNonDroppedViews=a.array(views)))
        return "NSStackView", keys

    def b_comboBox(self, e, uid):
        a = self.a
        cls, keys = self.b_textField(e, uid, "NSComboBox", "comboBoxCell", "NSComboBoxCell")
        c = child(e, "comboBoxCell", "cell")
        if c is not None:
            vals = child(c, "objectValues", "objectValues")
            items = [a.string(s.text or s.get("value") or "") for s in (vals if vals is not None else [])
                     if s.tag == "string"]
            keys.update(NSPopUpListData=a.array(items), NSUsesDataSource=yes(c, "usesDataSource"),
                        NSCompletes=yes(c, "completes", True),
                        NSVisibleItemCount=int(c.get("numberOfVisibleItems", "5")),
                        NSHasVerticalScroller=yes(c, "hasVerticalScroller", True))
        return cls, keys

    def b_gridView(self, e, uid):
        """A grid view keeps its cells' views in rows and columns; here they
        become its subviews where the document placed them."""
        subs = []
        gc = child(e, "gridCells")
        for cell in (gc if gc is not None else []):
            v = cell.find("*[@key='contentView']")
            if v is None or v.get("id") is None:
                continue
            vuid = self.uid_for(v.get("id"))
            self.view(v, vuid, uid)
            self.pairs.append((vuid, uid))
            subs.append(vuid)
        self.note_unknown("gridView", "a plain view holding its cells' views where they were placed")
        return "NSView", dict(NSSubviews=self.a.array(subs))

    def b_tokenField(self, e, uid):
        cls, keys = self.b_textField(e, uid, "NSTokenField", "tokenFieldCell", "NSTokenFieldCell")
        return cls, keys

    def b_colorWell(self, e, uid):
        return "NSColorWell", dict(NSColor=self.color(child(e, "color", "color")),
                                   NSIsBordered=yes(e, "bordered", True), NSEnabled=yes(e, "enabled", True))


