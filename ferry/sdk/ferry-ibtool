"""ferry-ibtool: compiles an Interface Builder document (.xib, the XML that
Xcode saves) into a nib that Ferry's AppKit loads (freemac 1.223, Ferry
0.47.0). Ferry's own tool, written for freemac; it is not Apple's ibtool
and uses none of Apple's code.

    ferry-ibtool --compile Out.nib In.xib

The nib is a keyed archive laid out as compiled Mac nibs are described
publicly (docs/ferry-gui.md, "What a nib is"): an NSIBObjectData under
"IB.objectdata" holding File's Owner, every object and its parent, the
windows to show at launch and the connections. The xib's elements become
the classes Ferry's AppKit decodes: windows and panels (as window
templates), views and custom views, text fields, secure fields, buttons,
check boxes and radio buttons, pop-up buttons, image views, boxes,
steppers, sliders, progress indicators, segmented controls, search fields,
tab views, menus and their items, user-defaults, object and array
controllers, and the app's own objects; since freemac 1.229 (Ferry
0.53.0) also text views (with their attributed text, flags and colours),
web views and their preferences, matrices of cells, level indicators,
date pickers, path controls, collection views and their items, rule
editors (and, since freemac 1.232, predicate editors with their row
templates), plain controls, Quartz Composer views, the formatters of cells
(number, date, byte-count, date-components and the app's own), the data
cells of table columns, cells and formatters at the top level, and a
window's initial position. Outlets, actions, bindings and
user-defined runtime attributes are connected. A view element this tool
doesn't know becomes a custom view of its Cocoa class (a "tableView" an
NSTableView, made empty with -initWithFrame:), with its frame, so the
window keeps its layout and outlets to it still connect; each such element
is named once on standard error. Auto Layout constraints (with each
view's hugging and compression resistance) and window toolbars (their
items, the allowed and default lists, the delegate and the items' actions)
are carried over; accessibility descriptions and the document's
localization comments are left out. Both document formats are read: the
newer <document type="com.apple.InterfaceBuilder3.Cocoa.XIB"> as above,
and the older <archive type="com.apple.InterfaceBuilder3.Cocoa.XIB">,
whose objects are already written out with their keys and are carried
over as they are (see compile_archive_xib).
"""
import base64
import os
import plistlib
import sys
import xml.etree.ElementTree as ET
from plistlib import UID

# ---- the archive ----------------------------------------------------------------


class Archive:
    def __init__(self):
        self.objects = ["$null"]
        self.classes = {}
        self.strings = {}

    def add(self, obj):
        self.objects.append(obj)
        return UID(len(self.objects) - 1)

    def string(self, s):
        if s not in self.strings:
            self.strings[s] = self.add(s)
        return self.strings[s]

    def reserve(self):
        self.objects.append(None)
        return UID(len(self.objects) - 1)

    def fill(self, uid, obj):
        self.objects[uid.data] = obj

    def cls(self, name, supers):
        key = (name,) + tuple(supers)
        if key not in self.classes:
            chain = [name] + [s for s in supers if s != name]
            if chain[-1] != "NSObject":
                chain.append("NSObject")
            self.classes[key] = self.add({"$classname": name, "$classes": chain})
        return self.classes[key]

    def obj(self, cls, supers=(), **keys):
        d = {"$class": self.cls(cls, supers)}
        d.update({k: v for k, v in keys.items() if v is not None})
        return d

    def array(self, items):
        return self.add(self.obj("NSMutableArray", ("NSArray",), **{"NS.objects": list(items)}))

    def set(self, items):
        return self.add(self.obj("NSMutableSet", ("NSSet",), **{"NS.objects": list(items)}))

    def dictionary(self, pairs):
        return self.add(self.obj("NSMutableDictionary", ("NSDictionary",),
                                 **{"NS.keys": [self.string(k) for k, _ in pairs],
                                    "NS.objects": [v for _, v in pairs]}))

    def number(self, v):
        return self.add(v)

    def data(self, top):
        doc = {"$archiver": "NSKeyedArchiver", "$version": 100000, "$top": top, "$objects": self.objects}
        return plistlib.dumps(doc, fmt=plistlib.FMT_BINARY, sort_keys=True)


# NSLayoutAttribute by the names Interface Builder writes ("baseline" is the last baseline).
LAYOUT_ATTRIBUTES = {"left": 1, "right": 2, "top": 3, "bottom": 4, "leading": 5, "trailing": 6, "width": 7,
                     "height": 8, "centerX": 9, "centerY": 10, "baseline": 11, "lastBaseline": 11,
                     "firstBaseline": 12}

# Each class's superclasses, for the archive's class chains.
