#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""ferry-ibtool: compiles an Interface Builder document (.xib, the XML that
Xcode saves) into a nib that Ferry's AppKit loads (freemac 1.223, Ferry
0.47.0). Ferry's own tool, written for freemac; it is not Apple's ibtool
and uses none of Apple's code.

    ferry-ibtool --compile Out.nib In.xib

The nib is a keyed archive laid out as compiled Mac nibs are described
publicly (docs/ferry-gui.md, "What a nib is"): an NSIBObjectData under
"IB.objectdata" holding File's Owner, every object and its parent, the
windows to show at launch and the connections. The xib's elements become
the classes Ferry's AppKit decodes: windows and panels (as window
templates), views and custom views, text fields, secure fields, buttons,
check boxes and radio buttons, pop-up buttons, image views, boxes,
steppers, sliders, progress indicators, segmented controls, search fields,
tab views, menus and their items, user-defaults, object and array
controllers, and the app's own objects. Outlets, actions, bindings and
user-defined runtime attributes are connected. A view element this tool
doesn't know becomes a custom view of its Cocoa class (a "tableView" an
NSTableView, made empty with -initWithFrame:), with its frame, so the
window keeps its layout and outlets to it still connect; each such element
is named once on standard error. Auto Layout constraints, toolbars,
accessibility descriptions and the document's localization comments are
left out. Only the newer document format (<document type=
"com.apple.InterfaceBuilder3.Cocoa.XIB">) is read; the older <archive>
format is refused with a message.
"""
import base64
import os
import plistlib
import sys
import xml.etree.ElementTree as ET
from plistlib import UID

# ---- the archive ----------------------------------------------------------------


class Archive:
    def __init__(self):
        self.objects = ["$null"]
        self.classes = {}
        self.strings = {}

    def add(self, obj):
        self.objects.append(obj)
        return UID(len(self.objects) - 1)

    def string(self, s):
        if s not in self.strings:
            self.strings[s] = self.add(s)
        return self.strings[s]

    def reserve(self):
        self.objects.append(None)
        return UID(len(self.objects) - 1)

    def fill(self, uid, obj):
        self.objects[uid.data] = obj

    def cls(self, name, supers):
        key = (name,) + tuple(supers)
        if key not in self.classes:
            chain = [name] + [s for s in supers if s != name]
            if chain[-1] != "NSObject":
                chain.append("NSObject")
            self.classes[key] = self.add({"$classname": name, "$classes": chain})
        return self.classes[key]

    def obj(self, cls, supers=(), **keys):
        d = {"$class": self.cls(cls, supers)}
        d.update({k: v for k, v in keys.items() if v is not None})
        return d

    def array(self, items):
        return self.add(self.obj("NSMutableArray", ("NSArray",), **{"NS.objects": list(items)}))

    def set(self, items):
        return self.add(self.obj("NSMutableSet", ("NSSet",), **{"NS.objects": list(items)}))

    def dictionary(self, pairs):
        return self.add(self.obj("NSMutableDictionary", ("NSDictionary",),
                                 **{"NS.keys": [self.string(k) for k, _ in pairs],
                                    "NS.objects": [v for _, v in pairs]}))

    def number(self, v):
        return self.add(v)

    def data(self, top):
        doc = {"$archiver": "NSKeyedArchiver", "$version": 100000, "$top": top, "$objects": self.objects}
        return plistlib.dumps(doc, fmt=plistlib.FMT_BINARY, sort_keys=True)


# Each class's superclasses, for the archive's class chains.
RESPONDER = ("NSResponder",)
VIEW = ("NSView",) + RESPONDER
CONTROL = ("NSControl",) + VIEW
CELL = ("NSCell",)
ACTION_CELL = ("NSActionCell",) + CELL
SUPERS = {
    "NSView": RESPONDER, "NSCustomView": VIEW, "NSControl": VIEW,
    "NSTextField": CONTROL, "NSSecureTextField": ("NSTextField",) + CONTROL,
    "NSSearchField": ("NSTextField",) + CONTROL, "NSComboBox": ("NSTextField",) + CONTROL,
    "NSTokenField": ("NSTextField",) + CONTROL,
    "NSButton": CONTROL, "NSPopUpButton": ("NSButton",) + CONTROL, "NSImageView": CONTROL,
    "NSBox": VIEW, "NSStepper": CONTROL, "NSSlider": CONTROL, "NSSegmentedControl": CONTROL,
    "NSProgressIndicator": VIEW, "NSTabView": VIEW, "NSColorWell": CONTROL, "NSLevelIndicator": CONTROL,
    "NSDatePicker": CONTROL, "NSPathControl": CONTROL,
    "NSTextFieldCell": ACTION_CELL, "NSSecureTextFieldCell": ("NSTextFieldCell",) + ACTION_CELL,
    "NSSearchFieldCell": ("NSTextFieldCell",) + ACTION_CELL,
    "NSButtonCell": ACTION_CELL, "NSPopUpButtonCell": ("NSMenuItemCell", "NSButtonCell") + ACTION_CELL,
    "NSImageCell": CELL, "NSStepperCell": ACTION_CELL, "NSSliderCell": ACTION_CELL,
    "NSSegmentedCell": ACTION_CELL, "NSComboBoxCell": ("NSTextFieldCell",) + ACTION_CELL,
    "NSTableHeaderCell": ("NSTextFieldCell",) + ACTION_CELL,
    "NSTableView": CONTROL, "NSTokenFieldCell": ("NSTextFieldCell",) + ACTION_CELL,
    "NSTokenField": ("NSTextField",) + CONTROL, "NSOutlineView": ("NSTableView",) + CONTROL,
    "NSWindowTemplate": (), "NSMenu": (), "NSMenuItem": (), "NSTabViewItem": (),
    "NSUserDefaultsController": ("NSController",),
    "NSObjectController": ("NSController",), "NSArrayController": ("NSObjectController", "NSController"),
    "NSTreeController": ("NSObjectController", "NSController"),
    "NSDictionaryController": ("NSArrayController", "NSObjectController", "NSController"),
}


def supers(cls):
    return SUPERS.get(cls, VIEW if cls.endswith("View") else ())


# ---- reading the xib's values ---------------------------------------------------

def yes(e, name, default=False):
    v = e.get(name)
    return default if v is None else v == "YES"


def child(e, tag, key=None):
    for c in e:
        if c.tag == tag and (key is None or c.get("key") == key):
            return c
    return None


def rect_string(r):
    if r is None:
        return "{{0, 0}, {0, 0}}"
    f = lambda k: fmt(float(r.get(k, "0")))
    return "{{%s, %s}, {%s, %s}}" % (f("x"), f("y"), f("width"), f("height"))


def size_string(e):
    f = lambda k: fmt(float(e.get(k, "0")))
    return "{%s, %s}" % (f("width"), f("height"))


def fmt(v):
    return ("%d" % v) if v == int(v) else repr(v)


def text(e, name, default=""):
    """A string the document keeps as an attribute or, when it holds
    characters an attribute can't (a Return as a key equivalent, say), as a
    <string key=...> element, perhaps in base 64."""
    v = e.get(name)
    if v is not None:
        return v
    for c in e:
        if c.tag == "string" and c.get("key") == name:
            t = c.text or ""
            if c.get("base64-UTF8") == "YES":
                t = "".join(t.split())
                t = base64.b64decode(t + "=" * (-len(t) % 4)).decode("utf-8", "replace")
            return t
    return default


ALIGN = {"left": 0, "right": 1, "center": 2, "justified": 3, "natural": 4}
LINE_BREAK = {"wordWrapping": 0, "charWrapping": 1, "clipping": 2, "truncatingHead": 3, "truncatingTail": 4,
              "truncatingMiddle": 5}
CONTROL_SIZE = {"regular": 0, "small": 1, "mini": 2, "large": 0}
BEZEL = {"rounded": 1, "regularSquare": 2, "thick": 3, "thicker": 4, "disclosure": 5, "shadowlessSquare": 6,
         "circular": 7, "texturedSquare": 8, "helpButton": 9, "smallSquare": 10, "texturedRounded": 11,
         "roundRect": 12, "recessed": 13, "roundedDisclosure": 14, "inline": 15}
META_FONTS = {"system": (".AppleSystemUIFont", 13), "systemBold": (".AppleSystemUIFont-Bold", 13),
              "smallSystem": (".AppleSystemUIFont", 11), "smallSystemBold": (".AppleSystemUIFont-Bold", 11),
              "miniSystem": (".AppleSystemUIFont", 9), "miniSystemBold": (".AppleSystemUIFont-Bold", 9),
              "label": (".AppleSystemUIFont", 10), "menu": (".AppleSystemUIFont", 14),
              "menuBar": (".AppleSystemUIFont", 14), "message": (".AppleSystemUIFont", 13),
              "toolTip": (".AppleSystemUIFont", 11), "titleBar": (".AppleSystemUIFont-Bold", 13),
              "palette": (".AppleSystemUIFont", 11), "controlContent": (".AppleSystemUIFont", 13),
              "user": ("Helvetica", 12), "userFixedPitch": ("Menlo-Regular", 11),
              "cellTitle": (".AppleSystemUIFont", 13)}
SYSTEM_MENUS = {"main": "_NSMainMenu", "apple": "_NSAppleMenu", "window": "_NSWindowsMenu",
                "services": "_NSServicesMenu", "recentDocuments": "_NSRecentDocumentsMenu",
                "font": "_NSFontMenu", "help": "_NSHelpMenu"}
CMD, SHIFT, OPTION, CONTROL_KEY = 1 << 20, 1 << 17, 1 << 19, 1 << 18


class Compiler:
    def __init__(self, root, warn):
        self.a = Archive()
        self.root = root
        self.warn = warn
        self.ids = {}          # xib id -> UID
        self.pairs = []        # (object, parent)
        self.connections = []
        self.visible = []
        self.names = []
        self.unknown = set()

    def finish(self, owner, quiet=False):
        """The archive's bytes, once every object is made. A connection to an
        object this tool didn't make (one inside a toolbar, say) is left out,
        and named."""
        a = self.a
        made = set(xid for xid, uid in self.ids.items() if a.objects[uid.data] is not None)
        conns = []
        for xid, label, uid in self.connections:
            if xid is None or xid in made:
                conns.append(uid)
            elif not quiet:
                self.warn("the connection %s to id %s is left out (that object isn't made)" % (label, xid))
        for xid, uid in self.ids.items():
            if a.objects[uid.data] is None:
                a.fill(uid, a.obj("NSCustomObject", (), NSClassName=a.string("NSObject")))
        for i, o in enumerate(a.objects):
            if o is None:
                a.objects[i] = "$null"
        pairs = [(owner, owner)] + self.pairs
        keys = [o for o, _ in pairs]
        data = a.add(a.obj("NSIBObjectData", (), NSRoot=owner,
                           NSObjectsKeys=a.array(keys), NSObjectsValues=a.array([p for _, p in pairs]),
                           NSOidsKeys=a.array(keys), NSOidsValues=a.array([a.add(i + 1) for i in range(len(keys))]),
                           NSNamesKeys=a.array([o for o, _ in self.names]),
                           NSNamesValues=a.array([a.string(n) for _, n in self.names]),
                           NSConnections=a.array(conns), NSVisibleWindows=a.set(self.visible),
                           NSNextOid=len(keys) + 1, NSFramework=a.string("IBCocoaFramework")))
        return a.data({"IB.objectdata": data, "IB.systemFontUpdateVersion": 1})

    # -- shared pieces -----------------------------------------------------------

    def uid_for(self, xid):
        if xid not in self.ids:
            self.ids[xid] = self.a.reserve()
        return self.ids[xid]

    def font(self, e):
        if e is None:
            return self.font_of(".AppleSystemUIFont", 13)
        name, size = META_FONTS.get(e.get("metaFont", ""), (e.get("name") or ".AppleSystemUIFont", 13))
        if e.get("size"):
            size = float(e.get("size"))
        return self.font_of(name, size)

    def font_of(self, name, size):
        return self.a.add(self.a.obj("NSFont", (), NSName=self.a.string(name), NSSize=float(size), NSfFlags=1044))

    def color(self, e):
        if e is None:
            return None
        a = self.a
        if e.get("catalog") or e.get("colorSpace") == "catalog":
            white = 0.0 if "Text" in (e.get("name") or "") else 1.0
            fallback = a.add(a.obj("NSColor", (), NSColorSpace=3, NSWhite=b"%g\x00" % white))
            return a.add(a.obj("NSColor", (), NSColorSpace=6, NSCatalogName=a.string(e.get("catalog", "System")),
                               NSColorName=a.string(e.get("name", "controlColor")), NSColor=fallback))
        if e.get("white") is not None:
            return a.add(a.obj("NSColor", (), NSColorSpace=3,
                               NSWhite=b"%g %g\x00" % (float(e.get("white")), float(e.get("alpha", "1")))))
        comps = [float(e.get(k, "0")) for k in ("red", "green", "blue")] + [float(e.get("alpha", "1"))]
        return a.add(a.obj("NSColor", (), NSColorSpace=1, NSRGB=b"%g %g %g %g\x00" % tuple(comps)))

    def image(self, name):
        if not name:
            return None
        if name in ("NSSwitch", "NSRadioButton"):
            return self.a.add(self.a.obj("NSButtonImageSource", (), NSImageName=self.a.string(name)))
        return self.a.add(self.a.obj("NSCustomResource", (), NSClassName=self.a.string("NSImage"),
                                     NSResourceName=self.a.string(name)))

    def frame_keys(self, e, superview):
        r = child(e, "rect", "frame")
        mask = 0
        m = child(e, "autoresizingMask", "autoresizingMask")
        if m is not None:
            for bit, name in ((1, "flexibleMinX"), (2, "widthSizable"), (4, "flexibleMaxX"),
                              (8, "flexibleMinY"), (16, "heightSizable"), (32, "flexibleMaxY")):
                if yes(m, name):
                    mask |= bit
        if yes(e, "autoresizesSubviews", True):
            mask |= 0x100
        if yes(e, "hidden"):
            mask |= 0x80000000
        keys = dict(NSFrame=rect_string(r), NSvFlags=mask, NSSuperview=superview)
        if yes(e, "hidden"):
            keys["NSHidden"] = True
        if e.get("toolTip"):
            keys["NSToolTip"] = self.a.string(e.get("toolTip"))
        if e.get("identifier"):
            keys["NSIdentifier"] = self.a.string(e.get("identifier"))
        return keys

    def cell_flags(self, cell, base=0x04000000, text_cell=False):
        f = base
        if yes(cell, "editable"):
            f |= 0x10000000
        if yes(cell, "selectable"):
            f |= 0x00200000
        if cell.get("borderStyle") == "bezel" or yes(cell, "bezeled"):
            f |= 0x00400000
        if cell.get("borderStyle") == "border" or yes(cell, "bordered"):
            f |= 0x00800000
        if yes(cell, "scrollable"):
            f |= 0x00100000
        if yes(cell, "continuous"):
            f |= 0x00080000
        # a text cell with no line break mode wraps: Interface Builder writes the mode only when it isn't
        # word wrapping, and a scrolling or single-line cell keeps to one line
        breaks = cell.get("lineBreakMode", "wordWrapping" if text_cell else None)
        if breaks in ("wordWrapping", "charWrapping") and not yes(cell, "scrollable") and \
                not yes(cell, "usesSingleLineMode"):
            f |= 0x40
        if not yes(cell, "enabled", True):
            f |= 0x20000000
        if cell.get("state") == "on":
            f |= 0x80000000
        return f

    def cell_flags2(self, cell, default_align):
        align = ALIGN.get(cell.get("alignment"), default_align)
        lb = LINE_BREAK.get(cell.get("lineBreakMode"), 0)
        size = CONTROL_SIZE.get(cell.get("controlSize"), 0)
        return (align << 26) | (lb << 9) | (size << 17) | (0x400000 if yes(cell, "sendsActionOnEndEditing") else 0)

    # -- connections ---------------------------------------------------------------

    def connections_of(self, e, source):
        con = child(e, "connections")
        if con is None:
            return
        a = self.a
        for c in con:
            if c.tag == "outlet":
                dst = c.get("destination")
                if dst is None or c.get("property") is None:
                    continue
                self.connections.append((dst, c.get("property"), a.add(a.obj(
                    "NSNibOutletConnector", ("NSNibConnector",), NSSource=source, NSDestination=self.uid_for(dst),
                    NSLabel=a.string(c.get("property"))))))
            elif c.tag == "action":
                target = c.get("target") or "-1"
                self.connections.append((target, c.get("selector"), a.add(a.obj(
                    "NSNibControlConnector", ("NSNibConnector",), NSSource=source, NSDestination=self.uid_for(target),
                    NSLabel=a.string(c.get("selector"))))))
            elif c.tag == "binding":
                opts = []
                d = child(c, "dictionary", "options")
                if d is not None:
                    for o in d:
                        v = self.plain_value(o)
                        if v is not None and o.get("key"):
                            opts.append((o.get("key"), v))
                keys = dict(NSSource=source, NSDestination=self.uid_for(c.get("destination")),
                            NSLabel=a.string("%s: %s" % (c.get("name"), c.get("keyPath"))),
                            NSBinding=a.string(c.get("name")), NSKeyPath=a.string(c.get("keyPath")),
                            NSNibBindingConnectorVersion=2)
                if opts:
                    keys["NSOptions"] = a.dictionary(opts)
                self.connections.append((c.get("destination"), c.get("name"),
                                         a.add(a.obj("NSNibBindingConnector", ("NSNibConnector",), **keys))))

    def plain_value(self, o):
        a = self.a
        if o.tag == "bool":
            return a.add(o.get("value") == "YES")
        if o.tag == "string":
            return a.string(o.text or o.get("value") or "")
        if o.tag in ("integer", "int"):
            return a.add(int(o.get("value", "0")))
        if o.tag in ("real", "double"):
            return a.add(float(o.get("value", "0")))
        if o.tag == "color":
            return self.color(o)
        if o.tag == "nil":
            return None
        return None

    def runtime_attributes(self, e, source):
        ra = child(e, "userDefinedRuntimeAttributes")
        if ra is None:
            return
        paths, values = [], []
        for r in ra:
            t, v = r.get("type"), r.get("value")
            val = None
            if t == "string" or t == "localizedString":
                val = self.a.string(v or "")
            elif t == "number":
                n = child(r, "real")
                if n is None:
                    n = child(r, "integer")
                if n is not None:
                    val = self.plain_value(n)
                elif v is not None:
                    val = self.a.add(float(v) if "." in v else int(v))
            elif t == "boolean":
                val = self.a.add(v == "YES")
            elif t == "color":
                val = self.color(child(r, "color"))
            if val is not None:
                paths.append(self.a.string(r.get("keyPath")))
                values.append(val)
        if paths:
            self.connections.append((None, None, self.a.add(self.a.obj(
                "NSIBUserDefinedRuntimeAttributesConnector", ("NSNibConnector",), NSObject=source,
                NSKeyPaths=self.a.array(paths), NSValues=self.a.array(values)))))

    # -- objects ---------------------------------------------------------------------

    def top_object(self, e, owner):
        tag = e.tag
        xid = e.get("id")
        if xid is None:
            return
        uid = self.uid_for(xid)
        a = self.a
        if tag in ("customObject", "placeholder"):
            cls = {"-1": "FirstResponder", "-3": "NSApplication"}.get(xid, e.get("customClass") or "NSObject")
            a.fill(uid, a.obj("NSCustomObject", (), NSClassName=a.string(cls)))
            label = {"-2": "File's Owner", "-1": "First Responder", "-3": "Application"}.get(xid)
            if label:
                self.names.append((uid, label))
        elif tag == "menu":
            self.menu(e, uid, None)
            if e.get("systemMenu") == "main":
                self.names.append((uid, "MainMenu"))
        elif tag == "menuItem":
            self.menu_item(e, uid, None)
        elif tag == "window" or tag == "panel":
            self.window(e, uid)
        elif tag == "userDefaultsController":
            a.fill(uid, a.obj("NSUserDefaultsController", supers("NSUserDefaultsController"),
                              NSSharedInstance=yes(e, "representsSharedInstance", True),
                              NSAppliesImmediately=yes(e, "appliesImmediately", True)))
        elif tag in ("objectController", "arrayController", "treeController", "dictionaryController"):
            cls = e.get("customClass") or "NS" + tag[0].upper() + tag[1:]
            base = "NS" + tag[0].upper() + tag[1:]
            keys = dict(NSEditable=yes(e, "editable", True),
                        NSAutomaticallyPreparesContent=yes(e, "automaticallyPreparesContent"))
            if e.get("objectClassName"):
                keys["NSObjectClassName"] = a.string(e.get("objectClassName"))
            dk = child(e, "declaredKeys")
            if dk is not None:
                keys["NSDeclaredKeys"] = a.array([a.string(s.text or "") for s in dk if s.tag == "string"])
            if tag == "arrayController":
                keys.update(NSAvoidsEmptySelection=yes(e, "avoidsEmptySelection", True),
                            NSPreservesSelection=yes(e, "preservesSelection", True),
                            NSSelectsInsertedObjects=yes(e, "selectsInsertedObjects", True),
                            NSClearsFilterPredicateOnInsertion=yes(e, "clearsFilterPredicateOnInsertion", True),
                            NSAutomaticallyRearrangesObjects=yes(e, "automaticallyRearrangesObjects"))
            chain = supers(base)
            a.fill(uid, a.obj(cls, ((base,) if cls != base else ()) + chain, **keys))
        elif tag in ("view", "customView") or tag in VIEW_TAGS or tag.endswith("View"):
            self.view(e, uid, UID(0))
        else:
            cls = e.get("customClass") or "NS" + tag[0].upper() + tag[1:]
            self.note_unknown(tag, "an object made with -init")
            a.fill(uid, a.obj("NSCustomObject", (), NSClassName=a.string(cls)))
        if xid != "-2":
            self.pairs.append((uid, owner))
        self.connections_of(e, uid)
        self.runtime_attributes(e, uid)

    def note_unknown(self, tag, what):
        if tag not in self.unknown:
            self.unknown.add(tag)
            self.warn("<%s> is made as %s" % (tag, what))

    def menu(self, e, uid, parent_item):
        a = self.a
        items = []
        its = child(e, "items")
        for it in (its if its is not None else []):
            if it.tag != "menuItem":
                continue
            iuid = self.uid_for(it.get("id")) if it.get("id") else a.reserve()
            self.menu_item(it, iuid, uid)
            items.append(iuid)
            self.pairs.append((iuid, uid))
        keys = dict(NSTitle=a.string(text(e, "title")), NSMenuItems=a.array(items))
        if e.get("systemMenu") in SYSTEM_MENUS:
            keys["NSName"] = a.string(SYSTEM_MENUS[e.get("systemMenu")])
        if yes(e, "autoenablesItems", True) is False:
            keys["NSNoAutoenable"] = True
        a.fill(uid, a.obj("NSMenu", (), **keys))

    def menu_item(self, it, uid, menu):
        a = self.a
        mask_e = child(it, "modifierMask", "keyEquivalentModifierMask")
        key = text(it, "keyEquivalent")
        if mask_e is None:
            mask = CMD if key else 0
        else:
            mask = ((CMD if yes(mask_e, "command", False) else 0) | (SHIFT if yes(mask_e, "shift") else 0) |
                    (OPTION if yes(mask_e, "option") else 0) | (CONTROL_KEY if yes(mask_e, "control") else 0))
        keys = dict(NSMenu=menu, NSTitle=a.string(text(it, "title")), NSKeyEquiv=a.string(key),
                    NSKeyEquivModMask=mask, NSMnemonicLoc=0x7fffffff)
        if it.get("tag"):
            keys["NSTag"] = int(it.get("tag"))
        if it.get("state"):
            keys["NSState"] = {"on": 1, "mixed": -1}.get(it.get("state"), 0)
        if yes(it, "isSeparatorItem"):
            keys.update(NSIsSeparator=True, NSIsDisabled=True)
        if not yes(it, "enabled", True):
            keys["NSIsDisabled"] = True
        if yes(it, "hidden"):
            keys["NSIsHidden"] = True
        if yes(it, "alternate"):
            keys["NSIsAlternate"] = True
        if it.get("indentationLevel"):
            keys["NSIndent"] = int(it.get("indentationLevel"))
        if it.get("image"):
            keys["NSImage"] = self.image(it.get("image"))
        sub = child(it, "menu", "submenu")
        if sub is not None:
            suid = self.uid_for(sub.get("id")) if sub.get("id") else a.reserve()
            self.menu(sub, suid, uid)
            self.pairs.append((suid, uid))
            keys.update(NSSubmenu=suid, NSAction=a.string("submenuAction:"))
            self.connections_of(sub, suid)
        a.fill(uid, a.obj("NSMenuItem", (), **keys))
