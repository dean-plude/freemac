                    NSTvFlags=f, NSEnabled=yes(e, "enabled", True), NSAllowsTypeSelect=yes(e, "typeSelect", True),
                    NSColumnAutoresizingStyle={"none": 0, "uniform": 1, "sequential": 2, "reverseSequential": 3,
