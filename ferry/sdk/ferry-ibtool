    def view(self, e, uid, superview):
        a = self.a
        tag = e.tag
        keys = self.frame_keys(e, superview)
        subs = self.subviews(e, uid)
        if subs:
            keys["NSSubviews"] = a.array(subs)
        custom = e.get("customClass")
        builder = VIEW_TAGS.get(tag)
        if tag in ("view", "customView"):
            if custom:
                keys["NSClassName"] = a.string(custom)
                a.fill(uid, a.obj("NSCustomView", supers("NSCustomView"), **keys))
            else:
                a.fill(uid, a.obj("NSView", supers("NSView"), **keys))
        elif builder is not None:
            cls, extra = builder(self, e, uid)
            keys.update(extra)
            if custom and custom != cls:
                keys.update(NSClassName=a.string(custom), NSOriginalClassName=a.string(cls))
                a.fill(uid, a.obj("NSClassSwapper", (), **keys))
            else:
                a.fill(uid, a.obj(cls, supers(cls), **keys))
        else:
            cls = custom or COCOA_NAMES.get(tag) or "NS" + tag[0].upper() + tag[1:]
            self.note_unknown(tag, "a plain %s, made with -initWithFrame:" % cls)
            keys["NSClassName"] = a.string(cls)
            a.fill(uid, a.obj("NSCustomView", supers("NSCustomView"), **keys))
        self.connections_of(e, uid)
        self.runtime_attributes(e, uid)

