CELL = ("NSCell",)
ACTION_CELL = ("NSActionCell",) + CELL
SUPERS = {
    "NSView": RESPONDER, "NSCustomView": VIEW, "NSControl": VIEW,
    "NSTextField": CONTROL, "NSSecureTextField": ("NSTextField",) + CONTROL,
    "NSSearchField": ("NSTextField",) + CONTROL, "NSComboBox": ("NSTextField",) + CONTROL,
    "NSTokenField": ("NSTextField",) + CONTROL,
    "NSButton": CONTROL, "NSPopUpButton": ("NSButton",) + CONTROL, "NSImageView": CONTROL,
    "NSBox": VIEW, "NSStepper": CONTROL, "NSSlider": CONTROL, "NSSegmentedControl": CONTROL,
    "NSProgressIndicator": VIEW, "NSTabView": VIEW, "NSColorWell": CONTROL, "NSLevelIndicator": CONTROL,
    "NSDatePicker": CONTROL, "NSPathControl": CONTROL,
    "NSTextFieldCell": ACTION_CELL, "NSSecureTextFieldCell": ("NSTextFieldCell",) + ACTION_CELL,
    "NSSearchFieldCell": ("NSTextFieldCell",) + ACTION_CELL,
    "NSButtonCell": ACTION_CELL, "NSPopUpButtonCell": ("NSMenuItemCell", "NSButtonCell") + ACTION_CELL,
    "NSImageCell": CELL, "NSStepperCell": ACTION_CELL, "NSSliderCell": ACTION_CELL,
    "NSSegmentedCell": ACTION_CELL, "NSComboBoxCell": ("NSTextFieldCell",) + ACTION_CELL,
    "NSTableHeaderCell": ("NSTextFieldCell",) + ACTION_CELL,
    "NSTableView": CONTROL, "NSTokenFieldCell": ("NSTextFieldCell",) + ACTION_CELL,
    "NSTokenField": ("NSTextField",) + CONTROL, "NSOutlineView": ("NSTableView",) + CONTROL,
    "NSWindowTemplate": (), "NSMenu": (), "NSMenuItem": (), "NSTabViewItem": (),
    "NSUserDefaultsController": ("NSController",),
    "NSObjectController": ("NSController",), "NSArrayController": ("NSObjectController", "NSController"),
    "NSTreeController": ("NSObjectController", "NSController"),
    "NSDictionaryController": ("NSArrayController", "NSObjectController", "NSController"),
    "NSTextView": ("NSText",) + VIEW, "WebView": VIEW, "QCView": VIEW, "NSCollectionView": VIEW,
    "NSMatrix": CONTROL, "NSRuleEditor": CONTROL, "NSPredicateEditor": ("NSRuleEditor",) + CONTROL,
    "NSActionCell": CELL, "NSPathCell": ACTION_CELL, "NSLevelIndicatorCell": ACTION_CELL,
    "NSDatePickerCell": ACTION_CELL, "NSCollectionViewItem": ("NSViewController",) + RESPONDER,
}


def supers(cls):
    return SUPERS.get(cls, VIEW if cls.endswith("View") else ())


# ---- reading the xib's values ---------------------------------------------------

def yes(e, name, default=False):
    v = e.get(name)
    return default if v is None else v == "YES"


def child(e, tag, key=None):
    for c in e:
        if c.tag == tag and (key is None or c.get("key") == key):
            return c
    return None


def rect_string(r):
    if r is None:
        return "{{0, 0}, {0, 0}}"
    f = lambda k: fmt(float(r.get(k, "0")))
    return "{{%s, %s}, {%s, %s}}" % (f("x"), f("y"), f("width"), f("height"))


def size_string(e):
    f = lambda k: fmt(float(e.get(k, "0")))
    return "{%s, %s}" % (f("width"), f("height"))


def fmt(v):
    return ("%d" % v) if v == int(v) else repr(v)


def text(e, name, default=""):
    """A string the document keeps as an attribute or, when it holds
    characters an attribute can't (a Return as a key equivalent, say), as a
    <string key=...> element, perhaps in base 64."""
    v = e.get(name)
    if v is not None:
        return v
    for c in e:
        if c.tag == "string" and c.get("key") == name:
            t = c.text or ""
            if c.get("base64-UTF8") == "YES":
                t = "".join(t.split())
                t = base64.b64decode(t + "=" * (-len(t) % 4)).decode("utf-8", "replace")
            return t
    return default


ALIGN = {"left": 0, "right": 1, "center": 2, "justified": 3, "natural": 4}
LINE_BREAK = {"wordWrapping": 0, "charWrapping": 1, "clipping": 2, "truncatingHead": 3, "truncatingTail": 4,
              "truncatingMiddle": 5}
CONTROL_SIZE = {"regular": 0, "small": 1, "mini": 2, "large": 0}
BEZEL = {"rounded": 1, "regularSquare": 2, "thick": 3, "thicker": 4, "disclosure": 5, "shadowlessSquare": 6,
         "circular": 7, "texturedSquare": 8, "helpButton": 9, "smallSquare": 10, "texturedRounded": 11,
         "roundRect": 12, "roundedRect": 12, "recessed": 13, "roundedDisclosure": 14, "inline": 15}
META_FONTS = {"system": (".AppleSystemUIFont", 13), "systemBold": (".AppleSystemUIFont-Bold", 13),
              "smallSystem": (".AppleSystemUIFont", 11), "smallSystemBold": (".AppleSystemUIFont-Bold", 11),
              "miniSystem": (".AppleSystemUIFont", 9), "miniSystemBold": (".AppleSystemUIFont-Bold", 9),
              "label": (".AppleSystemUIFont", 10), "menu": (".AppleSystemUIFont", 14),
              "menuBar": (".AppleSystemUIFont", 14), "message": (".AppleSystemUIFont", 13),
              "toolTip": (".AppleSystemUIFont", 11), "titleBar": (".AppleSystemUIFont-Bold", 13),
              "palette": (".AppleSystemUIFont", 11), "controlContent": (".AppleSystemUIFont", 13),
              "user": ("Helvetica", 12), "userFixedPitch": ("Menlo-Regular", 11),
              "cellTitle": (".AppleSystemUIFont", 13)}
SYSTEM_MENUS = {"main": "_NSMainMenu", "apple": "_NSAppleMenu", "window": "_NSWindowsMenu",
                "services": "_NSServicesMenu", "recentDocuments": "_NSRecentDocumentsMenu",
                "font": "_NSFontMenu", "help": "_NSHelpMenu"}
CMD, SHIFT, OPTION, CONTROL_KEY = 1 << 20, 1 << 17, 1 << 19, 1 << 18


def custom_cell(c, cls):
    """A cell's class and the classes it comes from, with the subclass the
    xib names first (VLC's own slider, stepper and segmented cells)."""
    custom = c.get("customClass")
    return (custom, (cls,) + supers(cls)) if custom else (cls, supers(cls))


class Compiler:
    def __init__(self, root, warn):
        self.a = Archive()
        self.root = root
        self.warn = warn
        self.ids = {}          # xib id -> UID
        self.pairs = []        # (object, parent)
        self.connections = []
        self.visible = []
        self.names = []
        self.unknown = set()

    def finish(self, owner, quiet=False):
        """The archive's bytes, once every object is made. A connection to an
        object this tool didn't make (one inside a toolbar, say) is left out,
        and named."""
        a = self.a
        made = set(xid for xid, uid in self.ids.items() if a.objects[uid.data] is not None)
        conns = []
        for xid, label, uid in self.connections:
            if xid is None or xid in made:
                conns.append(uid)
            elif not quiet:
                self.warn("the connection %s to id %s is left out (that object isn't made)" % (label, xid))
        for xid, uid in self.ids.items():
            if a.objects[uid.data] is None:
                a.fill(uid, a.obj("NSCustomObject", (), NSClassName=a.string("NSObject")))
        for i, o in enumerate(a.objects):
            if o is None:
                a.objects[i] = "$null"
        pairs = [(owner, owner)] + self.pairs
        keys = [o for o, _ in pairs]
        data = a.add(a.obj("NSIBObjectData", (), NSRoot=owner,
                           NSObjectsKeys=a.array(keys), NSObjectsValues=a.array([p for _, p in pairs]),
                           NSOidsKeys=a.array(keys), NSOidsValues=a.array([a.add(i + 1) for i in range(len(keys))]),
                           NSNamesKeys=a.array([o for o, _ in self.names]),
                           NSNamesValues=a.array([a.string(n) for _, n in self.names]),
                           NSConnections=a.array(conns), NSVisibleWindows=a.set(self.visible),
                           NSNextOid=len(keys) + 1, NSFramework=a.string("IBCocoaFramework")))
        return a.data({"IB.objectdata": data, "IB.systemFontUpdateVersion": 1})

    # -- shared pieces -----------------------------------------------------------

    def uid_for(self, xid):
        if xid not in self.ids:
            self.ids[xid] = self.a.reserve()
        return self.ids[xid]

    def font(self, e):
        if e is None:
            return self.font_of(".AppleSystemUIFont", 13)
        name, size = META_FONTS.get(e.get("metaFont", ""), (e.get("name") or ".AppleSystemUIFont", 13))
        if e.get("size"):
            size = float(e.get("size"))
        return self.font_of(name, size)

    def font_of(self, name, size):
        return self.a.add(self.a.obj("NSFont", (), NSName=self.a.string(name), NSSize=float(size), NSfFlags=1044))

    def color(self, e):
        if e is None:
            return None
        a = self.a
        if e.get("catalog") or e.get("colorSpace") == "catalog":
            white = 0.0 if "Text" in (e.get("name") or "") else 1.0
            fallback = a.add(a.obj("NSColor", (), NSColorSpace=3, NSWhite=b"%g\x00" % white))
            return a.add(a.obj("NSColor", (), NSColorSpace=6, NSCatalogName=a.string(e.get("catalog", "System")),
                               NSColorName=a.string(e.get("name", "controlColor")), NSColor=fallback))
        if e.get("white") is not None:
            return a.add(a.obj("NSColor", (), NSColorSpace=3,
                               NSWhite=b"%g %g\x00" % (float(e.get("white")), float(e.get("alpha", "1")))))
        comps = [float(e.get(k, "0")) for k in ("red", "green", "blue")] + [float(e.get("alpha", "1"))]
        return a.add(a.obj("NSColor", (), NSColorSpace=1, NSRGB=b"%g %g %g %g\x00" % tuple(comps)))

    def image(self, name):
        if not name:
            return None
        if name in ("NSSwitch", "NSRadioButton"):
            return self.a.add(self.a.obj("NSButtonImageSource", (), NSImageName=self.a.string(name)))
        return self.a.add(self.a.obj("NSCustomResource", (), NSClassName=self.a.string("NSImage"),
                                     NSResourceName=self.a.string(name)))

    def date(self, e):
        """A <date> element: an NSDate, by its seconds since 2001."""
        if e is None or e.get("timeIntervalSinceReferenceDate") is None:
            return None
        return self.a.add(self.a.obj("NSDate", (), **{"NS.time": float(e.get("timeIntervalSinceReferenceDate"))}))

    def url(self, e):
        if e is None or not e.get("string"):
            return None
        return self.a.add(self.a.obj("NSURL", (), **{"NS.relative": self.a.string(e.get("string"))}))

    def paragraph_style(self, e):
        keys = dict(NSAlignment=ALIGN.get(e.get("alignment"), 4))
        if e.get("lineBreakMode"):
            keys["NSLineBreakMode"] = LINE_BREAK.get(e.get("lineBreakMode"), 0)
        return self.a.add(self.a.obj("NSMutableParagraphStyle", ("NSParagraphStyle",), **keys))

    def attributed_string(self, e, cls="NSAttributedString"):
        """An <attributedString>: its fragments' text, and each fragment's
        attributes (font, colour, paragraph style) as a run, written as a
        keyed archive keeps an attributed string: one dictionary for the
        whole text, or the distinct dictionaries and (length, index) pairs."""
        a = self.a
        runs = []
        for f in e:
            if f.tag != "fragment":
                continue
            content = f.get("content")
            if content is None:
                for c in f:
                    if c.get("key") == "content":
                        content = c.text if c.tag in ("string", "mutableString") else (c.get("content") or "")
            content = content or ""
            attrs = []
            at = child(f, "attributes")
            for c in (at if at is not None else []):
                k = c.get("key")
                if not k:
                    continue
                if c.tag == "font":
                    attrs.append((k, self.font(c)))
                elif c.tag == "color":
                    attrs.append((k, self.color(c)))
                elif c.tag == "paragraphStyle":
                    attrs.append((k, self.paragraph_style(c)))
                elif c.tag in ("integer", "real", "bool", "string"):
                    v = self.plain_value(c)
                    if v is not None:
                        attrs.append((k, v))
            if content:
                runs.append((content, attrs))
        text = "".join(t for t, _ in runs)
        keys = {"NSString": a.string(text)}
        if runs:
            sigs, dicts, info = [], [], bytearray()
            for t, attrs in runs:
                sig = tuple((k, v.data if isinstance(v, UID) else v) for k, v in attrs)
                if sig not in sigs:
                    sigs.append(sig)
                    dicts.append(a.dictionary(attrs))
                for n in (len(t.encode("utf-16-le")) // 2, sigs.index(sig)):
                    while True:
                        b = n & 0x7f
                        n >>= 7
                        info.append(b | (0x80 if n else 0))
                        if not n:
                            break
            if len(dicts) == 1:
                keys["NSAttributes"] = dicts[0]
            else:
                keys["NSAttributes"] = a.array(dicts)
                keys["NSAttributeInfo"] = a.add(bytes(info))
        supers_ = {"NSAttributedString": (), "NSMutableAttributedString": ("NSAttributedString",),
                   "NSTextStorage": ("NSMutableAttributedString", "NSAttributedString")}[cls]
        return a.add(a.obj(cls, supers_, **keys))

    # NSNumberFormatter's styles and behaviours, by the names Interface Builder writes
    NUMBER_STYLES = {"none": 0, "decimal": 1, "currency": 2, "percent": 3, "scientific": 4, "spellOut": 5,
                     "ordinal": 6, "currencyISOCode": 8, "currencyPlural": 9, "currencyAccounting": 10}
    BEHAVIOURS = {"default10_4": 0, "default": 0, "10_0": 1000, "custom10_0": 1000, "custom10_4": 1040}
    DATE_STYLES = {"none": 0, "short": 1, "medium": 2, "long": 3, "full": 4}

    def formatter(self, f):
        """A cell's formatter (or a formatter on its own): its class, and its
        settings in "NS.attributes" under the names of its properties, which
        Ferry's Foundation sets one by one. A formatter of the app's own
        class is made as that class, with its settings if it has any."""
        a = self.a
        uid = self.uid_for(f.get("id")) if f.get("id") else a.reserve()
        tag, attrs = f.tag, []
        skip = ("id", "key", "customClass", "userLabel")

        def number(v):
            return a.add(float(v) if any(ch in v for ch in ".eE") or v in ("NaN", "inf", "-inf") else int(v))

        cls = {"numberFormatter": "NSNumberFormatter", "dateFormatter": "NSDateFormatter",
               "byteCountFormatter": "NSByteCountFormatter", "dateComponentsFormatter": "NSDateComponentsFormatter",
               "customFormatter": "NSFormatter", "lengthFormatter": "NSLengthFormatter",
               "massFormatter": "NSMassFormatter", "energyFormatter": "NSEnergyFormatter",
               "dateIntervalFormatter": "NSDateIntervalFormatter",
               "personNameComponentsFormatter": "NSPersonNameComponentsFormatter"}.get(tag, "NSFormatter")
        enums = {"formatterBehavior": self.BEHAVIOURS, "numberStyle": self.NUMBER_STYLES,
                 "dateStyle": self.DATE_STYLES, "timeStyle": self.DATE_STYLES,
                 "countStyle": {"file": 0, "memory": 1, "decimal": 2, "binary": 3},
                 "unitsStyle": {"positional": 0, "abbreviated": 1, "short": 2, "full": 3, "spellOut": 4, "brief": 5},
                 "roundingMode": {"ceiling": 0, "floor": 1, "down": 2, "up": 3, "halfEven": 4, "halfDown": 5,
                                  "halfUp": 6},
                 "paddingPosition": {"beforePrefix": 0, "afterPrefix": 1, "beforeSuffix": 2, "afterSuffix": 3}}
        for k, v in f.attrib.items():
            if k in skip:
                continue
            if k in enums:
                if v in enums[k]:
                    attrs.append((k, a.add(enums[k][v])))
            elif v in ("YES", "NO"):
                attrs.append((k, a.add(v == "YES")))
            elif k in ("minimumIntegerDigits", "maximumIntegerDigits", "minimumFractionDigits",
                       "maximumFractionDigits", "groupingSize", "secondaryGroupingSize", "formatWidth",
                       "minimumSignificantDigits", "maximumSignificantDigits", "maximumUnitCount"):
                attrs.append((k, a.add(int(v))))
            else:
                attrs.append((k, a.string(v)))
        for c in f:
            k = c.get("key")
            if not k:
                continue
            if c.tag in ("real", "integer", "decimal"):
                v = c.get("value", "0")
                if v != "NaN":
                    attrs.append((k, number(v)))
            elif c.tag == "string":
                attrs.append((k, a.string(c.text or c.get("value") or "")))
            elif c.tag == "attributedString":
                attrs.append((k, self.attributed_string(c)))
            elif c.tag == "zeroFormattingBehavior":
                bits = {"default": 1, "dropLeading": 2, "dropMiddle": 4, "dropTrailing": 8, "dropAll": 14,
                        "pad": 0x10000}
                attrs.append((k, a.add(sum(b for n, b in bits.items() if yes(c, n)))))
            elif c.tag == "calendarUnit":
                bits = {"era": 2, "year": 4, "month": 8, "day": 16, "hour": 32, "minute": 64, "second": 128,
                        "weekday": 512, "weekdayOrdinal": 1024, "quarter": 2048, "weekOfMonth": 4096,
                        "weekOfYear": 8192, "yearForWeekOfYear": 16384, "nanosecond": 32768}
                attrs.append((k, a.add(sum(b for n, b in bits.items() if yes(c, n)))))
        custom = f.get("customClass")
        keys = {"NS.attributes": a.dictionary(attrs)} if attrs else {}
        if custom and custom != cls:
            a.fill(uid, a.obj(custom, (cls, "NSFormatter") if cls != "NSFormatter" else ("NSFormatter",), **keys))
        else:
            a.fill(uid, a.obj(cls, ("NSFormatter",) if cls != "NSFormatter" else (), **keys))
        self.connections_of(f, uid)
        return uid

    def frame_keys(self, e, superview):
        r = child(e, "rect", "frame")
        mask = 0
        m = child(e, "autoresizingMask", "autoresizingMask")
        if m is not None:
            for bit, name in ((1, "flexibleMinX"), (2, "widthSizable"), (4, "flexibleMaxX"),
                              (8, "flexibleMinY"), (16, "heightSizable"), (32, "flexibleMaxY")):
                if yes(m, name):
                    mask |= bit
        if yes(e, "autoresizesSubviews", True):
            mask |= 0x100
        if yes(e, "hidden"):
            mask |= 0x80000000
        keys = dict(NSFrame=rect_string(r), NSvFlags=mask, NSSuperview=superview)
        if yes(e, "hidden"):
            keys["NSHidden"] = True
        if e.get("toolTip"):
            keys["NSToolTip"] = self.a.string(e.get("toolTip"))
        if e.get("identifier"):
            keys["NSIdentifier"] = self.a.string(e.get("identifier"))
        return keys

    def cell_flags(self, cell, base=0x04000000, text_cell=False):
        f = base
        if yes(cell, "editable"):
            f |= 0x10000000
        if yes(cell, "selectable"):
            f |= 0x00200000
        # a pop-up button's cell is written with borderStyle "borderAndBezel": both bits
        if cell.get("borderStyle") in ("bezel", "borderAndBezel") or yes(cell, "bezeled"):
            f |= 0x00400000
        if cell.get("borderStyle") in ("border", "borderAndBezel") or yes(cell, "bordered"):
            f |= 0x00800000
        if yes(cell, "scrollable"):
            f |= 0x00100000
        if yes(cell, "continuous"):
            f |= 0x00080000
        # a text cell with no line break mode wraps: Interface Builder writes the mode only when it isn't
        # word wrapping, and a scrolling or single-line cell keeps to one line
        breaks = cell.get("lineBreakMode", "wordWrapping" if text_cell else None)
        if breaks in ("wordWrapping", "charWrapping") and not yes(cell, "scrollable") and \
                not yes(cell, "usesSingleLineMode"):
            f |= 0x40
        if not yes(cell, "enabled", True):
            f |= 0x20000000
        if cell.get("state") == "on":
            f |= 0x80000000
        return f

    def cell_flags2(self, cell, default_align):
        align = ALIGN.get(cell.get("alignment"), default_align)
        lb = LINE_BREAK.get(cell.get("lineBreakMode"), 0)
        size = CONTROL_SIZE.get(cell.get("controlSize"), 0)
        return (align << 26) | (lb << 9) | (size << 17) | (0x400000 if yes(cell, "sendsActionOnEndEditing") else 0)

    # -- connections ---------------------------------------------------------------

    def connections_of(self, e, source):
        con = child(e, "connections")
        if con is None:
            return
        a = self.a
        for c in con:
            if c.tag == "outlet":
                dst = c.get("destination")
                if dst is None or c.get("property") is None:
                    continue
                self.connections.append((dst, c.get("property"), a.add(a.obj(
                    "NSNibOutletConnector", ("NSNibConnector",), NSSource=source, NSDestination=self.uid_for(dst),
                    NSLabel=a.string(c.get("property"))))))
            elif c.tag == "action":
                target = c.get("target") or "-1"
                self.connections.append((target, c.get("selector"), a.add(a.obj(
                    "NSNibControlConnector", ("NSNibConnector",), NSSource=source, NSDestination=self.uid_for(target),
                    NSLabel=a.string(c.get("selector"))))))
            elif c.tag == "binding":
                opts = []
                d = child(c, "dictionary", "options")
                if d is not None:
                    for o in d:
                        v = self.plain_value(o)
                        if v is not None and o.get("key"):
                            opts.append((o.get("key"), v))
                keys = dict(NSSource=source, NSDestination=self.uid_for(c.get("destination")),
                            NSLabel=a.string("%s: %s" % (c.get("name"), c.get("keyPath"))),
                            NSBinding=a.string(c.get("name")), NSKeyPath=a.string(c.get("keyPath")),
                            NSNibBindingConnectorVersion=2)
                if opts:
                    keys["NSOptions"] = a.dictionary(opts)
                self.connections.append((c.get("destination"), c.get("name"),
                                         a.add(a.obj("NSNibBindingConnector", ("NSNibConnector",), **keys))))

    def plain_value(self, o):
        a = self.a
        if o.tag == "bool":
            return a.add(o.get("value") == "YES")
        if o.tag == "string":
            return a.string(o.text or o.get("value") or "")
        if o.tag in ("integer", "int"):
            return a.add(int(o.get("value", "0")))
        if o.tag in ("real", "double"):
            return a.add(float(o.get("value", "0")))
        if o.tag == "color":
            return self.color(o)
        if o.tag == "nil":
            return None
        return None

    def runtime_attributes(self, e, source):
        ra = child(e, "userDefinedRuntimeAttributes")
        if ra is None:
            return
        paths, values = [], []
        for r in ra:
            t, v = r.get("type"), r.get("value")
            val = None
            if t == "string" or t == "localizedString":
                val = self.a.string(v or "")
            elif t == "number":
                n = child(r, "real")
                if n is None:
                    n = child(r, "integer")
                if n is not None:
                    val = self.plain_value(n)
                elif v is not None:
                    val = self.a.add(float(v) if "." in v else int(v))
            elif t == "boolean":
                val = self.a.add(v == "YES")
            elif t == "color":
                val = self.color(child(r, "color"))
            if val is not None:
                paths.append(self.a.string(r.get("keyPath")))
                values.append(val)
        if paths:
            self.connections.append((None, None, self.a.add(self.a.obj(
                "NSIBUserDefinedRuntimeAttributesConnector", ("NSNibConnector",), NSObject=source,
                NSKeyPaths=self.a.array(paths), NSValues=self.a.array(values)))))

    # -- objects ---------------------------------------------------------------------

    def top_object(self, e, owner):
        tag = e.tag
        xid = e.get("id")
        if xid is None:
            return
        uid = self.uid_for(xid)
        a = self.a
        if tag in ("customObject", "placeholder"):
            cls = {"-1": "FirstResponder", "-3": "NSApplication"}.get(xid, e.get("customClass") or "NSObject")
            a.fill(uid, a.obj("NSCustomObject", (), NSClassName=a.string(cls)))
            label = {"-2": "File's Owner", "-1": "First Responder", "-3": "Application"}.get(xid)
            if label:
                self.names.append((uid, label))
        elif tag == "menu":
            self.menu(e, uid, None)
            if e.get("systemMenu") == "main":
                self.names.append((uid, "MainMenu"))
        elif tag == "menuItem":
            self.menu_item(e, uid, None)
        elif tag == "window" or tag == "panel":
            self.window(e, uid)
        elif tag == "userDefaultsController":
            a.fill(uid, a.obj("NSUserDefaultsController", supers("NSUserDefaultsController"),
                              NSSharedInstance=yes(e, "representsSharedInstance", True),
                              NSAppliesImmediately=yes(e, "appliesImmediately", True)))
        elif tag in ("objectController", "arrayController", "treeController", "dictionaryController"):
            cls = e.get("customClass") or "NS" + tag[0].upper() + tag[1:]
            base = "NS" + tag[0].upper() + tag[1:]
            keys = dict(NSEditable=yes(e, "editable", True),
                        NSAutomaticallyPreparesContent=yes(e, "automaticallyPreparesContent"))
            if e.get("objectClassName"):
                keys["NSObjectClassName"] = a.string(e.get("objectClassName"))
            dk = child(e, "declaredKeys")
            if dk is not None:
                keys["NSDeclaredKeys"] = a.array([a.string(s.text or "") for s in dk if s.tag == "string"])
            if tag == "arrayController":
                keys.update(NSAvoidsEmptySelection=yes(e, "avoidsEmptySelection", True),
                            NSPreservesSelection=yes(e, "preservesSelection", True),
                            NSSelectsInsertedObjects=yes(e, "selectsInsertedObjects", True),
                            NSClearsFilterPredicateOnInsertion=yes(e, "clearsFilterPredicateOnInsertion", True),
                            NSAutomaticallyRearrangesObjects=yes(e, "automaticallyRearrangesObjects"))
            chain = supers(base)
            a.fill(uid, a.obj(cls, ((base,) if cls != base else ()) + chain, **keys))
        elif tag in ("view", "customView") or tag in VIEW_TAGS or tag.endswith("View"):
            self.view(e, uid, UID(0))
        elif tag.endswith("Cell") or tag.endswith("Formatter"):
            # a cell or a formatter on its own: made with its connections
            self.any_cell(e) if tag.endswith("Cell") else self.formatter(e)
            self.pairs.append((uid, owner))
            return
        elif tag in ("collectionViewItem", "viewController"):
            base = "NS" + tag[0].upper() + tag[1:]
            cls = e.get("customClass") or base
            keys = {}
            if e.get("nibName"):
                keys["NSNibName"] = a.string(e.get("nibName"))
            if e.get("title"):
                keys["NSTitle"] = a.string(e.get("title"))
            a.fill(uid, a.obj(cls, ((base,) if cls != base else ()) + supers(base), **keys))
        else:
            cls = e.get("customClass") or "NS" + tag[0].upper() + tag[1:]
            self.note_unknown(tag, "an object made with -init")
            a.fill(uid, a.obj("NSCustomObject", (), NSClassName=a.string(cls)))
        if xid != "-2":
            self.pairs.append((uid, owner))
        self.connections_of(e, uid)
        self.runtime_attributes(e, uid)

    def note_unknown(self, tag, what):
        if tag not in self.unknown:
            self.unknown.add(tag)
            self.warn("<%s> is made as %s" % (tag, what))

    def menu(self, e, uid, parent_item):
        a = self.a
        items = []
        its = child(e, "items")
        for it in (its if its is not None else []):
            if it.tag != "menuItem":
                continue
            iuid = self.uid_for(it.get("id")) if it.get("id") else a.reserve()
            self.menu_item(it, iuid, uid)
            items.append(iuid)
            self.pairs.append((iuid, uid))
        keys = dict(NSTitle=a.string(text(e, "title")), NSMenuItems=a.array(items))
        if e.get("systemMenu") in SYSTEM_MENUS:
            keys["NSName"] = a.string(SYSTEM_MENUS[e.get("systemMenu")])
        if yes(e, "autoenablesItems", True) is False:
            keys["NSNoAutoenable"] = True
        a.fill(uid, a.obj("NSMenu", (), **keys))

    def menu_item(self, it, uid, menu):
        a = self.a
        mask_e = child(it, "modifierMask", "keyEquivalentModifierMask")
        key = text(it, "keyEquivalent")
        if mask_e is None:
            mask = CMD if key else 0
        else:
            mask = ((CMD if yes(mask_e, "command", False) else 0) | (SHIFT if yes(mask_e, "shift") else 0) |
                    (OPTION if yes(mask_e, "option") else 0) | (CONTROL_KEY if yes(mask_e, "control") else 0))
        keys = dict(NSMenu=menu, NSTitle=a.string(text(it, "title")), NSKeyEquiv=a.string(key),
                    NSKeyEquivModMask=mask, NSMnemonicLoc=0x7fffffff)
        if it.get("tag"):
            keys["NSTag"] = int(it.get("tag"))
        if it.get("state"):
            keys["NSState"] = {"on": 1, "mixed": -1}.get(it.get("state"), 0)
        if yes(it, "isSeparatorItem"):
            keys.update(NSIsSeparator=True, NSIsDisabled=True)
        if not yes(it, "enabled", True):
            keys["NSIsDisabled"] = True
        if yes(it, "hidden"):
            keys["NSIsHidden"] = True
        if yes(it, "alternate"):
            keys["NSIsAlternate"] = True
        if it.get("indentationLevel"):
            keys["NSIndent"] = int(it.get("indentationLevel"))
        if it.get("image"):
            keys["NSImage"] = self.image(it.get("image"))
        sub = child(it, "menu", "submenu")
        if sub is not None:
            suid = self.uid_for(sub.get("id")) if sub.get("id") else a.reserve()
            self.menu(sub, suid, uid)
            self.pairs.append((suid, uid))
            keys.update(NSSubmenu=suid, NSAction=a.string("submenuAction:"))
            self.connections_of(sub, suid)
        a.fill(uid, a.obj("NSMenuItem", (), **keys))
        self.connections_of(it, uid)
        self.runtime_attributes(it, uid)

    def window(self, e, uid):
        a = self.a
        style = 15
        sm = child(e, "windowStyleMask", "styleMask")
        if sm is not None:
            style = 0
            for bit, name in ((1, "titled"), (2, "closable"), (4, "miniaturizable"), (8, "resizable"),
                              (16, "utility"), (128, "nonactivatingPanel"), (256, "texturedBackground"),
                              (1 << 13, "hud"), (1 << 14, "fullScreen"), (1 << 15, "fullSizeContentView"),
                              (1 << 12, "unifiedTitleAndToolbar"), (64, "docModal")):
                if yes(sm, name) or yes(sm, name.upper()):  # xibs write the HUD style as HUD
                    style |= bit
        content = child(e, "view", "contentView")
        cuid = None
        if content is not None:
            cuid = self.uid_for(content.get("id")) if content.get("id") else a.reserve()
            self.view(content, cuid, UID(0))
            self.pairs.append((cuid, uid))
        cls = e.get("customClass") or ("NSPanel" if e.tag == "panel" else "NSWindow")
        keys = dict(NSWindowStyleMask=style, NSWindowBacking=2,
                    NSWindowRect=rect_string(child(e, "rect", "contentRect")),
                    NSWindowTitle=a.string(text(e, "title", "Window")), NSWindowClass=a.string(cls),
                    NSWindowView=cuid, NSWTFlags=0x78000000)
        if child(e, "rect", "screenRect") is not None:
            keys["NSScreenRect"] = rect_string(child(e, "rect", "screenRect"))
            # the screen edges the window keeps its distance from (1.229), in a
            # key of Ferry's own: 1 left, 2 right, 4 top, 8 bottom; a window
            # with no position mask stays where the xib puts it
            pm = child(e, "windowPositionMask", "initialPositionMask")
            if pm is not None:
                mask = 0
                for bit, name in ((1, "leftStrut"), (2, "rightStrut"), (4, "topStrut"), (8, "bottomStrut")):
                    if yes(pm, name):
                        mask |= bit
                keys["FerryWindowPositionMask"] = mask
        for xkey, nkey in (("minSize", "NSMinSize"), ("maxSize", "NSMaxSize"),
                           ("contentMinSize", "NSWindowContentMinSize")):
            v = child(e, "value", xkey)
            if v is None:
                v = child(e, "size", xkey)
            if v is not None:
                keys[nkey] = size_string(v)
        if e.get("frameAutosaveName"):
            keys["NSFrameAutosaveName"] = a.string(e.get("frameAutosaveName"))
        tb = child(e, "toolbar", "toolbar")
        if tb is not None:
            tuid = self.uid_for(tb.get("id")) if tb.get("id") else a.reserve()
            self.toolbar(tb, tuid)
            self.pairs.append((tuid, uid))
            keys["NSToolbar"] = tuid
        a.fill(uid, a.obj("NSWindowTemplate", (), **keys))
        if yes(e, "visibleAtLaunch", True):
            self.visible.append(uid)

    def toolbar(self, e, uid):
        """A window's toolbar: its items as NSToolbarItems, the allowed and
        default lists as Interface Builder wrote them (a default item is a
        reference to an allowed one), and its delegate and the items' actions
        as connections."""
        a = self.a
        made = {}

        def item(it):
            xid = it.get("reference") or it.get("id")
            if xid in made:
                return made[xid]
            iuid = self.uid_for(xid) if xid else a.reserve()
            made[xid] = iuid
            if it.get("reference"):
                return iuid
            ident = it.get("identifier") or it.get("implicitItemIdentifier") or (xid or "")
            keys = dict(NSToolbarItemIdentifier=a.string(ident))
            for xkey, nkey in (("label", "NSToolbarItemLabel"), ("paletteLabel", "NSToolbarItemPaletteLabel"),
                               ("toolTip", "NSToolbarItemToolTip"), ("title", "NSToolbarItemTitle")):
                if it.get(xkey) is not None:
                    keys[nkey] = a.string(it.get(xkey))
            if it.get("image"):
                keys["NSToolbarItemImage"] = self.image(it.get("image"))
            if it.get("tag"):
                keys["NSToolbarItemTag"] = int(it.get("tag"))
            if it.get("visibilityPriority"):
                keys["NSToolbarItemVisibilityPriority"] = int(it.get("visibilityPriority"))
            for xkey, nkey in (("minSize", "NSToolbarItemMinSize"), ("maxSize", "NSToolbarItemMaxSize")):
                v = child(it, "size", xkey)
                if v is not None:
                    keys[nkey] = size_string(v)
            if it.get("autovalidates") is not None:
                keys["NSToolbarItemAutovalidates"] = yes(it, "autovalidates")
            if it.get("enabled") is not None:
                keys["NSToolbarItemEnabled"] = yes(it, "enabled")
            if it.get("bordered") is not None:
                keys["NSToolbarItemBordered"] = yes(it, "bordered")
            v = None
            for c in it:
                if c.get("key") == "view" and c.get("id"):
                    v = c
            if v is not None:
                vuid = self.uid_for(v.get("id"))
                self.view(v, vuid, UID(0))
                self.pairs.append((vuid, iuid))
                keys["NSToolbarItemView"] = vuid
            cls = it.get("customClass") or "NSToolbarItem"
            a.fill(iuid, a.obj(cls, () if cls == "NSToolbarItem" else ("NSToolbarItem",), **keys))
            self.pairs.append((iuid, uid))
            self.connections_of(it, iuid)
            self.runtime_attributes(it, iuid)
            return iuid

        def items(key):
            lst = child(e, key)
            if lst is None:
                return None
            return a.array([item(it) for it in lst if it.tag == "toolbarItem"])

        allowed = items("allowedToolbarItems")
        default = items("defaultToolbarItems")
        keys = dict(NSToolbarIdentifier=a.string(e.get("identifier") or e.get("implicitIdentifier") or ""),
                    NSToolbarDisplayMode={"iconAndLabel": 1, "iconOnly": 2, "labelOnly": 3}.get(
                        e.get("displayMode"), 0),
                    NSToolbarSizeMode={"regular": 1, "small": 2}.get(e.get("sizeMode"), 0),
                    NSToolbarPrefersToBeShown=yes(e, "visible", True),
                    NSToolbarShowsBaselineSeparator=yes(e, "showsBaselineSeparator", True),
                    NSToolbarAllowsUserCustomization=yes(e, "allowsUserCustomization", True),
                    NSToolbarAutosavesConfiguration=yes(e, "autosavesConfiguration"))
        if allowed is not None:
            keys["NSToolbarIBAllowedItems"] = allowed
        if default is not None:
            keys["NSToolbarIBDefaultItems"] = default
        if made:
            pairs = []
            for xid, iuid in made.items():
                o = a.objects[iuid.data]
                if isinstance(o, dict) and "NSToolbarItemIdentifier" in o:
                    pairs.append((a.objects[o["NSToolbarItemIdentifier"].data], iuid))
            keys["NSToolbarIBIdentifiedItems"] = a.dictionary(pairs)
        a.fill(uid, a.obj("NSToolbar", (), **keys))
        self.connections_of(e, uid)

    def subviews(self, e, uid):
        out = []
        sv = child(e, "subviews")
        for s in (sv if sv is not None else []):
            if s.get("id") is None:
                continue
            suid = self.uid_for(s.get("id"))
            self.view(s, suid, uid)
            self.pairs.append((suid, uid))
            out.append(suid)
        return out

    def view(self, e, uid, superview):
        a = self.a
        tag = e.tag
        keys = self.frame_keys(e, superview)
        subs = self.subviews(e, uid)
        if subs:
            keys["NSSubviews"] = a.array(subs)
        keys.update(self.layout_keys(e, uid))
        custom = e.get("customClass")
        builder = VIEW_TAGS.get(tag)
        if tag in ("view", "customView"):
            if custom:
                keys["NSClassName"] = a.string(custom)
                a.fill(uid, a.obj("NSCustomView", supers("NSCustomView"), **keys))
            else:
                a.fill(uid, a.obj("NSView", supers("NSView"), **keys))
        elif builder is not None:
            cls, extra = builder(self, e, uid)
            keys.update(extra)
            if custom and custom != cls:
                keys.update(NSClassName=a.string(custom), NSOriginalClassName=a.string(cls))
                a.fill(uid, a.obj("NSClassSwapper", (), **keys))
            else:
                a.fill(uid, a.obj(cls, supers(cls), **keys))
        else:
            cls = custom or COCOA_NAMES.get(tag) or "NS" + tag[0].upper() + tag[1:]
            self.note_unknown(tag, "a plain %s, made with -initWithFrame:" % cls)
            keys["NSClassName"] = a.string(cls)
            a.fill(uid, a.obj("NSCustomView", supers("NSCustomView"), **keys))
        self.connections_of(e, uid)
        self.runtime_attributes(e, uid)

    # -- Auto Layout -------------------------------------------------------------

    def layout_keys(self, e, uid):
        """A view's Auto Layout: whether its autoresizing mask is translated
        into constraints, its content hugging and compression resistance
        priorities ("{horizontal, vertical}") and the constraints it holds."""
        a = self.a
        keys = {}
        if e.get("translatesAutoresizingMaskIntoConstraints") == "NO":
            keys["NSDoNotTranslateAutoresizingMask"] = True
        for key, prefix, suffix, dflt in (("NSHuggingPriority", "", "HuggingPriority", 250),
                                          ("NSAntiCompressionPriority", "", "CompressionResistancePriority", 750)):
            h, v = e.get("horizontal" + suffix), e.get("vertical" + suffix)
            if h is not None or v is not None:
                keys[key] = a.string("{%s, %s}" % (fmt(float(h or dflt)), fmt(float(v or dflt))))
        cons = []
        cs = child(e, "constraints")
        for c in (cs if cs is not None else []):
            if c.tag != "constraint" or yes(c, "placeholder"):
                continue
            cons.append(self.constraint(c, uid))
        if cons:
            keys["NSViewConstraints"] = a.array(cons)
        return keys

    def constraint(self, c, holder):
        """One constraint, as Interface Builder writes it: an item left out
        is the view that holds the constraint (for the first item) or
        nothing (for the second, a constant size); a multiplier may be a
        ratio ("16:9")."""
        a = self.a
        uid = self.uid_for(c.get("id")) if c.get("id") else a.reserve()
        first = self.uid_for(c.get("firstItem")) if c.get("firstItem") else holder
        keys = dict(NSFirstItem=first, NSFirstAttribute=LAYOUT_ATTRIBUTES.get(c.get("firstAttribute"), 0),
                    NSRelation={"lessThanOrEqual": -1, "greaterThanOrEqual": 1}.get(c.get("relation"), 0),
                    NSShouldBeArchived=True)
        if c.get("secondAttribute") and c.get("secondAttribute") != "notAnAttribute":
            keys["NSSecondItem"] = self.uid_for(c.get("secondItem")) if c.get("secondItem") else holder
            keys["NSSecondAttribute"] = LAYOUT_ATTRIBUTES.get(c.get("secondAttribute"), 0)
        m = c.get("multiplier")
        if m:
            if ":" in m:
                x, y = m.split(":", 1)
                keys["NSMultiplier"] = float(x) / float(y) if float(y) else 1.0
            else:
                keys["NSMultiplier"] = float(m)
        constant = c.get("constant")
        if constant is not None:
            keys["NSConstant"] = float(constant)
        elif yes(c, "symbolic"):
            keys["NSConstant"] = 8.0
        if c.get("priority"):
            keys["NSPriority"] = int(round(float(c.get("priority"))))
        if c.get("identifier"):
            keys["NSLayoutIdentifier"] = a.string(c.get("identifier"))
        a.fill(uid, a.obj("NSLayoutConstraint", (), **keys))
        return uid

    # -- controls and their cells ----------------------------------------------

    def control_keys(self, e, cell):
        k = dict(NSCell=cell, NSEnabled=yes(e, "enabled", True))
        if e.get("tag"):
            k["NSTag"] = int(e.get("tag"))
        return k

    def cell_common(self, c, cell_uid):
        self.connections_of(c, cell_uid)
        self.runtime_attributes(c, cell_uid)

    def text_cell(self, c, cls, extra=None):
        a = self.a
        uid = self.uid_for(c.get("id")) if c.get("id") else a.reserve()
        keys = dict(NSContents=a.string(text(c, "title")), NSCellFlags=self.cell_flags(c, text_cell=True),
                    NSCellFlags2=self.cell_flags2(c, 4), NSSupport=self.font(child(c, "font", "font")),
                    NSDrawsBackground=yes(c, "drawsBackground"),
                    NSBackgroundColor=self.color(child(c, "color", "backgroundColor")),
                    NSTextColor=self.color(child(c, "color", "textColor")))
        if c.get("placeholderString"):
            keys["NSPlaceholderString"] = a.string(c.get("placeholderString"))
        if c.get("tag"):
            keys["NSTag"] = int(c.get("tag"))
        for f in c:
            if f.get("key") == "formatter" and f.tag.endswith("Formatter"):
                keys["NSFormatter"] = self.formatter(f)
        keys.update(extra or {})
        a.fill(uid, a.obj(c.get("customClass") or cls, (cls,) + supers(cls) if c.get("customClass") else supers(cls),
                          **keys))
        self.cell_common(c, uid)
        return uid

    def any_cell(self, c):
        """A cell of any kind, by its element (a table column's data cell, a
        control's cell, one of a matrix's cells, or a cell on its own)."""
        tag = c.tag
        if tag == "buttonCell":
            return self.button_cell(c)
        if tag == "popUpButtonCell":
            return self.button_cell(c, "NSPopUpButtonCell", self.popup_keys(c, None))
        if tag in CELL_BUILDERS:
            return CELL_BUILDERS[tag](self, c)
        cls = "NS" + tag[0].upper() + tag[1:]
        return self.text_cell(c, cls if tag in TEXT_CELLS else "NSActionCell")

    def button_cell_keys(self, c, kind):
        a = self.a
        btype = c.get("type", "push")
        beh = child(c, "behavior", "behavior")
        behaviour = set(k for k, v in (beh.attrib.items() if beh is not None else []) if v == "YES")
        if btype == "check":
            aux = 3
        elif btype == "radio":
            aux = 4
        elif btype in ("disclosureTriangle", "disclosure"):   # they open and close: on and off
            aux = 1
        elif "changeContents" in behaviour or "lightByContents" in behaviour:
            aux = 2 if "changeContents" in behaviour else 5
        elif "changeBackground" in behaviour or "changeGray" in behaviour:
            aux = 1 if "pushIn" in behaviour else 6
        elif "pushIn" in behaviour:
            aux = 7
        else:
            aux = 0
        bezel = BEZEL.get(c.get("bezelStyle"), 1 if btype == "push" else 2)
        bordered = c.get("borderStyle") in ("border", "borderAndBezel") or yes(c, "bordered")
        flags = (0x00800000 if bordered else 0) | (0x8000 if yes(c, "transparent") else 0) | 0x04000000
        mask = 0
        m = child(c, "modifierMask", "keyEquivalentModifierMask")
        if m is not None:
            mask = ((CMD if yes(m, "command", False) else 0) | (SHIFT if yes(m, "shift") else 0) |
                    (OPTION if yes(m, "option") else 0) | (CONTROL_KEY if yes(m, "control") else 0))
        flags2 = (bezel & 7) | (0x20 if bezel > 7 else 0) | (mask >> 16 << 8 if mask else 0)
        keys = dict(NSContents=a.string(text(c, "title")), NSAlternateContents=a.string(text(c, "alternateTitle")),
                    NSCellFlags=self.cell_flags(c), NSCellFlags2=self.cell_flags2(c, 2),
                    NSSupport=self.font(child(c, "font", "font")), NSButtonFlags=flags, NSButtonFlags2=flags2,
                    NSBezelStyle=bezel, NSAuxButtonType=aux, NSKeyEquivalent=a.string(text(c, "keyEquivalent")),
                    NSPeriodicDelay=400, NSPeriodicInterval=75, NSAlignment=ALIGN.get(c.get("alignment"), 2))
        if btype in ("check", "radio") and not c.get("image"):
            keys["NSNormalImage"] = self.image("NSSwitch" if btype == "check" else "NSRadioButton")
        elif c.get("image"):
            keys["NSNormalImage"] = self.image(c.get("image"))
        if c.get("alternateImage"):
